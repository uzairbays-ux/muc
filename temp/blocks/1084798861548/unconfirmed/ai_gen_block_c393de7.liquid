{% doc %}
  @prompt
    size chart popup - conditions based, Image options based on the title 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign matched_image = blank %}
{% assign matched_alt = blank %}
{% assign normalized_title = product.title | downcase %}
{% for i in (1..5) %}
  {% assign title_key = 'option_' | append: i | append: '_title_match' %}
  {% assign image_key = 'option_' | append: i | append: '_image' %}
  {% assign alt_key = 'option_' | append: i | append: '_alt' %}
  {% assign title_match = block.settings[title_key] | downcase | strip %}
  {% assign option_image = block.settings[image_key] %}
  {% if title_match != blank and normalized_title contains title_match and option_image != blank %}
    {% assign matched_image = option_image %}
    {% assign matched_alt = block.settings[alt_key] %}
    {% break %}
  {% endif %}
{% endfor %}

{% style %}
  .ai-title-image-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }
  .ai-title-image-{{ ai_gen_id }}__image,
  .ai-title-image-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.corner_radius }}px;
  }
  .ai-title-image-{{ ai_gen_id }}__placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: #f4f4f4;
    overflow: hidden;
    border-radius: {{ block.settings.corner_radius }}px;
  }
  .ai-title-image-{{ ai_gen_id }}__placeholder svg { height: 100%; object-fit: cover; }
  .ai-title-image-{{ ai_gen_id }}__empty {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    padding: 8px 10px;
    background: #ffffff;
    color: #333333;
    text-align: center;
    font-size: 13px;
  }
{% endstyle %}

<div class="ai-title-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if matched_image != blank %}
    <img class="ai-title-image-{{ ai_gen_id }}__image" src="{{ matched_image | image_url: width: 1600 }}" alt="{{ matched_alt | default: matched_image.alt | escape }}" loading="lazy" width="{{ matched_image.width }}" height="{{ matched_image.height }}">
  {% elsif block.settings.show_empty_state %}
    <div class="ai-title-image-{{ ai_gen_id }}__placeholder">
      {{ 'image' | placeholder_svg_tag }}
      <div class="ai-title-image-{{ ai_gen_id }}__empty">Add title keywords and an image in the block settings.</div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Title-based image",
  "settings": [
    { "type": "header", "content": "Image matching" },
    { "type": "paragraph", "content": "Enter a word or phrase from a product title. The first matching option with an image is shown." },
    { "type": "text", "id": "option_1_title_match", "label": "Match 1 title" },
    { "type": "image_picker", "id": "option_1_image", "label": "Match 1 image" },
    { "type": "text", "id": "option_1_alt", "label": "Match 1 image alt text" },
    { "type": "text", "id": "option_2_title_match", "label": "Match 2 title" },
    { "type": "image_picker", "id": "option_2_image", "label": "Match 2 image" },
    { "type": "text", "id": "option_2_alt", "label": "Match 2 image alt text" },
    { "type": "text", "id": "option_3_title_match", "label": "Match 3 title" },
    { "type": "image_picker", "id": "option_3_image", "label": "Match 3 image" },
    { "type": "text", "id": "option_3_alt", "label": "Match 3 image alt text" },
    { "type": "text", "id": "option_4_title_match", "label": "Match 4 title" },
    { "type": "image_picker", "id": "option_4_image", "label": "Match 4 image" },
    { "type": "text", "id": "option_4_alt", "label": "Match 4 image alt text" },
    { "type": "text", "id": "option_5_title_match", "label": "Match 5 title" },
    { "type": "image_picker", "id": "option_5_image", "label": "Match 5 image" },
    { "type": "text", "id": "option_5_alt", "label": "Match 5 image alt text" },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "show_empty_state", "label": "Show placeholder when nothing matches", "default": true },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Title-based image" }],
  "tag": null,
  "class": "title-based-image-block"
}
{% endschema %}