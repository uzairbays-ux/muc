{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block, featured product block, and the product card block.
  The product object is null or when placeholders are rendered.

  @param {object} product - The product object
  @param {object} children - The children of the product card
  @param {object} [block] - The block object
  @param {number} [product_card_gap] - The gap between the product card children (overrides block settings)
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% style %}
  {% if request.visual_preview_mode %}
    product-card[data-product-transition] {
      width: 100%;
      min-width: 250px;
    }
  {% endif %}
{% endstyle %}

{% liquid
  assign has_quick_add = false
  if settings.quick_add and product.available
    assign has_quick_add = true
  endif

  assign has_mobile_quick_add = false
  if has_quick_add and settings.mobile_quick_add
    assign has_mobile_quick_add = true
  endif

  assign product_card_id = 'product-card-link-' | append: block.id | append: '-' | append: product.id
  assign product_card_gap_value = product_card_gap | default: block_settings.product_card_gap
  assign product_view_context = product_view_context | default: 'collection'

  # Logic to determine which variant URL to use (matching swatch selection logic)
  assign variant_to_link = product.selected_or_first_available_variant

  if settings.transition_to_main_product
    assign featured_image = variant_to_link.featured_image
    if featured_image == blank
      assign featured_image = product.featured_media.preview_image
    endif

    if featured_image != blank
      assign featured_media_url = featured_image | image_url: width: 500
    endif
  endif

  assign onboarding = false
  if product.id == empty or product == blank
    assign onboarding = true
  endif
%}

<product-card
  class="product-card size-style"
  style="{% render 'size-style', settings: block_settings %}"
  data-product-id="{{ product.id }}"
  id="product-card-{{ block.id }}"
  {% if settings.transition_to_main_product %}
    data-product-transition="true"
    data-featured-media-url="{{ featured_media_url }}"
    on:click="/handleViewTransition"
  {% endif %}
  {{ block.shopify_attributes }}
  {% if onboarding %}
    data-placeholder="true"
  {% endif %}
>
  <a
    id="{{ product_card_id | md5 }}"
    {% unless onboarding %}
      href="{{ variant_to_link.url }}"
    {% endunless %}
    class="product-card__link"
    ref="productCardLink"
  >
    <span class="visually-hidden">
      {{ product.title }}
    </span>
  </a>
  <div
    class="
      product-card__content
      layout-panel-flex
      layout-panel-flex--column
      product-grid__card
      spacing-style
      border-style
      gap-style
      {% if block_settings.inherit_color_scheme == false %} color-{{ block_settings.color_scheme }}{% endif %}
    "
    style="
      {% render 'border-override', settings: block_settings %}
      {% render 'layout-panel-style', settings: block_settings %}
      {% render 'spacing-style', settings: block_settings %}
      {% render 'gap-style', value: product_card_gap_value, name: 'product-card-gap' %}
      --quick-add-display: {% if has_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-display: {% if has_mobile_quick_add %}flex{% else %}none{% endif %};
      --quick-add-mobile-opacity: {% if has_mobile_quick_add %}1{% else %}0{% endif %};
      {% if block_settings.padding-inline-start > 0 %}--zoom-out-padding-inline-start: min(var(--padding-xs), {{ block_settings.padding-inline-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-inline-end > 0 %}--zoom-out-padding-inline-end: min(var(--padding-xs), {{ block_settings.padding-inline-end | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-start > 0 %}--zoom-out-padding-block-start: min(var(--padding-xs), {{ block_settings.padding-block-start | times: 0.7}}px);{% endif %}
      {% if block_settings.padding-block-end > 0 %}--zoom-out-padding-block-end: min(var(--padding-xs), {{ block_settings.padding-block-end | times: 0.7}}px);{% endif %}
    "
  >
    {{ children }}
    {%- unless onboarding -%}
      {% render 'kj-save-pill', product: product %}
      {% render 'kj-card-actions', product: product %}
      {% render 'kj-card-badge', product: product %}
    {%- endunless -%}
  </div>
</product-card>

{% stylesheet %}
  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }

  /* Product card title — clamp to 2 lines with ellipsis. */
  product-card p[role="heading"] {
    display: -webkit-box;
    overflow: hidden;
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    margin-bottom: 0.125rem;
    color: #001325;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    text-overflow: ellipsis;
    word-break: break-all;
  }

  /* Product card brand/vendor — single line with ellipsis. Generalized to the
     brand text-block (in .block-mobile-order) so it matches on every card type,
     not just the collection's block id. Also strips any pill background. */
  product-card .block-mobile-order .text-block {
    background: transparent !important;
    padding: 0 !important;
    width: fit-content;
  }

  product-card .block-mobile-order .text-block p {
    color: rgba(0, 19, 37, 0.92);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1px;
    line-height: 16px;
    margin-bottom: 0.125rem;
    margin-top: 0.25rem;
    overflow: hidden;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Remove the border around product card images. */
  product-card .product-media,
  product-card .product-media-container,
  product-card [class*="product-card-gallery"] {
    border: none !important;
  }

  /* ===== KJ card design — applies to every product card (collection,
     home carousels, recommendations, search). Collection-only rules
     (grid dividers, sticky filters, page bg) stay in main-collection. ===== */

  /* Inset text content + white card, keep the image full-bleed.
     Scoped to .product-card .product-card__content so it beats the theme's
     spacing rule (which zeroes the inline padding). */
  .product-card .product-card__content {
    position: relative;
    padding-inline: 0.625rem;
    padding-bottom: 0.625rem;
    background: #ffffff;
  }
  .product-card .product-card__content > .card-gallery {
    margin-inline: -0.625rem;
    margin-bottom: 0.4rem;
  }
  /* Square, borderless image (match the collection cards). */
  .product-card .card-gallery {
    border: none !important;
    border-radius: 0 !important;
  }

  /* Pin the wishlist + CTA row to the bottom so buttons align across a row. */
  .product-card { display: flex; flex-direction: column; height: 100%; min-width: 0; }
  .product-card__content { flex: 1 1 auto; min-width: 0; }
  .product-card__content > .kj-card-actions { margin-top: auto; }

  /* Price row: cut-price -> sale-price -> green discount on one line. */
  .product-card .price__sale {
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    gap: 0.25rem;
    width: 100%;
    white-space: nowrap;
    line-height: 1.1;
    margin: 6px 0;
    min-width: 0;
  }
  .product-card .price__sale > *:nth-child(1) { order: 2; }
  .product-card .price__sale > *:nth-child(2) { order: 1; }
  .product-card .price__sale > *:nth-child(3) { order: 3; }
  .product-card .price-item--sale.price { font-size: 14px; font-weight: 400; }
  .product-card .price-item--regular.compare-at-price { font-size: 12px; }
  .product-card .sale-badge__pill {
    color: #068743;
    background: transparent;
    font-size: 12px;
    font-weight: 400;
    padding: 0;
  }
  .product-card .price__sale .sale-badge__pill--inline::before {
    content: "|";
    margin-right: 4px;
    color: rgba(0, 19, 37, 0.25);
    font-weight: 400;
  }

  /* Value pills. */
  .product-card .kj-shades { margin-block: 3px; }
  .product-card .kj-save { margin-top: 3px; margin-bottom: 8px; }
  .product-card .baadmay-para {
    width: fit-content;
    margin-top: 3px;
    padding: 0.25rem 0.5rem;
    border-radius: 40px;
    background-image: linear-gradient(to right, rgb(233, 227, 252), rgb(255, 255, 255));
  }
  .product-card .baadmay-para .baadmay-price p,
  .product-card .baadmay-para .baadmay-price span {
    font-size: 10px !important;
  }

  /* Sale badge top-right, small. */
  .product-card .card-gallery .product-badges {
    inset: 6px 6px auto auto;
    left: auto;
    right: 6px;
    top: 6px;
  }
  .product-card .card-gallery .product-badges__badge {
    font-size: 10px;
    border-radius: 4px;
    padding: 2px 6px;
  }

  /* Rating: tiny black stars + grey (n) count. */
  .product-card .rating-wrapper {
    --star-fill-color: #001325;
    --star-fill-color-rgb: 0 19 37;
    color: #001325;
    font-size: 11px;
  }
  .product-card .rating { --star-size: 9px !important; }
  .product-card .rating-count { color: #8a8a8a; font-size: 10px; margin-top: -7px; }
  .product-card .rating-count-number { color: #8a8a8a !important; font-size: 10px !important; }
  .product-card .rating-count-label { display: none; }
  .product-card .rating-count-number::before { content: "("; }
  .product-card .rating-count-number::after { content: ")"; }
  .product-card .filled-star { fill: #001325; }

  @media screen and (max-width: 749px) {
    .product-card .price-item--sale.price { font-size: 11px; }
    .product-card .price-item--regular.compare-at-price,
    .product-card .sale-badge__pill { font-size: 10px; }
    .product-card .price__sale { gap: 0.2rem; }
    .product-card .price__sale .sale-badge__pill--inline::before { margin-right: 3px; }
  }

  /* Quick-add modal price (matches card) + hide the image badge in the modal. */
  #quick-add-dialog .product-badges { display: none; }
  #quick-add-dialog .price__sale { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; }
  #quick-add-dialog .price__sale > *:nth-child(1) { order: 2; }
  #quick-add-dialog .price__sale > *:nth-child(2) { order: 1; }
  #quick-add-dialog .price__sale > *:nth-child(3) { order: 3; }
  #quick-add-dialog .sale-badge__pill { color: #068743; background: transparent; font-weight: 600; padding-inline: 0; }
{% endstylesheet %}
