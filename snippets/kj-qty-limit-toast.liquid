{%- comment -%}
  Purchase-limit toast. Fires whenever a shopper tries to go past a quantity
  input's max — by typing a number, or by pressing "+" when already at the cap.
  Covers the product form, cart drawer, cart page and quick-add modal.
  Note: {% raw %}{% stylesheet %}{% endraw %} must stay at the top level of the
  file, so it sits outside the settings check below.
{%- endcomment -%}
{%- if settings.max_quantity_per_product > 0 -%}
  <div class="kj-qty-toast" role="status" aria-live="polite" hidden>
    <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
      <circle cx="8" cy="8" r="6.4" stroke="currentColor" stroke-width="1.4"></circle>
      <path d="M8 4.9v3.6M8 11.1h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
    <span class="kj-qty-toast__text"></span>
  </div>

  <script>
    (function () {
      if (window.__kjQtyToast) return;
      window.__kjQtyToast = true;

      var hideTimer = null;
      var cartTimer = null;

      // Inside the cart (drawer or page) show the inline banner instead of a
      // floating toast — it reads as part of the cart rather than an overlay.
      // Keep the notice up briefly even though the cart re-renders (morphs)
      // after each quantity update, which would otherwise wipe it instantly.
      var showUntil = 0;

      function paintCartNotice(msg) {
        var notes = document.querySelectorAll('.kj-cart-limit-note');
        var shown = false;
        notes.forEach(function (note) {
          if (msg) {
            var text = note.querySelector('.kj-cart-limit-note__text');
            if (text) text.textContent = msg;
          }
          note.hidden = false;
          shown = true;
        });
        return shown;
      }

      function cartNotice(msg) {
        if (!document.querySelector('.kj-cart-limit-note')) return false;
        showUntil = Date.now() + 5000;
        if (!paintCartNotice(msg)) return false;
        if (cartTimer) clearTimeout(cartTimer);
        cartTimer = setTimeout(function () {
          showUntil = 0;
          document.querySelectorAll('.kj-cart-limit-note').forEach(function (n) { n.hidden = true; });
        }, 5000);
        return true;
      }

      // Re-apply after the cart section is replaced.
      new MutationObserver(function () {
        if (Date.now() < showUntil) paintCartNotice(null);
      }).observe(document.documentElement, { childList: true, subtree: true });

      function toast(msg) {
        // Prefer the in-cart banner when the shopper is looking at the cart.
        var inCart = document.querySelector('cart-drawer[open], dialog[open] .kj-cart-limit-note, .cart-form');
        if (inCart && cartNotice(msg)) return;

        var el = document.querySelector('.kj-qty-toast');
        if (!el) return;
        var text = el.querySelector('.kj-qty-toast__text');
        if (text) text.textContent = msg;
        el.hidden = false;
        void el.offsetWidth; // reflow so the transition replays
        el.classList.add('is-visible');
        if (hideTimer) clearTimeout(hideTimer);
        hideTimer = setTimeout(function () {
          el.classList.remove('is-visible');
          setTimeout(function () { el.hidden = true; }, 250);
        }, 2800);
      }

      function maxOf(input) {
        var m = parseInt(input.getAttribute('max') || '', 10);
        return isNaN(m) ? null : m;
      }

      function message(max) {
        return 'You can order up to ' + max + ' of this item.';
      }

      // Remember what was typed before the theme clamps the value.
      document.addEventListener('input', function (e) {
        var input = e.target;
        if (input && input.type === 'number') input.dataset.kjTyped = input.value;
      }, true);

      // Typed a number above the cap.
      document.addEventListener('change', function (e) {
        var input = e.target;
        if (!input || input.type !== 'number') return;
        var max = maxOf(input);
        if (max === null) return;
        var typed = parseInt(input.dataset.kjTyped || input.value, 10);
        if (!isNaN(typed) && typed > max) toast(message(max));
        delete input.dataset.kjTyped;
      }, true);

      // Pressed "+" while already at the cap. A disabled button fires no click,
      // so CSS gives it pointer-events:none and the wrapper catches it instead.
      document.addEventListener('click', function (e) {
        var target = e.target.closest
          ? e.target.closest('button[name="plus"], quantity-selector-component, cart-quantity-selector-component')
          : null;
        if (!target) return;
        var wrap = target.closest('quantity-selector-component, cart-quantity-selector-component');
        if (!wrap) return;
        var plus = wrap.querySelector('button[name="plus"]');
        // If the click came from the wrapper, only treat it as a "+" press when
        // that button is disabled (i.e. the shopper tapped a capped control).
        if (target === wrap && !(plus && plus.disabled)) return;
        var input = wrap.querySelector('input[type="number"]');
        if (!input) return;
        var max = maxOf(input);
        if (max === null) return;
        var cartQty = parseInt(input.getAttribute('data-cart-quantity') || '0', 10) || 0;
        var current = parseInt(input.value, 10) || 0;
        // On the product form the cap also counts what's already in the cart.
        var effective = wrap.tagName === 'CART-QUANTITY-SELECTOR-COMPONENT' ? current : current + cartQty;
        if (effective >= max) toast(message(max));
      }, true);
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .kj-qty-toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translate(-50%, 12px);
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: min(92vw, 380px);
    padding: 10px 16px;
    border-radius: 999px;
    background: #1c1c22;
    color: #fff;
    font-size: 13px;
    line-height: 18px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.28);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }

  .kj-qty-toast[hidden] {
    display: none;
  }

  .kj-qty-toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .kj-qty-toast svg {
    flex-shrink: 0;
    color: #f3c96b;
  }

  /* Let clicks on a capped "+" reach the wrapper so we can explain the limit
     (disabled buttons swallow click events). */
  quantity-selector-component button[name='plus']:disabled,
  cart-quantity-selector-component button[name='plus']:disabled {
    pointer-events: none;
  }

  /* Clear the sticky add-to-cart bar on phones. */
  @media screen and (max-width: 749px) {
    .kj-qty-toast {
      bottom: 96px;
    }
  }
{% endstylesheet %}
