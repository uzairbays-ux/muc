{%- comment -%}
  Shared base for the brand product-story sections (kj-fr-*): Montserrat
  (scoped to .kj-fr, the rest of the site keeps its fonts), colour tokens, and the image slot that keeps its exact space empty
  until an image is picked.

  Params (image slot mode): image, ratio (e.g. '4/3'), label, sizes
{%- endcomment -%}
{%- if image_slot -%}
  <div class="kj-fr-img{% if image == blank %} kj-fr-img--empty{% endif %}" style="aspect-ratio: {{ ratio | default: '1/1' }};">
    {%- if image != blank -%}
      {{ image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: sizes, widths: '400, 800, 1200, 1600', alt: image.alt, class: 'kj-fr-img__el' }}
    {%- else -%}
      <span class="kj-fr-img__hint">{{ label | default: 'Image' }}</span>
    {%- endif -%}
  </div>
{%- else -%}
  {%- comment -%} Montserrat isn't in the theme's font settings, so it comes from Google Fonts (only on pages using these sections). {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;800&display=swap">
  <style>
    .kj-fr {
      --fr-font: 'Montserrat', Arial, sans-serif;
      --fr-ink: #3f3f3f;
      --fr-pink: #dd5696;
      --fr-plum: #543c5e;
      --fr-band: #f2f2f2;
      --fr-hero-panel: #e6e7e9;
      --fr-muted: #8a8a8a;
      font-family: var(--fr-font);
      color: var(--fr-ink);
      grid-column: 1 / -1; /* full bleed inside the theme's section grid, like the source page */
    }
    .kj-fr * { font-family: inherit; }
    .kj-fr-img { position: relative; width: 100%; overflow: hidden; background: #eceaec; }
    .kj-fr-img__el { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .kj-fr-img--empty { background: repeating-linear-gradient(135deg, #ececee 0 14px, #f4f4f6 14px 28px); }
    .kj-fr-img__hint { position: absolute; inset: 0; display: grid; place-items: center; color: #a6a6ad; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; }
    .kj-fr-link { display: inline-flex; align-items: flex-start; gap: 10px; color: #7b6d82; font-size: 12px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; text-decoration: none; line-height: 1.6; }
    .kj-fr-link::before { content: ''; flex: 0 0 auto; width: 6px; height: 6px; margin-top: 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(-45deg); }
    .kj-fr-link:hover { color: var(--fr-pink); }
    .kj-fr-list { list-style: none; margin: 0; padding: 0; }
    .kj-fr-list li { position: relative; padding-left: 16px; margin: 0 0 8px; font-size: 14px; line-height: 1.35; }
    .kj-fr-list li::before { content: ''; position: absolute; left: 0; top: 4px; width: 8px; height: 8px; background: #d9d9d9; }
    .kj-fr-rte p { margin: 0 0 14px; }
    .kj-fr-rte strong { font-weight: 700; color: #1e1e1e; }
  </style>
{%- endif -%}
