{%- comment -%} Shared styles + add-to-bag for the kj-sale-* sections. Shopify includes each stylesheet/javascript tag once per page. {%- endcomment -%}
{% stylesheet %}
  .kjs { width: 100%; box-sizing: border-box; margin: 0 auto; padding: 0 var(--page-margin); min-width: 0; overflow-x: clip; display: flex; flex-direction: column; gap: 40px; font-family: var(--font-body--family); color: #1e1e1e; }
  .kjs a { text-decoration: none; color: inherit; }
  .kjs-h2 { margin: 0 0 20px; text-align: center; font-size: clamp(28px, 3.4vw, 44px); font-weight: 900; letter-spacing: -0.02em; color: #1e1e1e; }
  .kjs .kjs-alert, .kjs .kjs-alert:hover { color: var(--kjs-alert-fg, var(--kjs-dark)); text-decoration: none; }
  .kjs-alert { display: flex; align-items: center; justify-content: center; gap: 12px 32px; flex-wrap: wrap; padding: 20px 24px; border-radius: 12px; background: var(--kjs-alert-bg, var(--kjs-purple)); color: var(--kjs-alert-fg, var(--kjs-dark)); margin-top: -8px; }
  .kjs-alert__tag { font-size: 24px; font-weight: 900; line-height: 1; color: var(--kjs-dark); background: var(--kjs-lime); padding: 8px 14px; border-radius: 8px; transform: rotate(-3deg); animation: kjs-wiggle 2.4s ease-in-out infinite; transform-origin: 50% 60%; }
  @keyframes kjs-wiggle { 0%, 100% { transform: rotate(-3deg) scale(1); } 20% { transform: rotate(-5deg) scale(1.04); } 40% { transform: rotate(-1deg) scale(1); } 60% { transform: rotate(-4deg) scale(1.03); } 80% { transform: rotate(-2deg) scale(1); } }
  @media (prefers-reduced-motion: reduce) { .kjs-alert__tag { animation: none; } }
  .kjs-alert__text { font-size: 22px; font-weight: 700; text-transform: uppercase; text-align: center; }
  .kjs-alert__text p { margin: 0; display: inline; color: inherit; font: inherit; }
  .kjs-alert__text p strong, .kjs-alert__text p em { color: inherit; font-style: normal; }
  .kjs-alert__was { opacity: .6; font-weight: 500; margin: 0 8px 0 10px; }
  .kjs-alert__now { margin-left: 2px; background: var(--kjs-lime); color: var(--kjs-dark); padding: 2px 10px; border-radius: 6px; }
  .kjs-alert__tag { box-shadow: 0 2px 0 var(--kjs-dark); }
  .kjs-alert__slides { display: grid; min-width: 0; }
  .kjs-alert__cta { display: inline-block; margin-left: 14px; border: 2px solid var(--kjs-lime); color: var(--kjs-lime); border-radius: 999px; padding: 4px 14px; font-size: 14px; font-weight: 800; letter-spacing: 0.04em; vertical-align: middle; white-space: nowrap; transition: background .2s, color .2s; }
  .kjs .kjs-alert__slide:hover .kjs-alert__cta { background: var(--kjs-lime); color: var(--kjs-dark); }
  .kjs .kjs-alert__slide { grid-area: 1 / 1; opacity: 0; transform: translateY(8px); transition: opacity .45s ease, transform .45s ease; pointer-events: none; color: var(--kjs-alert-fg, var(--kjs-dark)); text-decoration: none; }
  .kjs .kjs-alert__slide.is-active { opacity: 1; transform: none; pointer-events: auto; }
  .kjs .kjs-alert__slide:hover { color: var(--kjs-alert-fg, var(--kjs-dark)); }
  .kjs-hero { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 32px; padding: clamp(28px, 5vw, 64px); border-radius: 16px; background: var(--kjs-purple); color: var(--kjs-dark); min-height: 440px; box-sizing: border-box; overflow: hidden; }
  .kjs-hero--pattern::before { content: ''; position: absolute; inset: 0; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='230' height='130'><text x='4' y='104' font-family='Arial Narrow,Arial,sans-serif' font-weight='900' font-size='118' letter-spacing='-6' fill='white' fill-opacity='0.16'>11:11</text></svg>"); background-size: 230px 130px; background-position: -20px -14px; pointer-events: none; -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 24%, transparent 34%, transparent 66%, #000 76%, #000 100%); mask-image: linear-gradient(to bottom, #000 0, #000 24%, transparent 34%, transparent 66%, #000 76%, #000 100%); }
  .kjs-hero--image::before { background-image: var(--kjs-hero-pattern); background-size: cover; background-position: center; -webkit-mask-image: none; mask-image: none; }
  .kjs-confetti { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 60; }
  .kjs-hero > * { position: relative; }
  .kjs-hero--anim .kjs-hero__title, .kjs-hero--anim .kjs-hero__tag, .kjs-hero--anim .kjs-hero__upto, .kjs-hero--anim .kjs-hero__pct, .kjs-hero--anim .kjs-hero__off { animation: kjs-rise .7s cubic-bezier(.2,.8,.2,1) both; }
  .kjs-hero--anim .kjs-hero__tag { animation-delay: .15s; }
  .kjs-hero--anim .kjs-hero__upto { animation-delay: .25s; }
  .kjs-hero--anim .kjs-hero__pct { animation: kjs-pop .9s cubic-bezier(.2,.8,.2,1) .35s both, kjs-pulse 3s ease-in-out 1.4s infinite; }
  .kjs-hero--anim .kjs-hero__off { animation-delay: .5s; }
  @keyframes kjs-rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  @keyframes kjs-pop { from { opacity: 0; transform: scale(.7); } to { opacity: 1; transform: scale(1); } }
  @keyframes kjs-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.03); } }
  @media (prefers-reduced-motion: reduce) { .kjs-hero--pattern::before, .kjs-hero--anim * { animation: none !important; } }
  .kjs-hero__left { flex: 1 1 380px; display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .kjs-hero__title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 18px; max-width: 100%; box-sizing: border-box; border: 4px solid var(--kjs-dark); background: var(--kjs-lime); padding: 8px 22px; font-size: clamp(40px, 4.6vw, 68px); font-weight: 900; line-height: 1; letter-spacing: -0.02em; }
  .kjs-hero__tag { background: var(--kjs-lime); border: 2px solid var(--kjs-dark); border-radius: 10px; padding: 8px 18px; font-size: clamp(16px, 1.8vw, 24px); font-weight: 800; letter-spacing: 0.02em; }
  .kjs-hero__timer { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 14px; margin-top: 14px; }
  .kjs-hero__timer[hidden] { display: none; }
  .kjs-hero__timer-label { font-size: 13px; font-weight: 900; letter-spacing: 0.08em; color: var(--kjs-dark); }
  .kjs-hero__timer-units { display: inline-flex; align-items: center; gap: 6px; }
  .kjs-hero__timer-unit { display: inline-flex; flex-direction: column; align-items: center; min-width: 58px; background: var(--kjs-dark); color: var(--kjs-lime); border-radius: 10px; padding: 6px 8px 5px; line-height: 1; }
  .kjs-hero__timer-unit b { font-size: 26px; font-weight: 900; font-variant-numeric: tabular-nums; }
  .kjs-hero__timer-unit small { font-size: 9px; font-weight: 800; letter-spacing: 0.1em; color: #fff; margin-top: 3px; }
  .kjs-hero__timer-sep { font-size: 22px; font-weight: 900; color: var(--kjs-dark); }
  .kjs-hero--anim .kjs-hero__timer { animation: kjs-rise .7s cubic-bezier(.2,.8,.2,1) both; animation-delay: .35s; }
  .kjs-hero__note { display: inline-block; margin-top: 4px; background: var(--kjs-dark); color: var(--kjs-lime); border-radius: 999px; padding: 8px 16px; font-size: 13px; font-weight: 800; letter-spacing: 0.06em; }
  .kjs-hero__right { flex: 1 1 320px; display: flex; flex-direction: column; align-items: flex-start; line-height: 0.9; }
  .kjs-hero__upto, .kjs-hero__off { font-size: clamp(24px, 2.6vw, 36px); font-weight: 700; }
  .kjs-hero__off { align-self: flex-end; margin-right: 8%; }
  .kjs-hero__pct { font-size: clamp(120px, 15vw, 220px); font-weight: 900; letter-spacing: -0.04em; color: var(--kjs-lime); -webkit-text-stroke: 3px var(--kjs-dark); }
  .kjs-cats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 20px; }
  .kjs-cat { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  .kjs-cat__img { width: 120px; height: 120px; border-radius: 50%; overflow: hidden; background: radial-gradient(circle at 50% 35%, #f1eafa 0%, #c9b6e3 100%); display: flex; align-items: center; justify-content: center; }
  .kjs-cat__img img { width: 100%; height: 100%; object-fit: cover; }
  .kjs-cat--text .kjs-cat__img { background-size: cover; background-position: center; background-color: var(--kjs-purple); }
  .kjs-cat__inname { color: #fff; font-weight: 900; font-size: 17px; line-height: 1.1; text-align: center; padding: 0 10px; text-shadow: 0 1px 2px rgba(0,0,0,.25); letter-spacing: -0.01em; }
  .kjs-cat--text .kjs-cat__pct { margin-top: 0; }
  @media screen and (max-width: 749px) { .kjs-cat__inname { font-size: 13px; } }
  .kjs-cat__name { font-size: 14px; font-weight: 500; line-height: 1.25; }
  .kjs-cat__pct { font-size: 14px; font-weight: 800; line-height: 1.25; margin-top: -8px; }
  .kjs-rewards { display: flex; flex-wrap: wrap; align-items: center; gap: 24px 40px; padding: clamp(24px, 4vw, 40px); border-radius: 16px; background: var(--kjs-dark); color: #fff; }
  .kjs-rewards__head { flex: 1 1 280px; display: flex; flex-direction: column; gap: 4px; font-size: clamp(36px, 4vw, 56px); font-weight: 900; line-height: 0.95; }
  .kjs-rewards__lime { color: var(--kjs-lime); }
  .kjs-letters__word { display: inline-block; white-space: nowrap; }
  .kjs-letters__ch { display: inline-block; animation: kjs-letter 2.4s cubic-bezier(.3,1.4,.4,1) both infinite; animation-delay: calc(var(--i, 0) * 70ms); }
  @keyframes kjs-letter { 0% { opacity: 0; transform: translateY(.6em) rotate(-8deg) scale(.6); } 18% { opacity: 1; transform: translateY(-.08em) rotate(2deg) scale(1.08); } 28%, 100% { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .kjs-letters__ch { animation: none; } }
  .kjs-rewards__tiers { flex: 2 1 520px; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; }
  .kjs-tier { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; padding: 18px 14px; border: 2px solid var(--kjs-purple); border-radius: 14px; background: #2a2a2a; }
  .kjs-tier__name { font-size: 22px; font-weight: 800; }
  .kjs-tier__shop { font-size: 11px; font-weight: 700; background: var(--kjs-lime); color: var(--kjs-dark); padding: 4px 10px; border-radius: 999px; }
  .kjs-tier__reward { font-size: 14px; line-height: 1.35; color: #ddd; }
  .kjs-tier__plus { font-size: 18px; font-weight: 700; }
  .kjs-tier__bonus { font-size: 18px; font-weight: 800; line-height: 1.2; color: var(--kjs-lime); }
  .kjs-tiles { display: grid; gap: 16px; }
  .kjs-tiles > *, .kjs-grid > * { min-width: 0; }
  .kjs-fave__desc, .kjs-brand__name, .kjs-steal__name { overflow-wrap: anywhere; }
  .kjs-tiles--fave { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .kjs-tiles--steal { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .kjs-tiles--brand { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; }
  @media screen and (min-width: 750px) and (max-width: 1199px) { .kjs-tiles--fave, .kjs-tiles--brand { grid-template-columns: repeat(3, minmax(0, 1fr)); } .kjs-tiles--steal { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .kjs-fave { display: flex; flex-direction: column; justify-content: space-between; aspect-ratio: 4 / 3; padding: 16px; box-sizing: border-box; border-radius: 14px; background: var(--kjs-purple); }
  .kjs-fave__top { display: flex; flex-direction: column; gap: 2px; }
  .kjs-fave__brand { font-size: 18px; font-weight: 800; }
  .kjs-fave__desc { font-size: 12px; }
  .kjs-fave__price { align-self: flex-start; display: flex; flex-direction: column; line-height: 1; background: var(--kjs-lime); padding: 8px 12px; border-radius: 10px; font-size: 12px; font-weight: 700; }
  .kjs-fave__num { font-size: 34px; font-weight: 900; }
  .kjs-badge { display: flex; flex-direction: column; line-height: 0.95; padding: 8px 12px; border-radius: 10px; color: var(--kjs-dark); }
  .kjs-badge--purple { background: var(--kjs-purple); }
  .kjs-badge--lime { background: var(--kjs-lime); align-self: flex-end; align-items: flex-end; line-height: 0.9; }
  .kjs-badge__k { font-size: 12px; font-weight: 800; letter-spacing: 0.08em; }
  .kjs-badge__p { font-size: 44px; font-weight: 900; }
  .kjs-badge--lime .kjs-badge__p { font-size: 40px; }
  .kjs-badge__o { font-size: 14px; font-weight: 800; letter-spacing: 0.1em; }
  .kjs-steal { display: flex; justify-content: space-between; gap: 12px; aspect-ratio: 16 / 10; padding: 18px; box-sizing: border-box; border-radius: 14px; background: #f3edf9; border: 1px solid #ddd0ec; }
  .kjs-steal__text { display: flex; flex-direction: column; justify-content: space-between; }
  .kjs-steal__name { font-size: 16px; font-weight: 800; letter-spacing: 0.02em; }
  .kjs-steal__img { flex: 0 0 46%; border-radius: 10px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .kjs-steal__img:empty { border: 1.5px dashed #b9aacb; }
  .kjs-steal__img img { width: 100%; height: 100%; object-fit: cover; }
  .kjs-brand { display: flex; flex-direction: column; justify-content: space-between; aspect-ratio: 4 / 3; padding: 14px 16px; box-sizing: border-box; border-radius: 12px; background: var(--kjs-purple); overflow: hidden; }
  .kjs-brand__name { font-size: 17px; font-weight: 800; line-height: 1.15; }
  .kjs-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; background: var(--kjs-dark); border-radius: 10px; padding: 18px 24px; margin-bottom: 20px; }
  .kjs-bar__title { margin: 0; font-size: 20px; font-weight: 700; color: #fff; }
  .kjs-bar__title span { font-weight: 400; color: #ccc; font-size: 14px; }
  .kjs .kjs-bar__link { color: var(--kjs-lime); font-size: 14px; font-weight: 600; text-decoration: none; }
  .kjs .kjs-bar__link:hover { text-decoration: underline; }
  .kjs-carousel { position: relative; }
  .kjs-grid { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; padding-bottom: 4px; }
  .kjs-grid::-webkit-scrollbar { display: none; }
  .kjs-grid > .kjs-card { flex: 0 0 calc((100% - 5 * 16px) / 6); scroll-snap-align: start; }
  @media screen and (min-width: 750px) and (max-width: 1199px) { .kjs-grid > .kjs-card { flex-basis: calc((100% - 3 * 16px) / 4); } }
  .kjs-carousel__btn { position: absolute; top: 38%; z-index: 2; width: 40px; height: 40px; border-radius: 50%; border: 1px solid #ddd; background: #fff; color: #1e1e1e; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,.12); transform: translateY(-50%); }
  .kjs-carousel__btn--prev { left: -12px; }
  .kjs-carousel__btn--next { right: -12px; }
  .kjs-carousel__btn[disabled] { opacity: 0; pointer-events: none; }
  .kjs-card--more { display: flex; align-items: center; justify-content: center; text-align: center; border-radius: 8px; background: var(--kjs-purple); color: var(--kjs-dark); min-height: 100%; }
  .kjs-card--more__inner { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 16px; }
  .kjs-card--more__title { font-size: 22px; font-weight: 900; }
  .kjs-card--more__sub { font-size: 13px; font-weight: 600; opacity: .85; }
  .kjs-card--more__arrow { margin-top: 8px; width: 44px; height: 44px; border-radius: 50%; background: var(--kjs-lime); display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 900; }
  .kjs-card { display: flex; flex-direction: column; gap: 6px; min-width: 0; background: #fff; border: 1px solid #e3dbee; border-radius: 12px; padding: 10px; box-sizing: border-box; transition: box-shadow .2s, border-color .2s; }
  .kjs-card:hover { border-color: var(--kjs-purple); box-shadow: 0 6px 18px rgba(169,139,203,.25); }
  .kjs-card--more { border: 0; padding: 0; }
  .kjs-card__media { position: relative; display: flex; align-items: center; justify-content: center; aspect-ratio: 1 / 1; border: 0; border-radius: 8px; overflow: hidden; background: #f6f3f9; }
  .kjs-card__media img { width: 100%; height: 100%; object-fit: contain; }
  .kjs-card__off { position: absolute; top: 0; right: 0; background: var(--kjs-red); color: #fff; font-size: 12px; font-weight: 600; line-height: 1; padding: 6px 9px; border-bottom-left-radius: 6px; }
  .kjs-card__flag { position: absolute; top: 8px; left: 8px; background: #fff1e0; color: #8a4b00; font-size: 10px; font-weight: 700; letter-spacing: 0.04em; line-height: 1; padding: 4px 6px; border-radius: 4px; text-transform: uppercase; }
  .kjs-card__brand { font-size: 15px; font-weight: 700; color: #111; margin-top: 4px; }
  .kjs .kjs-card__name { color: #555; font-size: 13px; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 35px; }
  .kjs-card__price { margin: 0; display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; font-size: 15px; }
  .kjs-card__price s { font-size: 12px; color: #767676; }
  .kjs-card__price strong { font-weight: 700; color: #111; }
  .kjs-card__pct { font-size: 12px; color: #1e7d45; border-left: 1px solid #ddd; padding-left: 6px; }
  .kjs-card__save { align-self: flex-start; background: #e9f7ee; color: #1e7d45; font-size: 12px; font-weight: 500; padding: 5px 10px; border-radius: 999px; }
  .kjs-partners { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .kjs-partner { display: flex; align-items: center; gap: 18px; padding: 22px 24px; border-radius: 14px; background: #fff; border: 1px solid #e3dbee; color: var(--kjs-dark); }
  .kjs-partner__logo { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 96px; height: 56px; border-radius: 10px; background: var(--kjs-partner-bg, #f3edf9); color: var(--kjs-partner-fg, #fff); font-weight: 900; font-size: 20px; letter-spacing: -0.01em; overflow: hidden; }
  .kjs-partner__logo img { max-width: 80%; max-height: 80%; object-fit: contain; }
  .kjs-partner__body { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .kjs-partner__title { font-size: 18px; font-weight: 800; line-height: 1.2; }
  .kjs-partner__text { font-size: 13px; line-height: 1.4; color: #444; }
  .kjs-partner__badge { align-self: flex-start; margin-top: 4px; background: var(--kjs-lime); color: var(--kjs-dark); font-size: 11px; font-weight: 800; letter-spacing: 0.04em; padding: 4px 9px; border-radius: 999px; text-transform: uppercase; }
  @media screen and (max-width: 749px) { .kjs-partners { grid-template-columns: 1fr; gap: 10px; } .kjs-partner { padding: 14px; gap: 12px; } .kjs-partner__logo { width: 72px; height: 44px; font-size: 16px; } .kjs-partner__title { font-size: 15px; } .kjs-partner__text { font-size: 12px; } }
  .kjs-card__actions { display: flex; gap: 8px; margin-top: 6px; }
  .kjs-card__wish { flex: 0 0 44px; height: 44px; border-radius: 50%; border: 1px solid #d0d0d0; background: #fff; color: #1e1e1e; display: flex; align-items: center; justify-content: center; }
  .kjs .kjs-card__btn, .kjs .kjs-card__btn:hover { color: #fff; text-decoration: none; }
  .kjs-card__btn { flex: 1; min-height: 44px; border: 0; border-radius: 999px; background: var(--kjs-red); color: #fff; font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .kjs .kjs-card__btn.is-disabled { background: #bbb; cursor: default; }
  .kjs-ticker { display: flex; align-items: center; justify-content: center; gap: 12px 28px; flex-wrap: wrap; padding: 20px 24px; border-radius: 12px; background: var(--kjs-lime); color: var(--kjs-dark); }
  .kjs-ticker__num { font-size: 30px; font-weight: 900; line-height: 1; }
  .kjs-ticker__text { font-size: clamp(18px, 2vw, 26px); font-weight: 800; letter-spacing: 0.01em; text-transform: uppercase; }
  .kjs-ticker__btn { font-size: 14px; font-weight: 700; background: var(--kjs-dark); color: #fff; padding: 10px 18px; border-radius: 999px; }
  .kjs-cta { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 26px clamp(20px, 4vw, 40px); border-radius: 12px; background: #f3edf9; color: var(--kjs-dark); }
  .kjs-cta__text { font-size: clamp(26px, 3.4vw, 44px); font-weight: 900; letter-spacing: -0.01em; text-transform: uppercase; }
  .kjs-cta__btn { font-size: 14px; font-weight: 600; background: #fff; border: 1px solid var(--kjs-dark); padding: 12px 22px; border-radius: 8px; }
  @media screen and (max-width: 749px) {
    .kjs { gap: 24px; }
    .kjs-alert { padding: 14px 16px; gap: 10px; }
    .kjs-alert__tag { font-size: 16px; padding: 6px 10px; }
    .kjs-hero__title { font-size: clamp(28px, 8.5vw, 44px); padding: 6px 14px; gap: 6px 12px; }
    .kjs-hero__tag { font-size: 13px; padding: 6px 12px; }
    .kjs-hero__fine { font-size: 10px; }
    .kjs-hero__note { font-size: 10px; padding: 5px 10px; letter-spacing: 0.04em; white-space: nowrap; }
    .kjs-hero__timer { margin-top: 10px; gap: 6px 10px; }
    .kjs-hero__timer-label { font-size: 11px; }
