  .kjs-copy { position: relative; overflow: hidden; cursor: pointer; font-family: inherit; color: inherit; width: 100%; }
  .kjs-tier__hint { font-size: 11px; color: #aaa; letter-spacing: 0.04em; text-transform: uppercase; transition: opacity .15s; }
  @media (hover: hover) { .kjs-tier__hint { opacity: 0; } .kjs-tier:hover .kjs-tier__hint, .kjs-tier:focus-visible .kjs-tier__hint { opacity: 1; } }
  .kjs-copy__done { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; background: var(--kjs-lime); color: var(--kjs-dark); opacity: 0; pointer-events: none; transition: opacity .15s; border-radius: inherit; }
  .kjs-copy__done-t { font-size: 20px; font-weight: 900; }
  .kjs-copy__done-c { font-size: 14px; font-weight: 700; letter-spacing: 0.04em; }
  .kjs-copy.is-copied .kjs-copy__done { opacity: 1; }
  /* theme card-grid used on the sale page: match the sale headings, no section background */
  body:has(.kjs) .card-grid__heading { font-weight: 900; font-size: clamp(28px, 3.4vw, 44px); letter-spacing: -0.02em; color: #1e1e1e; font-family: var(--font-body--family); }
  body:has(.kjs) [data-testid^="card-grid-"] { background: transparent; }
  body:has(.kjs) [data-testid^="card-grid-"] ~ .section-background, body:has(.kjs) .shopify-section:has([data-testid^="card-grid-"]) > .section-background { background: transparent; }
  .kjs--page-width { max-width: var(--page-width); }
  .kjs--full-width { max-width: none; padding-left: 0; padding-right: 0; }
  .kjs--full-width > .kjs-alert, .kjs--full-width > .kjs-hero, .kjs--full-width > .kjs-rewards, .kjs--full-width > .kjs-ticker, .kjs--full-width > .kjs-cta { border-radius: 0; margin-top: 0; }
  .kjs--full-width > .kjs-sec, .kjs--full-width > .kjs-cats { padding-left: 16px; padding-right: 16px; }
  .kj-sale-section--sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; }
  .kjs-sticky { position: relative; background: var(--kjs-sticky-bg, #1E1E1E); color: var(--kjs-sticky-fg, #fff); box-shadow: 0 -4px 18px rgba(0,0,0,.18); }
  .kjs-sticky[hidden] { display: none; }
  .kjs-sticky__inner, .kjs-sticky__inner:hover { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 8px 22px; padding: 10px 48px 10px 16px; color: var(--kjs-sticky-fg, #fff); text-decoration: none; }
  .kjs-sticky__title { font-weight: 900; font-size: 18px; letter-spacing: -0.01em; background: var(--kjs-lime); color: var(--kjs-dark); padding: 4px 10px; border-radius: 6px; transform: rotate(-2deg); }
  .kjs-sticky__sub { font-weight: 900; font-size: 18px; }
  .kjs-sticky__timer.kjs-hero__timer { margin-top: 0; gap: 8px 10px; }
  .kjs-sticky .kjs-hero__timer-label { color: var(--kjs-sticky-fg, #fff); font-size: 11px; }
  .kjs-sticky .kjs-hero__timer-unit { min-width: 44px; padding: 4px 6px 4px; background: var(--kjs-lime); color: var(--kjs-dark); }
  .kjs-sticky .kjs-hero__timer-unit b { font-size: 18px; }
  .kjs-sticky .kjs-hero__timer-unit small { color: var(--kjs-dark); font-size: 8px; }
  .kjs-sticky .kjs-hero__timer-sep { color: var(--kjs-lime); font-size: 16px; }
  .kjs-sticky__btn { background: var(--kjs-red); color: #fff; font-weight: 800; font-size: 13px; padding: 9px 16px; border-radius: 999px; white-space: nowrap; animation: kjs-pulse 1.8s ease-in-out infinite; }
  .kjs-sticky__close { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); width: 32px; height: 32px; border: 0; border-radius: 50%; background: rgba(255,255,255,.14); color: #fff; font-size: 20px; line-height: 1; cursor: pointer; }
  body.kjs-has-sticky { padding-bottom: 64px; }
  @media screen and (max-width: 749px) {
    .kjs-sticky__inner { flex-wrap: nowrap; gap: 8px; padding: 8px 40px 8px 10px; }
    .kjs-sticky__title { font-size: 11px; padding: 3px 6px; white-space: nowrap; transform: none; }
    .kjs-sticky__sub { display: none; }
    .kjs-sticky .kjs-hero__timer-label { display: none; }
    .kjs-sticky__timer.kjs-hero__timer { flex-wrap: nowrap; gap: 4px; }
    .kjs-sticky .kjs-hero__timer-units { gap: 3px; }
    .kjs-sticky .kjs-hero__timer-unit { min-width: 32px; padding: 3px 4px; border-radius: 6px; }
    .kjs-sticky .kjs-hero__timer-unit b { font-size: 14px; }
    .kjs-sticky .kjs-hero__timer-unit small { font-size: 7px; margin-top: 2px; }
    .kjs-sticky .kjs-hero__timer-sep { font-size: 13px; }
    .kjs-sticky__btn { font-size: 11px; padding: 7px 10px; }
    .kjs-sticky__close { right: 6px; width: 28px; height: 28px; font-size: 18px; }
    body.kjs-has-sticky { padding-bottom: 60px; }
  }
  .kjs-hero__fine { display: block; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; opacity: .8; margin-top: 2px; }
  .kjs-pdp-timer, .kjs-pdp-timer:hover { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 14px; margin: 10px 0 14px; padding: 10px 14px; border-radius: 12px; background: var(--kjs-purple); color: var(--kjs-dark); text-decoration: none; }
  .kjs-pdp-timer__title { font-weight: 900; font-size: 14px; background: var(--kjs-lime); border: 2px solid var(--kjs-dark); border-radius: 8px; padding: 3px 8px; white-space: nowrap; }
  .kjs-pdp-timer__timer.kjs-hero__timer { margin-top: 0; gap: 6px 10px; }
  .kjs-pdp-timer .kjs-hero__timer-label { font-size: 11px; }
  .kjs-pdp-timer .kjs-hero__timer-unit { min-width: 40px; padding: 4px 5px 3px; }
  .kjs-pdp-timer .kjs-hero__timer-unit b { font-size: 16px; }
  .kjs-pdp-timer .kjs-hero__timer-unit small { font-size: 7px; margin-top: 2px; }
  .kjs-pdp-timer .kjs-hero__timer-sep { font-size: 14px; }
  .kjs-pdp-timer .kjs-hero__timer[hidden] { display: none; }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', (e) => {
    const b = e.target.closest('[data-kjs-prev],[data-kjs-next]');
    if (!b) return;
    const track = b.closest('.kjs-carousel').querySelector('[data-kjs-track]');
    track.scrollBy({ left: (b.hasAttribute('data-kjs-next') ? 1 : -1) * track.clientWidth, behavior: 'smooth' });
  });
  document.querySelectorAll('[data-kjs-alert-slider]').forEach((el) => {
    const slides = el.querySelectorAll('.kjs-alert__slide');
    if (slides.length < 2) return;
    let i = 0;
    setInterval(() => {
      slides[i].classList.remove('is-active');
      i = (i + 1) % slides.length;
      slides[i].classList.add('is-active');
    }, (parseInt(el.getAttribute('data-interval'), 10) || 4) * 1000);
  });
  document.querySelectorAll('[data-kjs-sticky]').forEach((el) => {
    let dismissed = false;
    try { dismissed = sessionStorage.getItem('kjsStickyClosed') === '1'; } catch (e) {}
    if (dismissed) { el.hidden = true; return; }
    document.body.classList.add('kjs-has-sticky');
    const close = el.querySelector('[data-kjs-sticky-close]');
    if (close) close.addEventListener('click', () => {
      el.hidden = true; document.body.classList.remove('kjs-has-sticky');
      try { sessionStorage.setItem('kjsStickyClosed', '1'); } catch (e) {}
    });
  });
  document.querySelectorAll('[data-kjs-timer]').forEach((el) => {
    const end = Date.parse(el.getAttribute('data-kjs-timer'));
    const start = Date.parse(el.getAttribute('data-kjs-timer-start') || '');
    if (isNaN(end)) return;
    const h = el.querySelector('[data-kjs-t="h"]'), m = el.querySelector('[data-kjs-t="m"]'), s = el.querySelector('[data-kjs-t="s"]'), label = el.querySelector('[data-kjs-t="label"]');
    const pad = (n) => String(n).padStart(2, '0');
    const tick = () => {
      const now = Date.now();
      const preStart = !isNaN(start) && now < start;
      const left = (preStart ? start : end) - now;
      if (left <= 0) { el.hidden = true; clearInterval(iv); return; }
      if (label) label.textContent = el.getAttribute(preStart ? 'data-label-start' : 'data-label-end') || '';
      el.hidden = false;
      const secs = Math.floor(left / 1000);
      h.textContent = pad(Math.floor(secs / 3600)); m.textContent = pad(Math.floor(secs % 3600 / 60)); s.textContent = pad(secs % 60);
    };
    const iv = setInterval(tick, 1000); tick();
  });
  const kjsSyncArrows = () => {
    document.querySelectorAll('.kjs-carousel').forEach((c) => {
      const t = c.querySelector('[data-kjs-track]'); if (!t) return;
      const prev = c.querySelector('[data-kjs-prev]'), next = c.querySelector('[data-kjs-next]');
      const max = t.scrollWidth - t.clientWidth - 2;
      if (prev) prev.disabled = t.scrollLeft <= 2;
      if (next) next.disabled = t.scrollLeft >= max;
    });
  };
  document.addEventListener('scroll', (e) => { if (e.target && e.target.matches && e.target.matches('[data-kjs-track]')) kjsSyncArrows(); }, true);
  window.addEventListener('load', kjsSyncArrows); window.addEventListener('resize', kjsSyncArrows); document.addEventListener('DOMContentLoaded', kjsSyncArrows);

  (() => {
    const hero = document.querySelector('.kjs-hero--confetti');
    if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.__kjsConfettiDone) return; window.__kjsConfettiDone = true;
    const canvas = document.createElement('canvas'); canvas.className = 'kjs-confetti'; document.body.appendChild(canvas);
    const ctx = canvas.getContext('2d'); const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const size = () => { canvas.width = innerWidth * dpr; canvas.height = innerHeight * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); }; size();
    const colors = ['#D9F25B', '#A98BCB', '#FFFFFF', '#1E1E1E', '#D32F2F'];
    const parts = [];
    const spawn = (n, x, y, angle, spread, speed) => { for (let i = 0; i < n; i++) { const a = (angle + (Math.random() - 0.5) * spread) * Math.PI / 180; const v = speed * (0.6 + Math.random() * 0.8); parts.push({ x, y, vx: Math.cos(a) * v, vy: -Math.sin(a) * v, w: 6 + Math.random() * 6, h: 8 + Math.random() * 8, r: Math.random() * Math.PI, vr: (Math.random() - 0.5) * 0.3, c: colors[(Math.random() * colors.length) | 0], life: 1, decay: 0.006 + Math.random() * 0.006 }); } };
    const r = hero.getBoundingClientRect(); const cx = r.left + r.width / 2, cy = Math.max(80, r.top + r.height * 0.6);
    spawn(140, cx, cy, 90, 70, 16);
    const end = Date.now() + 1800;
    const sides = () => { spawn(3, 0, innerHeight * 0.65, 60, 55, 14); spawn(3, innerWidth, innerHeight * 0.65, 120, 55, 14); if (Date.now() < end) requestAnimationFrame(sides); };
    setTimeout(sides, 300);
    const tick = () => { ctx.clearRect(0, 0, innerWidth, innerHeight); for (const p of parts) { p.vy += 0.35; p.vx *= 0.99; p.vy *= 0.99; p.x += p.vx; p.y += p.vy; p.r += p.vr; p.life -= p.decay; ctx.save(); ctx.globalAlpha = Math.max(p.life, 0); ctx.translate(p.x, p.y); ctx.rotate(p.r); ctx.fillStyle = p.c; ctx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h); ctx.restore(); } for (let i = parts.length - 1; i >= 0; i--) if (parts[i].life <= 0 || parts[i].y > innerHeight + 40) parts.splice(i, 1); if (parts.length || Date.now() < end) requestAnimationFrame(tick); else canvas.remove(); };
    requestAnimationFrame(tick);
  })();

  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-kjs-copy]');
    if (!btn) return;
    try { await navigator.clipboard.writeText(btn.dataset.kjsCopy); } catch (err) {
      const ta = document.createElement('textarea'); ta.value = btn.dataset.kjsCopy; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); } catch (e2) {} ta.remove();
    }
    btn.classList.add('is-copied');
    setTimeout(() => btn.classList.remove('is-copied'), 1800);
  });

  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-kjs-add]');
    if (!btn || btn.disabled) return;
    e.preventDefault();
    btn.disabled = true;
    const label = btn.textContent;
    btn.textContent = 'Adding…';
    const sections = [...document.querySelectorAll('cart-items-component[data-section-id]')].map((el) => el.dataset.sectionId);
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(btn.dataset.kjsAdd), quantity: 1, properties: { _added_from: 'sale-page' } }], sections: sections.join(',') }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.description || data.message || 'Could not add');
      const cart = await fetch('/cart.js').then((r) => r.json());
      const ev = new Event('cart:update', { bubbles: true });
      ev.detail = { resource: cart, sourceId: btn.dataset.kjsAdd, data: { source: 'kj-sale', itemCount: 1, productId: btn.dataset.productId, variantId: btn.dataset.kjsAdd, sections: data.sections } };
      btn.dispatchEvent(ev);
      btn.textContent = 'Added';
      setTimeout(() => { btn.textContent = label; btn.disabled = false; }, 1500);
    } catch (err) {
      console.error('[kj-sale]', err);
      btn.textContent = 'Sold out';
      setTimeout(() => { btn.textContent = label; btn.disabled = false; }, 2500);
    }
  });
{% endjavascript %}
