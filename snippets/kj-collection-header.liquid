<div class="kj-collection-header">

  <div class="kj-collection-header__content">

    <div class="kj-collection-header__text">

      <nav class="kj-collection-header__crumbs" aria-label="breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="kj-collection-header__sep" aria-hidden="true">&rsaquo;</span>
        <span class="kj-collection-header__current" aria-current="page">
          {{ collection.title }}
        </span>
      </nav>

      <h1 class="kj-collection-header__title">
        {{ collection.title }}
      </h1>

      <p class="kj-collection-header__count">
        {{ collection.products_count }}
        {% if collection.products_count == 1 %}product{% else %}products{% endif %}
      </p>

    </div>

    {%- if collection.metafields.custom.collection_image != blank -%}
      <div class="kj-collection-header__image">
        {{
          collection.metafields.custom.collection_image
          | image_url: width: 2000
          | image_tag:
            loading: 'eager',
            widths: '375, 550, 750, 1100, 1500, 2000',
            sizes: '(max-width: 749px) 100vw, 50vw',
            alt: collection.title
        }}
      </div>
    {%- endif -%}

  </div>

</div>

{% stylesheet %}
  .kj-collection-header {
    width: 100%;
  }

  /* Two groups */
  .kj-collection-header__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    width: 100%;
  }

  /* Group 1: Breadcrumb + title + count */
  .kj-collection-header__text {
    flex: 1 1 50%;
    min-width: 0;
    text-align: left;
  }

  /* Group 2: Collection image */
  .kj-collection-header__image {
    flex: 1 1 50%;
    min-width: 0;
    overflow: hidden;
  }

  .kj-collection-header__image img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
  }

  .kj-collection-header__crumbs {
    font-size: 0.8125rem;
    color: #8a8a8a;
    margin-block-end: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .kj-collection-header__crumbs a {
    color: #8a8a8a;
    text-decoration: none;
  }

  .kj-collection-header__crumbs a:hover {
    color: #111;
    text-decoration: underline;
  }

  .kj-collection-header__sep {
    color: #c4c4c4;
  }

  .kj-collection-header__current {
    color: #111;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .kj-collection-header__title {
    margin: 0;
    font-size: 2rem;
    line-height: 1.1;
    font-weight: 700;
    color: #111;
  }

  .kj-collection-header__count {
    margin: 4px 0 0;
    font-size: 0.9375rem;
    color: #8a8a8a;
  }

  /* Mobile: text on top, image below */
  @media screen and (max-width: 749px) {
    .kj-collection-header__content {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
    }

    .kj-collection-header__text,
    .kj-collection-header__image {
      flex: none;
      width: 100%;
    }

    .kj-collection-header__title {
      font-size: 1.625rem;
    }

    .kj-collection-header__crumbs {
      font-size: 0.75rem;
    }

    .kj-collection-header__count {
      font-size: 0.875rem;
    }
  }
{% endstylesheet %}