{%- comment -%}
  Collection page header — breadcrumb, left-aligned title and product count,
  with the brand logo on the right when the collection has an image.

  The image is the collection's own image, falling back to the
  custom.collection_image metafield. (The metafield condition used to carry a
  stray hyphen - collection_image- - so it looked up a key that never exists
  and the image never rendered.)
{%- endcomment -%}

{%- liquid
  assign kj_ch_logo = collection.image
  if kj_ch_logo == blank
    assign kj_ch_logo = collection.metafields.custom.collection_image
  endif
-%}

<div class="kj-collection-header{% if kj_ch_logo != blank %} kj-collection-header--has-logo{% endif %}">

  <div class="kj-collection-header__text">

  <nav class="kj-collection-header__crumbs" aria-label="breadcrumb">
    <a href="{{ routes.root_url }}">Home</a>
    <span class="kj-collection-header__sep" aria-hidden="true">&rsaquo;</span>
    <span class="kj-collection-header__current" aria-current="page">
      {{ collection.title }}
    </span>
  </nav>

  <h1 class="kj-collection-header__title">
    {{ collection.title }}
  </h1>

  <p class="kj-collection-header__count">
    {{ collection.products_count }}
    {% if collection.products_count == 1 %}product{% else %}products{% endif %}
  </p>

  </div>

  {%- if kj_ch_logo != blank -%}
    <div class="kj-collection-header__logo">
      {{
        kj_ch_logo
        | image_url: width: 480
        | image_tag:
          loading: 'eager',
          widths: '120, 180, 240, 360, 480',
          sizes: '(min-width: 750px) 180px, 96px',
          alt: collection.title
      }}
    </div>
  {%- endif -%}

</div>

{% stylesheet %}
  .kj-collection-header {
    width: 100%;
    text-align: left;
  }

  /* Text left, brand logo right. */
  .kj-collection-header--has-logo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .kj-collection-header__text {
    min-width: 0;
  }

  .kj-collection-header__logo {
    flex: 0 0 auto;
    width: 180px;
    max-width: 35%;
  }

  .kj-collection-header__logo img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .kj-collection-header__crumbs {
    font-size: 0.8125rem;
    color: #8a8a8a;
    margin-block-end: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .kj-collection-header__crumbs a {
    color: #8a8a8a;
    text-decoration: none;
  }

  .kj-collection-header__crumbs a:hover {
    color: #111;
    text-decoration: underline;
  }

  .kj-collection-header__sep {
    color: #c4c4c4;
  }

  .kj-collection-header__current {
    color: #111;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .kj-collection-header__title {
    margin: 0;
    font-size: 2rem;
    line-height: 1.1;
    font-weight: 700;
    color: #111;
  }

  .kj-collection-header__count {
    margin: 4px 0 0;
    font-size: 0.9375rem;
    color: #8a8a8a;
  }

  @media screen and (max-width: 749px) {
    /* No section padding above or below the header on phones. */
    .section-content-wrapper:has(.kj-collection-header) {
      --padding-block-start: 0px;
      --padding-block-end: 0px;
      padding-block: 0;
    }

    .kj-collection-header__logo {
      width: 96px;
    }

    .kj-collection-header--has-logo {
      gap: 12px;
    }

    .kj-collection-header__title {
      font-size: 1.625rem;
    }

    .kj-collection-header__crumbs {
      font-size: 0.75rem;
    }

    .kj-collection-header__count {
      font-size: 0.875rem;
    }
  }
{% endstylesheet %}