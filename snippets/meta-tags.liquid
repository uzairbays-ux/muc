{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
{% comment %}
<meta
  name="view-transition"
  content="same-origin"
>
{% endcomment %}
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'

  # muc: a description for every page. Shopify's page_description is blank on
  # pages without an SEO description, and on products it is the first 320
  # characters of the description, which search engines cut off anyway.
  assign kj_description = page_description
  if kj_description == blank
    case request.page_type
      when 'collection'
        assign kj_description = 'Shop ' | append: collection.title | append: ' online in Pakistan at Makeup City: ' | append: collection.products_count | append: ' 100% original products from 150+ brands, with free delivery on orders over PKR 5,000.'
      when 'page'
        assign kj_description = page.content | strip_html | strip_newlines | strip | truncate: 155
        if kj_description == blank
          assign kj_description = page.title | append: ' at Makeup City Pakistan: 150+ original makeup, skincare, hair care and fragrance brands, with free delivery on orders over PKR 5,000.'
        endif
      when 'blog'
        assign kj_description = blog.title | append: ': beauty tips, tutorials and product guides from Makeup City Pakistan.'
      when 'article'
        assign kj_description = article.excerpt_or_content | strip_html | strip_newlines | truncate: 155
      when 'search'
        assign kj_description = 'Search 150+ original makeup, skincare, hair care and fragrance brands at Makeup City Pakistan.'
    endcase
  elsif kj_description.size > 170
    assign kj_description = kj_description | strip_newlines | truncate: 155
  endif
  if kj_description == blank
    assign kj_description = shop.description | default: shop.name
  endif
  assign og_description = kj_description

  # muc: share image fallback for pages that have none of their own.
  assign kj_page_image = page_image | default: settings.kj_share_image | default: settings.logo

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if kj_page_image -%}
  <meta
    property="og:image"
    content="http:{{ kj_page_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ kj_page_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:width"
    content="{{ kj_page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ kj_page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- comment -%} muc: the homepage title already names the brand; no suffix there. {%- endcomment -%}
  {%- unless page_title contains shop.name or request.page_type == 'index' %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if kj_description != blank %}
  <meta
    name="description"
    content="{{ kj_description | escape }}"
  >
{% endif %}
