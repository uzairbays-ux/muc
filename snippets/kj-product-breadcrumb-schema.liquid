{%- comment -%}
  BreadcrumbList schema for the product page: Home > collection > product.
  The collection is the one the shopper came from, else the product's first
  real category collection (sale, promo, "old", bundle and shop-all style
  collections are skipped).

  Params: product, collection (the current collection, may be blank)
{%- endcomment -%}
{%- liquid
  assign bc_coll = blank
  if collection != blank
    assign bc_coll = product.collections | where: 'handle', collection.handle | first
  endif
  if bc_coll == blank
    for c in product.collections
      assign ct = c.title | downcase
      assign skip = false
      if ct contains 'sale'
        assign skip = true
      endif
      if ct contains 'old'
        assign skip = true
      endif
      if ct contains 'promo'
        assign skip = true
      endif
      if ct contains 'offer'
        assign skip = true
      endif
      if ct contains 'bundle'
        assign skip = true
      endif
      if ct contains 'new'
        assign skip = true
      endif
      if ct contains 'best'
        assign skip = true
      endif
      if ct contains 'shop all'
        assign skip = true
      endif
      if ct contains 'flash'
        assign skip = true
      endif
      if ct contains 'deal'
        assign skip = true
      endif
      if ct contains 'under'
        assign skip = true
      endif
      if ct contains 'upto'
        assign skip = true
      endif
      if ct contains 'discount'
        assign skip = true
      endif
      if ct contains 'just in'
        assign skip = true
      endif
      if ct contains 'live'
        assign skip = true
      endif
      if skip == false
        assign bc_coll = c
        break
      endif
    endfor
  endif
  if bc_coll == blank
    assign bc_coll = product.collections | first
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | json }} }
      {%- if bc_coll != blank -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ bc_coll.title | json }}, "item": {{ request.origin | append: bc_coll.url | json }} }
        ,{ "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
      {%- else -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
      {%- endif -%}
    ]
  }
</script>
