{% assign productPageWidget = product.selected_or_first_available_variant.price | divided_by: 100 %}
{% if productPageWidget <= 20000 %}
<style>
  /* Same card as the Yango block above it: grey rounded panel, icon tile,
     bold line with a quiet subline, chevron on the right. */
  .baadmay-product-wrapper { margin: 0; width: 100%; }

  /* The custom-liquid wrapper shrinks to its text; span the column like Yango. */
  div:has(> .baadmay-product-wrapper) { width: 100%; align-self: stretch; }

  .baadmay-product-wrapper .baadmay-card {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    padding: 12px 20px 12px 12px;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.05);
    color: rgba(0, 0, 0, 0.86);
    text-decoration: none;
    cursor: pointer;
  }

  /* The logo file is the full wordmark badge (116x36), so show it whole. */
  .baadmay-product-wrapper .baadmay-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    height: 40px;
    padding: 0 4px 0 2px;
  }

  .baadmay-product-wrapper .baadmay-card__icon img {
    width: auto;
    height: 26px;
    border-radius: 0;
    object-fit: contain;
  }

  .baadmay-product-wrapper .baadmay-card__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1 1 auto;
    min-width: 0;
  }

  .baadmay-product-wrapper .baadmay-card__title {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 16px;
    color: rgba(0, 0, 0, 0.86);
  }

  .baadmay-product-wrapper .baadmay-card__title .price-divide { font-weight: 500; }

  .baadmay-product-wrapper .baadmay-card__sub {
    margin: 0;
    font-size: 13px;
    line-height: 16px;
    color: rgba(0, 0, 0, 0.5);
  }

  .baadmay-product-wrapper .baadmay-card__chevron {
    flex: 0 0 24px;
    width: 24px;
    height: 24px;
    color: rgba(0, 0, 0, 0.86);
  }
</style>

<div class="baadmay-gateway-wrapper baadmay baadmay-product-wrapper  {% if class %}{{ class }}{% endif %}">
  <div class="baadmay-para">
    <a
      class="baadmay-modal baadmay-card"
      data-vbtype="inline"
      data-overlayclose="false"
      data-maxwidth="620px"
      href="#baadmay-content"
      aria-label="Pay in 3 installments with Baadmay"
    >
      <span class="baadmay-card__icon">
        <img src="{{ 'baadmay-logo-icon.svg' | asset_url }}" alt="BaadMay" width="116" height="36" loading="lazy">
      </span>
      <span class="baadmay-card__text baadmay-price" data-product-id="{{ product.id }}">
        <span class="baadmay-card__title">
          Pay in 3 installments of
          <span class="baadmay-currency">
            {%- for currency in shop.enabled_currencies -%}
              {%- if currency.iso_code == shop.currency -%}Rs.{% break %}{%- endif -%}
            {%- endfor -%}
          </span>
          <span
            class="price-divide"
            total-prod-price="{{ current_variant.price }}"
            id="baadmay-installment"
          >{{ product.selected_or_first_available_variant.price | times: 1.15 | divided_by: 3 | divided_by: 100 | floor }}</span>
        </span>
        <span class="baadmay-card__sub">Pay later with Baadmay</span>
      </span>
      <svg class="baadmay-card__chevron" viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true">
        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
    <div id="baadmay-content" style="display:none;">
      <a href="#" class="baadmay-popup-close">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8.99915 1L1 8.99914" stroke="white" stroke-width="2" stroke-linecap="round" />
          <path d="M8.99915 9L1 1.00085" stroke="white" stroke-width="2" stroke-linecap="round" />
        </svg>
      </a>
      <div class="baadmay-popup-head">
        <h3>Pay for your purchase, thora abhi, baqi?</h3>
        <img
          src="https://baadmay.com/assets/baadmay-logo-white.svg"
          alt="baadmay logo"
          width="184"
          height="42"
          loading="lazy"
        >
        <div class="baadmay-info-box">
          <div class="baadmay-info-item">
            <img
              src="https://baadmay.com/assets/icon-calendar.svg"
              alt="Calendar Icon"
              width="80"
              height="80"
              loading="lazy"
            >
            <p>Pay in 3 Easy Installments</p>
          </div>
        </div>
      </div>
      <div class="baadmay-popup-content">
        <h3 class="baadmay-color-dark text-center mt-40 mb-24">Added items to your cart?</h3>
        <div class="baadmay-info-box compact-box">
          <div class="baadmay-info-item">
            <img
              src="https://baadmay.com/assets/icon-checkout.svg"
              alt="Checkout Icon"
              width="48"
              height="48"
              loading="lazy"
            >
            <p>Select BaadMay at Checkout</p>
          </div>
          <div class="baadmay-info-item">
            <img
              src="https://baadmay.com/assets/icon-account-details.svg"
              alt="Account Icon"
              width="48"
              height="48"
              loading="lazy"
            >
            <p>Verify your account details</p>
          </div>
          <div class="baadmay-info-item">
            <img
              src="https://baadmay.com/assets/icon-pay-first-installment.svg"
              alt="Installment Icon"
              width="48"
              height="48"
              loading="lazy"
            >
            <p>Pay only your first installment now</p>
          </div>
        </div>
        <h3 class="baadmay-color-primary text-center mt-32 mt-sm-24 mb-0">Let’s shop and pay BaadMay !</h3>
      </div>
    </div>
  </div>
</div>
{% endif %}