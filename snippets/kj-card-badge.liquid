{%- comment -%}
  Top-left product-card badge based on product tags.
    tag "Bestsellers" -> Bestseller badge
    tag "Mostly"      -> Editor's Pick badge
    tag "Featured"    -> Featured badge
  Rendered via a custom-liquid block; absolutely positioned over the image
  (its ancestor .product-card__content is position:relative).

  Images are self-hosted in Shopify Files.
{%- endcomment -%}
{%- liquid
  assign p = product | default: closest.product
  assign tl = p.tags | join: '|' | downcase | prepend: '|' | append: '|'
  assign badge_url = ''
  assign badge_alt = ''
  if tl contains '|bestsellers|'
    assign badge_url = 'https://cdn.shopify.com/s/files/1/0561/4259/4241/files/BestsellerPLP.webp?v=1786449505'
    assign badge_alt = 'Bestseller'
  elsif tl contains '|mostly|'
    assign badge_url = 'https://cdn.shopify.com/s/files/1/0561/4259/4241/files/Editor_Pickv2.webp?v=1786449504'
    assign badge_alt = "Editor's pick"
  elsif tl contains '|featured|'
    assign badge_url = 'https://cdn.shopify.com/s/files/1/0561/4259/4241/files/Featured_v3.webp?v=1786449504'
    assign badge_alt = 'Featured'
  endif
-%}
{%- if badge_url != '' -%}
  <div class="kj-tag-badge">
    <img src="{{ badge_url }}" alt="{{ badge_alt }}" width="64" loading="lazy">
  </div>
{%- endif -%}
{%- if settings.kj_logo_badge_enabled and settings.kj_logo_badge_on_cards and settings.kj_logo_badge_text != blank and p.compare_at_price > p.price and request.page_type != 'index' and request.page_type != 'collection' -%}
  <span class="kj-card-sale-tag" style="--kj-sale-bg: {{ settings.kj_logo_badge_bg | default: '#D9F25B' }}; --kj-sale-fg: {{ settings.kj_logo_badge_fg | default: '#1E1E1E' }};">{{ settings.kj_logo_badge_text | escape }}</span>
{%- endif -%}

{% stylesheet %}
  .kj-card-sale-tag { position: absolute; left: 6px; top: 6px; z-index: 3; pointer-events: none; background: var(--kj-sale-bg); color: var(--kj-sale-fg); font-size: 10px; font-weight: 800; letter-spacing: 0.04em; line-height: 1; padding: 4px 7px; border-radius: 6px; text-transform: uppercase; box-shadow: 0 1px 3px rgba(0,0,0,.15); }
  .kj-tag-badge + .kj-card-sale-tag { top: 74px; }
  .kj-tag-badge {
    position: absolute;
    top: 4px;
    left: 4px;
    z-index: 3;
    pointer-events: none;
    line-height: 0;
  }

  .kj-tag-badge img {
    display: block;
    width: 64px;
    height: auto;
  }
{% endstylesheet %}
