{%- comment -%}
  Encourages account creation: a one-time, dismissable tooltip near the account
  icon. Shows only for logged-out visitors, ~2.5s after load, once per browser.

  Visibility is driven by a class on <html> (which the theme never morphs), so a
  freshly re-rendered header tooltip still picks it up. All interaction is
  delegated at the document level for the same reason.
{%- endcomment -%}
{%- unless customer -%}
  <div class="acct-tip" data-acct-tip>
    <button type="button" class="acct-tip__close" aria-label="Dismiss" data-acct-tip-close>&times;</button>
    <a href="{{ routes.account_register_url }}" class="acct-tip__body">
      <span class="acct-tip__title">New here?</span>
      <span class="acct-tip__text">Create an account for faster checkout &amp; order tracking</span>
    </a>
  </div>

  {% style %}
    .account-button { position: relative; }

    .acct-tip {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      z-index: 60;
      width: 224px;
      background: var(--color-background, #fff);
      color: var(--color-foreground, #222);
      border-radius: 12px;
      box-shadow: 0 10px 30px rgb(0 0 0 / 0.18);
      padding: 12px 26px 12px 14px;
      font-size: 13px;
      line-height: 1.35;
      opacity: 0;
      transform: translateY(-6px);
      transition: opacity 0.25s ease, transform 0.25s ease;
      pointer-events: none;
    }

    html.acct-tip-show .acct-tip {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .acct-tip::before {
      content: "";
      position: absolute;
      top: -5px;
      right: 15px;
      width: 11px;
      height: 11px;
      background: inherit;
      transform: rotate(45deg);
    }

    .acct-tip__body {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .acct-tip__title {
      display: block;
      font-weight: 700;
      margin-bottom: 2px;
    }

    .acct-tip__text {
      color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.75);
    }

    .acct-tip__close {
      position: absolute;
      top: 4px;
      right: 8px;
      border: 0;
      background: none;
      padding: 2px;
      font-size: 17px;
      line-height: 1;
      cursor: pointer;
      color: inherit;
      opacity: 0.55;
    }

    .acct-tip__close:hover {
      opacity: 1;
    }
  {% endstyle %}

  <script>
    (function () {
      if (window.__acctTipInit) return;
      window.__acctTipInit = true;
      var KEY = 'mc-acct-tip-dismissed';
      var dismissed = false;
      try { dismissed = !!localStorage.getItem(KEY); } catch (e) {}
      var hideTimer;

      function hide(persist) {
        document.documentElement.classList.remove('acct-tip-show');
        if (persist) { try { localStorage.setItem(KEY, '1'); } catch (e) {} }
      }

      document.addEventListener('click', function (e) {
        if (e.target.closest('[data-acct-tip-close]')) {
          e.preventDefault(); e.stopPropagation();
          clearTimeout(hideTimer); hide(true); return;
        }
        if (e.target.closest('.acct-tip__body')) {
          try { localStorage.setItem(KEY, '1'); } catch (e) {}
        }
      });

      if (!dismissed) {
        setTimeout(function () {
          document.documentElement.classList.add('acct-tip-show');
          hideTimer = setTimeout(function () { hide(false); }, 8000);
        }, 2500);
      }
    })();
  </script>
{%- endunless -%}
