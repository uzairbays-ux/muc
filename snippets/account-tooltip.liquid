{%- comment -%}
  Encourages account creation: a one-time, dismissable tooltip near the account
  icon for logged-out visitors.

  The reveal is a pure CSS animation (fires ~2.5s after the element mounts, so it
  works even though the theme morphs the header after load). JS is used only to
  SUPPRESS it for visitors who already dismissed it (a class on <html>, which the
  theme never morphs), and to handle the dismiss click (delegated at document).
{%- endcomment -%}
{%- unless customer -%}
  <div class="acct-tip" data-acct-tip>
    <button type="button" class="acct-tip__close" aria-label="Dismiss" data-acct-tip-close>&times;</button>
    <a href="{{ routes.account_register_url }}" class="acct-tip__body">
      <span class="acct-tip__title">New here?</span>
      <span class="acct-tip__text">Create an account for faster checkout &amp; order tracking</span>
    </a>
  </div>

  {% style %}
    .account-button { position: relative; }

    .acct-tip {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      z-index: 60;
      width: 224px;
      background: var(--color-background, #fff);
      color: var(--color-foreground, #222);
      border-radius: 12px;
      box-shadow: 0 10px 30px rgb(0 0 0 / 0.18);
      padding: 12px 26px 12px 14px;
      font-size: 13px;
      line-height: 1.35;
      opacity: 0;
      transform: translateY(-6px);
      pointer-events: none;
      animation: acctTipReveal 12s ease forwards;
    }

    /* hidden until ~2.4s, fade in by ~2.8s, hold, then fade out by 12s */
    @keyframes acctTipReveal {
      0%, 20%   { opacity: 0; transform: translateY(-6px); pointer-events: none; }
      23%, 90%  { opacity: 1; transform: translateY(0);    pointer-events: auto; }
      100%      { opacity: 0; transform: translateY(-6px); pointer-events: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      .acct-tip { animation-duration: 10s; }
    }

    /* Suppressed for visitors who dismissed it */
    html.acct-tip-off .acct-tip {
      animation: none !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }

    .acct-tip::before {
      content: "";
      position: absolute;
      top: -5px;
      right: 15px;
      width: 11px;
      height: 11px;
      background: inherit;
      transform: rotate(45deg);
    }

    .acct-tip__body { display: block; text-decoration: none; color: inherit; }
    .acct-tip__title { display: block; font-weight: 700; margin-bottom: 2px; }
    .acct-tip__text { color: rgb(var(--color-foreground-rgb, 34 34 34) / 0.75); }

    .acct-tip__close {
      position: absolute;
      top: 4px;
      right: 8px;
      border: 0;
      background: none;
      padding: 2px;
      font-size: 17px;
      line-height: 1;
      cursor: pointer;
      color: inherit;
      opacity: 0.55;
    }
    .acct-tip__close:hover { opacity: 1; }
  {% endstyle %}

  <script>
    (function () {
      var KEY = 'mc-acct-tip-dismissed';
      /* Suppress on load for already-dismissed visitors (runs before the reveal). */
      try { if (localStorage.getItem(KEY)) document.documentElement.classList.add('acct-tip-off'); } catch (e) {}

      if (window.__acctTipInit) return;
      window.__acctTipInit = true;

      document.addEventListener('click', function (e) {
        if (e.target.closest('[data-acct-tip-close]')) {
          e.preventDefault(); e.stopPropagation();
          document.documentElement.classList.add('acct-tip-off');
          try { localStorage.setItem(KEY, '1'); } catch (err) {}
          return;
        }
        if (e.target.closest('.acct-tip__body')) {
          try { localStorage.setItem(KEY, '1'); } catch (err) {}
        }
      });
    })();
  </script>
{%- endunless -%}
