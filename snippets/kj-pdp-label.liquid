{%- comment -%}
  PDP eyebrow label above the brand — "MOST REORDERED" (purple) when the
  product has the "Mostly" tag; "BESTSELLER" fallback handled separately.
{%- endcomment -%}
{%- liquid
  assign p = product | default: closest.product
  assign tl = p.tags | join: '|' | downcase | prepend: '|' | append: '|'
-%}
{%- if settings.kj_logo_badge_enabled and settings.kj_logo_badge_on_pdp and settings.kj_logo_badge_text != blank and p.compare_at_price > p.price -%}
  <p class="kj-pdp-label kj-pdp-label--sale" style="--kj-sale-bg: {{ settings.kj_logo_badge_bg | default: '#D9F25B' }}; --kj-sale-fg: {{ settings.kj_logo_badge_fg | default: '#1E1E1E' }};">{{ settings.kj_logo_badge_text | escape }}</p>
{%- endif -%}
{%- if tl contains '|mostly|' -%}
  <p class="kj-pdp-label">Most Reordered</p>
{%- endif -%}

{% stylesheet %}
  .kj-pdp-label--sale { display: none; background: var(--kj-sale-bg); color: var(--kj-sale-fg); padding: 3px 8px; border-radius: 6px; letter-spacing: 0.4px; margin-right: 8px; }
  .kj-pdp-label {
    margin: 0 0 2px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #8f00ff;
    white-space: nowrap;
  }

  /* The label shares a row group with the brand and rating. Let that row wrap
     and give the label the full first line, so it reads as an eyebrow above
     them instead of being squeezed in beside them. */
  .group-block-content:has(> div > .kj-pdp-label) {
    flex-wrap: wrap;
    row-gap: 4px;
  }

  .group-block-content > div:has(> .kj-pdp-label) {
    flex: 0 0 100%;
  }

  /* The review widget is a full-width block, so once the row can wrap it would
     drop under the brand. Let it share the brand's line and take what is left. */
  .group-block-content:has(> div > .kj-pdp-label) > .shopify-app-block {
    flex: 1 1 0;
    min-width: 0;
  }
{% endstylesheet %}
