{%- comment -%}
  Brand promo milestones for the cart (drawer + cart page).

  Each promo is "collection_handle|threshold|code|amount_off|label". Membership
  is checked by COLLECTION because that is what the discount targets, and the
  running total uses original_line_price because Shopify measures the minimum
  against the pre-discount subtotal (verified against /cart.js).

  Only one code applies per order (all promos are non-combinable), so when more
  than one is unlocked we name the highest-value one.
{%- endcomment -%}

{%- liquid
  assign promos = 'st-london|9999|stlondon2000|2000|ST London,kryolan|9999|kryolan1500|1500|Kryolan,janssen|14999|janssen1500|1500|Janssen' | split: ','
  assign promo_handles = '|st-london|kryolan|janssen|'

  # Applied codes, pipe-delimited so a probe cannot match a substring of a
  # longer discount title.
  assign applied = '|'
  for d in cart.discount_applications
    assign applied = applied | append: d.title | downcase | append: '|'
  endfor

  # One scan of the cart. Only promo collections are recorded, so `hits` stays
  # at most one short entry per line item instead of every collection a product
  # belongs to.
  assign hits = ''
  for item in cart.items
    for c in item.product.collections
      assign c_probe = '|' | append: c.handle | append: '|'
      if promo_handles contains c_probe
        assign hits = hits | append: c.handle | append: ':' | append: item.original_line_price | append: ';'
      endif
    endfor
  endfor
  assign hit_list = hits | split: ';'
-%}

{%- unless cart.empty? -%}
  {%- liquid
    # First pass: find the most valuable unlocked promo, so the "one code only"
    # note can name it.
    assign best_label = ''
    assign best_amount = 0
    assign won_count = 0
    for promo in promos
      assign p = promo | split: '|'
      assign total = 0
      for hit in hit_list
        assign hp = hit | split: ':'
        if hp[0] == p[0]
          assign total = total | plus: hp[1]
        endif
      endfor
      assign threshold = p[1] | times: 100
      if total >= threshold
        assign won_count = won_count | plus: 1
        assign amount = p[3] | times: 100
        if amount > best_amount
          assign best_amount = amount
          assign best_label = p[4]
        endif
      endif
    endfor
  -%}

  {%- capture rows -%}
    {%- for promo in promos -%}
      {%- assign p = promo | split: '|' -%}
      {%- assign handle = p[0] -%}
      {%- assign threshold = p[1] | times: 100 -%}
      {%- assign code = p[2] -%}
      {%- assign amount = p[3] | times: 100 -%}
      {%- assign label = p[4] -%}

      {%- assign brand_total = 0 -%}
      {%- for hit in hit_list -%}
        {%- assign hp = hit | split: ':' -%}
        {%- if hp[0] == handle -%}
          {%- assign brand_total = brand_total | plus: hp[1] -%}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Only surface a promo once its brand is actually in the cart. {%- endcomment -%}
      {%- if brand_total > 0 -%}
        {%- assign pct = brand_total | times: 100 | divided_by: threshold -%}
        {%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}
        {%- assign remaining = threshold | minus: brand_total -%}
        {%- assign code_probe = '|' | append: code | append: '|' -%}
        {%- assign is_applied = false -%}
        {%- if applied contains code_probe -%}{%- assign is_applied = true -%}{%- endif -%}

        <div class="kj-ms{% if remaining <= 0 %} kj-ms--won{% endif %}" data-kj-ms-code="{{ code }}">
          <div class="kj-ms__top">
            <span class="kj-ms__label">{{ label }}</span>
            {%- if remaining <= 0 -%}
              {%- if is_applied -%}
                <span class="kj-ms__state kj-ms__state--on">{{ amount | money }} off applied</span>
              {%- else -%}
                <button type="button" class="kj-ms__apply" data-kj-ms-apply="{{ code }}">Apply {{ amount | money }} off</button>
              {%- endif -%}
            {%- else -%}
              <span class="kj-ms__state">Save {{ amount | money }}</span>
            {%- endif -%}
          </div>
          <div class="kj-ms__bar"><span style="width: {{ pct }}%;"></span></div>
          <p class="kj-ms__note">
            {%- if remaining <= 0 -%}
              Unlocked — {{ amount | money }} off {{ label }}
            {%- else -%}
              Add {{ remaining | money }} more of {{ label }} to save {{ amount | money }}
            {%- endif -%}
          </p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if rows contains 'kj-ms' -%}
    <div class="kj-ms-wrap">
      {{ rows }}
      {%- if won_count > 1 -%}
        <p class="kj-ms__single">Only one promo code can be used per order — {{ best_label }} saves you the most ({{ best_amount | money }}).</p>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endunless -%}

<script>
  (function () {
    if (window.__kjMs) return;
    window.__kjMs = true;

    function reset() {
      document.querySelectorAll('[data-kj-ms-apply]').forEach(function (b) {
        if (!b.dataset.kjLabel) return;
        b.disabled = false;
        b.textContent = b.dataset.kjLabel;
      });
    }
    // Restore the button if the shopper comes back via bfcache/back button,
    // otherwise it stays stuck on "Applying…".
    window.addEventListener('pageshow', reset);

    document.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('[data-kj-ms-apply]');
      if (!b) return;
      e.preventDefault();
      b.dataset.kjLabel = b.textContent.trim();
      b.disabled = true;
      b.textContent = 'Applying…';
      // Shopify has no Ajax endpoint for discount codes; /discount/<code>
      // attaches it to the session and carries through to checkout.
      window.location.href = '/discount/' + encodeURIComponent(b.getAttribute('data-kj-ms-apply')) + '?redirect=/cart';
    });
  })();
</script>
