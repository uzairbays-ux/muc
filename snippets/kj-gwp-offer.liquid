{%- comment -%}
  Free-gift offer line for product cards and the product page.

  Shows on products that count toward an active gift slot
  (Theme settings > Gift with purchase): listed in the slot's "buys" products
  or in its "buys" collection. When a product qualifies for several slots,
  only the highest priority is shown, because that is the gift the cart will
  actually add (the discounts don't combine).

  Params:
    product - the product (defaults to closest.product)
    context - 'card' (compact) or 'pdp'
{%- endcomment -%}

{%- liquid
  assign go_p = product | default: closest.product
  assign go_ctx = context | default: 'card'
  assign go_best = 0
  assign go_best_pri = 0

  if go_p != blank
    for n in (1..2)
      assign k_on = 'kj_gwp' | append: n | append: '_enabled'
      unless settings[k_on]
        continue
      endunless
      assign k_gift = 'kj_gwp' | append: n | append: '_gift'
      assign k_prods = 'kj_gwp' | append: n | append: '_buy_products'
      assign k_coll = 'kj_gwp' | append: n | append: '_buy_collection'
      assign k_pri = 'kj_gwp' | append: n | append: '_priority'
      assign g = settings[k_gift]
      assign gv = g.selected_or_first_available_variant
      if g == blank or gv.available == false or g.id == go_p.id
        continue
      endif

      assign hit = false
      for bp in settings[k_prods]
        if bp.id == go_p.id
          assign hit = true
          break
        endif
      endfor
      assign bc = settings[k_coll]
      if hit == false and bc != blank
        for c in go_p.collections
          if c.handle == bc.handle
            assign hit = true
            break
          endif
        endfor
      endif

      assign pri = settings[k_pri] | default: 5
      if hit and pri > go_best_pri
        assign go_best = n
        assign go_best_pri = pri
      endif
    endfor
  endif
-%}

{%- if go_best > 0 -%}
  {%- liquid
    assign k_gift = 'kj_gwp' | append: go_best | append: '_gift'
    assign k_qty = 'kj_gwp' | append: go_best | append: '_qty'
    assign g = settings[k_gift]
    assign gv = g.selected_or_first_available_variant
    assign g_name = g.title | split: ' - ' | last | strip
    assign g_qty = settings[k_qty] | default: 2
    assign g_worth = gv.compare_at_price | default: gv.price
  -%}
  <div class="kj-gwpo kj-gwpo--{{ go_ctx }}">
    <svg class="kj-gwpo__icon" viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
      <rect x="3.5" y="9.5" width="17" height="11" rx="1.4" stroke="currentColor" stroke-width="1.6"></rect>
      <path d="M2.5 9.5h19V7.2a1 1 0 0 0-1-1h-17a1 1 0 0 0-1 1v2.3ZM12 6.2v14.3" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
      <path d="M12 6.2C10.6 3.4 7.3 3.4 7.3 5.1c0 1.1 2.3 1.1 4.7 1.1ZM12 6.2c1.4-2.8 4.7-2.8 4.7-1.1 0 1.1-2.3 1.1-4.7 1.1Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
    </svg>
    <span class="kj-gwpo__text">
      <strong>Buy {{ g_qty }}, get a FREE {{ g_name | escape }}</strong>
      {%- if go_ctx == 'pdp' %}
        <span class="kj-gwpo__sub">Worth {{ g_worth | money }}. Added to your bag automatically.</span>
      {%- else %}
        <span class="kj-gwpo__sub">Worth {{ g_worth | money_without_trailing_zeros }}</span>
      {%- endif -%}
    </span>
  </div>
{%- endif -%}

{% stylesheet %}
  .kj-gwpo {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin: 6px 0 2px;
    padding: 6px 8px;
    border-radius: 8px;
    background: #fdeef6;
    color: #e6007e;
    line-height: 1.3;
  }

  .kj-gwpo__icon {
    flex: 0 0 auto;
    margin-top: 1px;
  }

  .kj-gwpo__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    font-size: 11px;
  }

  .kj-gwpo__text strong {
    font-weight: 700;
  }

  .kj-gwpo__sub {
    color: rgba(0, 19, 37, 0.72);
    font-size: 10px;
  }

  .kj-gwpo--pdp {
    margin: 4px 0 0;
    padding: 10px 12px;
    border: 1px solid #f7c6e0;
  }

  .kj-gwpo--pdp .kj-gwpo__text {
    font-size: 14px;
  }

  .kj-gwpo--pdp .kj-gwpo__sub {
    font-size: 12px;
  }

  @media screen and (max-width: 749px) {
    .kj-gwpo--card .kj-gwpo__text {
      font-size: 10px;
    }

    .kj-gwpo--card .kj-gwpo__sub {
      font-size: 9px;
    }
  }
{% endstylesheet %}
