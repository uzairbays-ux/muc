{%- doc -%}
  "Notify me" form shown in place of Add to cart when a variant is sold out.

  Posts to Shopify's /contact endpoint twice (see assets/notify-me.js):
  a `customer` submission that creates the tagged customer record, and a
  `contact` submission that emails the merchant the full request including
  the phone number, which the customer form does not store.

  Without JS the form degrades to a plain `contact` post, so the merchant
  still receives every request.

  @param {object} product - The product being requested
  @param {object} variant - The currently selected (sold out) variant
  @param {object} settings - Block settings supplying labels and the tag prefix
{%- enddoc -%}

{%- liquid
  assign tag_prefix = settings.notify_tag_prefix | default: 'notify-me'

  # Commas separate tags in `contact[tags]`, so they must not survive in the
  # product title. Tags are also capped at 255 characters by Shopify.
  assign safe_title = product.title | strip_html | replace: ',', ' ' | strip | truncate: 180, ''
  assign notify_tags = tag_prefix | append: ', ' | append: tag_prefix | append: ': ' | append: safe_title

  assign form_id = 'NotifyMe-' | append: product.id
-%}

<notify-me-form
  class="notify-me"
  data-tags="{{ notify_tags | escape }}"
  data-product-title="{{ product.title | strip_html | escape }}"
  data-variant-title="{% if product.has_only_default_variant == false %}{{ variant.title | escape }}{% endif %}"
  data-product-url="{{ shop.url }}{{ product.url }}"
  data-success-text="{{ settings.notify_success_text | default: 'Thanks! We will email you when this is back in stock.' | escape }}"
  data-error-text="{{ settings.notify_error_text | default: 'Something went wrong. Please try again.' | escape }}"
>
  <details class="notify-me__disclosure">
    <summary class="notify-me__toggle button-secondary">
      {{ settings.notify_button_label | default: 'Notify me when available' }}
    </summary>

    <form
      action="/contact"
      method="post"
      accept-charset="UTF-8"
      class="notify-me__form"
      id="{{ form_id }}"
    >
      <input type="hidden" name="form_type" value="contact">
      <input type="hidden" name="utf8" value="✓">
      <input
        type="hidden"
        name="contact[body]"
        value="Back-in-stock request for {{ product.title | strip_html | escape }}{% if product.has_only_default_variant == false %} ({{ variant.title | escape }}){% endif %}"
      >

      <div class="notify-me__field">
        <label for="{{ form_id }}-name">
          {{ settings.notify_name_label | default: 'Name' }}
        </label>
        <input
          id="{{ form_id }}-name"
          type="text"
          name="contact[first_name]"
          autocomplete="name"
          required
        >
      </div>

      <div class="notify-me__field">
        <label for="{{ form_id }}-email">
          {{ settings.notify_email_label | default: 'Email' }}
        </label>
        <input
          id="{{ form_id }}-email"
          type="email"
          name="contact[email]"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
        >
      </div>

      <div class="notify-me__field">
        <label for="{{ form_id }}-phone">
          {{ settings.notify_phone_label | default: 'Phone number' }}
        </label>
        <input
          id="{{ form_id }}-phone"
          type="tel"
          name="contact[phone]"
          autocomplete="tel"
        >
      </div>

      <button type="submit" class="notify-me__submit button">
        {{ settings.notify_submit_label | default: 'Notify me' }}
      </button>
    </form>

    <p
      class="notify-me__status"
      data-notify-status
      role="status"
      aria-live="polite"
    ></p>
  </details>
</notify-me-form>
