{%- doc -%}
  11:11 sale countdown for the product page. Counts down to the start, then to
  the end, then hides itself. Links to the sale page.
{%- enddoc -%}
{%- render 'kj-sale-styles' -%}
{%- if block.settings.timer_end != blank -%}
<a class="kjs-pdp-timer" href="{{ block.settings.link | default: '/pages/sale' }}" style="--kjs-purple: {{ block.settings.purple }}; --kjs-lime: {{ block.settings.lime }}; --kjs-dark: {{ block.settings.dark }}; --kjs-red: {{ block.settings.red }};" {{ block.shopify_attributes }}>
  <span class="kjs-pdp-timer__title">{{ block.settings.title | escape }}</span>
  <span class="kjs-hero__timer kjs-pdp-timer__timer" data-kjs-timer="{{ block.settings.timer_end | escape }}" data-kjs-timer-start="{{ block.settings.timer_start | escape }}" data-label-start="{{ block.settings.label_start | escape }}" data-label-end="{{ block.settings.label_end | escape }}" hidden>
    <span class="kjs-hero__timer-label" data-kjs-t="label">{{ block.settings.label_end | escape }}</span>
    <span class="kjs-hero__timer-units">
      <span class="kjs-hero__timer-unit"><b data-kjs-t="h">00</b><small>HRS</small></span>
      <span class="kjs-hero__timer-sep">:</span>
      <span class="kjs-hero__timer-unit"><b data-kjs-t="m">00</b><small>MIN</small></span>
      <span class="kjs-hero__timer-sep">:</span>
      <span class="kjs-hero__timer-unit"><b data-kjs-t="s">00</b><small>SEC</small></span>
    </span>
  </span>
</a>
{%- endif -%}

{% schema %}
{
  "name": "11.11 sale timer",
  "tag": null,
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "11:11 FLASH SALE" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "timer_start", "label": "Starts at", "default": "2026-11-11T00:00:00+05:00", "info": "ISO date in Pakistan time." },
    { "type": "text", "id": "timer_end", "label": "Ends at", "default": "2026-11-11T23:59:59+05:00", "info": "The block hides itself once this time has passed." },
    { "type": "text", "id": "label_start", "label": "Label before the sale starts", "default": "STARTS IN" },
    { "type": "text", "id": "label_end", "label": "Label while the sale is on", "default": "ENDS IN" },
    { "type": "color", "id": "purple", "label": "Purple", "default": "#A98BCB" },
    { "type": "color", "id": "lime", "label": "Lime", "default": "#D9F25B" },
    { "type": "color", "id": "dark", "label": "Dark", "default": "#1E1E1E" },
    { "type": "color", "id": "red", "label": "Button red", "default": "#D32F2F" }
  ],
  "presets": [{ "name": "11.11 sale timer" }]
}
{% endschema %}
