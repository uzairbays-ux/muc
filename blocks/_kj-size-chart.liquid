{%- doc -%}
  One size chart and the condition for showing it. Child of the Size guide block.

  Matches when the product has one of the listed tags (whole tag, case ignored)
  or its title contains one of the listed phrases (case ignored). Outputs the
  chart behind a marker; the Size guide block keeps the first matching chart
  and builds the link and popup around it. Renders nothing when it does not
  match.

  The chart is the table when one is filled in (sharp on phones, nothing to
  upload), else the image.
{%- enddoc -%}

{%- liquid
  assign sc_product = closest.product
  assign sc_image = block.settings.image
  assign sc_table = block.settings.table
  assign sc_matches = false
  assign sc_has_chart = false
  if sc_image != blank or sc_table != blank
    assign sc_has_chart = true
  endif

  if sc_product != blank and sc_has_chart
    # contains on an array is case sensitive, so lower-case both sides.
    assign sc_product_tags = sc_product.tags | join: ',' | downcase | split: ','
    assign sc_product_title = sc_product.title | downcase

    assign sc_chart_tags = block.settings.tags | downcase | split: ','
    for sc_chart_tag in sc_chart_tags
      assign sc_needle = sc_chart_tag | strip
      # An empty string is "contained" in everything, so skip empty entries.
      if sc_needle != '' and sc_product_tags contains sc_needle
        assign sc_matches = true
        break
      endif
    endfor

    unless sc_matches
      assign sc_phrases = block.settings.title_contains | downcase | split: ','
      for sc_phrase in sc_phrases
        assign sc_needle = sc_phrase | strip
        if sc_needle != '' and sc_product_title contains sc_needle
          assign sc_matches = true
          break
        endif
      endfor
    endunless
  endif
-%}

{%- if sc_matches -%}
  {%- comment -%} The Size guide block splits on this marker and keeps the first match. {%- endcomment -%}
  <!--kj-size-chart-->
  {%- if block.settings.show_sister_size -%}<!--kj-sister-->{%- endif -%}
  <div class="kj-sg__chart" {{ block.shopify_attributes }}>
    {%- if sc_table != blank -%}
      {{ sc_table }}
    {%- else -%}
      {{
        sc_image
        | image_url: width: 1600
        | image_tag:
          loading: 'lazy',
          widths: '480, 750, 1100, 1600',
          sizes: '(min-width: 750px) 680px, 92vw',
          class: 'kj-sg__image',
          alt: sc_image.alt | default: block.settings.title
      }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Size chart",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Name (only shown in the editor)"
    },
    {
      "type": "html",
      "id": "table",
      "label": "Chart as a table",
      "info": "Shown instead of the image when filled. Sharper on phones."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Chart image",
      "info": "Used when no table is filled in."
    },
    {
      "type": "text",
      "id": "tags",
      "label": "Product tags",
      "info": "Comma separated, case ignored. Any one is enough."
    },
    {
      "type": "text",
      "id": "title_contains",
      "label": "Or title contains",
      "info": "Comma separated phrases, case ignored."
    },
    {
      "type": "checkbox",
      "id": "show_sister_size",
      "label": "Show the Sister Size link",
      "default": false
    }
  ],
  "presets": [{ "name": "Size chart" }]
}
{% endschema %}
