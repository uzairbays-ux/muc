

{%- liquid
  assign block_settings = block.settings
  assign product_has_swatches = false
  assign variant_option = nil
  assign shade_option = nil

  for product_option in closest.product.options_with_values
    assign swatch_count = product_option.values | map: 'swatch' | compact | size
    assign option_name_lower = product_option.name | downcase
    assign is_color_name = false
    if option_name_lower == 'color' or option_name_lower == 'colour' or option_name_lower == 'shade' or option_name_lower == 'shades'
      assign is_color_name = true
    endif
    # Treat name-based color options as swatch options so cards use the real swatch
    # renderer (colors come from theme swatch_color_definitions), not the text-pill fallback.
    if swatch_count > 0 or is_color_name
      assign product_has_swatches = true
    endif
    # Capture the shade/colour option so cards can show a "N Shades" count.
    if is_color_name and shade_option == nil
      assign shade_option = product_option
    endif
    if variant_option == nil and product_option.values.size > 1
      if is_color_name or option_name_lower == 'size'
        assign variant_option = product_option
      endif
    endif
  endfor

  assign shade_count = 0
  if shade_option != nil
    assign shade_count = shade_option.values.size
  endif
-%}

{% stylesheet %}
  product-swatches {
    width: 100%;
    display: flex;
    position: relative;
    overflow: hidden;
    gap: 0;
    flex-shrink: 0;
  }

  .variant-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    padding: {{ block_settings.product_swatches_padding_top }}px {{ block_settings.product_swatches_padding_right }}px {{ block_settings.product_swatches_padding_bottom }}px {{ block_settings.product_swatches_padding_left }}px;
  }

  .variant-pill {
    display: inline-block;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 500;
    border: 1px solid rgba(0,0,0,0.2);
    border-radius: 4px;
    color: rgba(0,0,0,0.75);
    text-decoration: none;
    white-space: nowrap;
    line-height: 1.4;
    transition: border-color 0.15s, background 0.15s;
  }

  .variant-pill:hover {
    border-color: rgba(0,0,0,0.6);
    background: rgba(0,0,0,0.04);
  }

  .variant-pill--unavailable {
    opacity: 0.4;
    text-decoration: line-through;
  }

  .variant-pill--more {
    background: none;
    border: none;
    color: rgba(0,0,0,0.5);
    font-size: 11px;
    font-weight: 600;
    padding: 0 2px;
    display: flex;
    align-items: center;
  }

  .variant-pill--image {
    padding: 0;
    border-radius: var(--variant-picker-swatch-radius, 4px);
    overflow: hidden;
    width: 28px;
    height: 28px;
    border: 1px solid rgba(0,0,0,0.15);
  }

  .variant-pill--image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (min-width: 750px) {
    .variant-pill--image {
      width: 32px;
      height: 32px;
    }
  }

  /* "N Shades" count label — replaces the swatch row on cards. */
  .kj-shades {
    display: flex;
    align-items: center;
    gap: 5px;
    margin: 6px 0;
    padding: 0;
    font-size: 12px;
    font-weight: 400;
    line-height: 16px;
    letter-spacing: 0;
    color: #001325;
    text-transform: capitalize;
    text-decoration: none;
    width: fit-content;
  }

  .kj-shades__icon {
    height: 12px;
    width: auto;
    flex-shrink: 0;
    display: block;
  }
{% endstylesheet %}

{%- liquid
  assign use_variant_images = false
  assign variant_option_name_lower = variant_option.name | downcase
  if settings.show_variant_image and variant_option != nil and variant_option_name_lower != 'size'
    for value in variant_option.values
      if value.variant.featured_media
        assign use_variant_images = true
        break
      endif
    endfor
  endif
-%}

{% if shade_option != nil and shade_count > 0 %}
  <a
    class="kj-shades"
    href="{{ closest.product.url }}"
    aria-label="{{ shade_count }} shades"
    {{ block.shopify_attributes }}
  >
    <svg class="kj-shades__icon" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="6" cy="6" r="5.5" fill="#E9B79E"></circle>
      <circle cx="10" cy="6" r="5.5" fill="#C88A6A"></circle>
      <circle cx="14" cy="6" r="5.5" fill="#8B4A38"></circle>
    </svg>
    {{ shade_count }} {% if shade_count == 1 %}Shade{% else %}Shades{% endif %}
  </a>
{% elsif product_has_swatches or use_variant_images %}
  <product-swatches
    data-product-id="{{ closest.product.id }}"
    data-product-url="{{ closest.product.url }}"
    style="
      --overflow-list-alignment: {{ block_settings.product_swatches_alignment }};
      --overflow-list-alignment-mobile: {{ block_settings.product_swatches_alignment_mobile }};
      --product-swatches-alignment: {% if block_settings.product_swatches_alignment == 'flex-start' %}start{% elsif block_settings.product_swatches_alignment == 'flex-end' %}end{% else %}center{% endif %};
      --product-swatches-alignment-mobile: {% if block_settings.product_swatches_alignment_mobile == 'flex-start' %}start{% elsif block_settings.product_swatches_alignment_mobile == 'flex-end' %}end{% else %}center{% endif %};
      --product-swatches-padding-block-start: {{ block_settings.product_swatches_padding_top }}px;
      --product-swatches-padding-block-end: {{ block_settings.product_swatches_padding_bottom }}px;
      --product-swatches-padding-inline-start: {{ block_settings.product_swatches_padding_left }}px;
      --product-swatches-padding-inline-end: {{ block_settings.product_swatches_padding_right }}px;
    "
    {{ block.shopify_attributes }}
  >
    {%- if product_has_swatches -%}
      {% render 'variant-swatches', product_resource: closest.product %}
    {%- else -%}
      {%- assign max_shown = 4 -%}
      {%- assign total_values = variant_option.values.size -%}
      {%- assign hidden_count = total_values | minus: max_shown -%}
      <div class="variant-pills">
        {%- for value in variant_option.values limit: max_shown -%}
          {%- assign v_media = value.variant.featured_media -%}
          <a
            href="{{ closest.product.url }}?variant={{ value.variant.id }}"
            class="variant-pill variant-pill--image{% unless value.available %} variant-pill--unavailable{% endunless %}"
            aria-label="{{ variant_option.name }}: {{ value.name }}"
            title="{{ value.name }}"
          >
            <img
              src="{{ v_media | image_url: width: 72 }}"
              alt="{{ value.name }}"
              width="36"
              height="36"
              loading="lazy"
            >
          </a>
        {%- endfor -%}
        {%- if hidden_count > 0 -%}
          <a href="{{ closest.product.url }}" class="variant-pill variant-pill--more" aria-label="{{ hidden_count | plus: max_shown }} variants">+{{ hidden_count }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </product-swatches>
{% elsif variant_option != nil %}
  {%- assign max_shown = 4 -%}
  {%- assign total_values = variant_option.values.size -%}
  {%- assign hidden_count = total_values | minus: max_shown -%}
  <div class="variant-pills" {{ block.shopify_attributes }}>
    {%- for value in variant_option.values limit: max_shown -%}
      <a
        href="{{ closest.product.url }}?variant={{ value.variant.id }}"
        class="variant-pill{% unless value.available %} variant-pill--unavailable{% endunless %}"
        aria-label="{{ variant_option.name }}: {{ value.name }}"
      >
        {{- value.name -}}
      </a>
    {%- endfor -%}
    {%- if hidden_count > 0 -%}
      <a href="{{ closest.product.url }}" class="variant-pill variant-pill--more" aria-label="{{ total_values }} variants">+{{ hidden_count }}</a>
    {%- endif -%}
  </div>
{% endif %}

{% schema %}
{
  "name": "t:names.swatches",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_swatches"
    },
    {
      "type": "select",
      "id": "product_swatches_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "product_swatches_alignment_mobile",
      "label": "t:settings.alignment_mobile",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "t:content.padding",
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "checkbox",
      "id": "hide_padding",
      "label": "t:settings.hide_padding",
      "default": false,
      "visible_if": "{{ false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_top",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 4,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_bottom",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_left",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_right",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.swatches",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
{% # theme-check-enable %}
