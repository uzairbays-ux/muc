{%- doc -%}
  "Notify me" trigger for out-of-stock products.

  Renders a button that opens a dialog containing whatever blocks the merchant
  nests inside it — intended to hold the Shopify Forms app block, which handles
  the customer record, validation and submissions itself.

  By default the block renders nothing while the variant is in stock. It always
  renders in the theme editor so the nested form stays reachable for editing.
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant

  # Deliberately just `available`, matching the "Sold out" button. Also gating
  # on inventory_management/inventory_policy added two more ways for the block
  # to render nothing at all, which takes the nested form down with it.
  # Keep each condition on one line -- in a liquid tag every newline starts a
  # new statement, so a condition split across lines silently breaks. Never
  # write tag delimiters in these comments either: the closing brace ends the
  # enclosing liquid tag right there.
  assign is_sold_out = false
  if variant.available == false
    assign is_sold_out = true
  endif

  assign should_render = is_sold_out
  if block_settings.only_when_sold_out == false
    assign should_render = true
  endif
  if request.design_mode
    assign should_render = true
  endif

  # [product] and [variant] are substituted into the labels so the button and
  # dialog name the item the shopper is actually waiting on.
  assign product_title = product.title | strip_html
  assign variant_title = ''
  if product.has_only_default_variant == false
    assign variant_title = variant.title
  endif

  assign button_label = block_settings.button_label | default: 'Notify me when available'
  assign button_label = button_label | replace: '[product]', product_title | replace: '[variant]', variant_title

  assign heading_text = block_settings.heading | default: 'Notify me when available'
  assign heading_text = heading_text | replace: '[product]', product_title | replace: '[variant]', variant_title

  assign subheading_text = block_settings.subheading
  assign subheading_text = subheading_text | replace: '[product]', product_title | replace: '[variant]', variant_title

  assign form_id = 'NotifyMe-' | append: block.id

  # Captured, not passed directly: handing product.url to return_to renders the
  # drop itself ("BasicUrlDrop") instead of the path.
  capture return_path
    echo product.url
  endcapture

  # Commas separate tags, so they must not survive in the product name.
  assign tag_prefix = block_settings.tag_prefix | default: 'notify-me'
  assign safe_title = product_title | replace: ',', ' ' | strip | truncate: 180, ''

  # Three tags, each with a job:
  #   notify-me                 -- every signup, for a catch-all segment
  #   notify-me: <Title>        -- human readable in the admin
  #   notify-me-<handle>        -- what segments should match on. The title
  #                                version contains spaces and apostrophes that
  #                                are awkward to quote in a segment query, and
  #                                it breaks silently if the title is edited.
  assign handle_tag = tag_prefix | append: '-' | append: product.handle
  assign notify_tags = tag_prefix | append: ', ' | append: tag_prefix | append: ': ' | append: safe_title | append: ', ' | append: handle_tag
-%}

{%- if should_render -%}
  <script
    src="{{ 'dialog.js' | asset_url }}"
    type="module"
  ></script>

  {%- comment -%}
    contact[phone] is not a documented field for the customer form, so it may
    not persist. Mirror the number into a tag on submit as well -- tags are
    stored reliably. This runs before a NATIVE submit, so Shopify's spam
    protection still sees a genuine form submission.
  {%- endcomment -%}
  <script>
    document.addEventListener('submit', (event) => {
      const form = event.target.closest('.notify-me__form');
      if (!form) return;

      const tags = form.querySelector('[data-notify-tags]');
      const phone = form.querySelector('[data-notify-phone]');
      if (!tags || !phone) return;

      const number = phone.value.trim().replace(/,/g, ' ');
      if (number) tags.value = `${tags.value}, phone: ${number}`;
    });

    /**
     * Shopify redirects back with the dialog closed, so the confirmation would
     * never be seen. showDialog() belongs to the theme's DialogComponent and is
     * only there once the custom element upgrades, which can land after this
     * runs -- previously the optional call silently did nothing and no message
     * ever appeared. Fall back to the native showModal().
     */
    function openNotifyDialog(block, attempt = 0) {
      const dialog = block.querySelector('dialog.notify-me__content');
      if (!dialog || dialog.hasAttribute('open')) return;

      if (typeof block.showDialog === 'function') {
        block.showDialog();
      } else if (attempt < 20) {
        // Custom element not upgraded yet; check again next frame.
        requestAnimationFrame(() => openNotifyDialog(block, attempt + 1));
        return;
      }

      // showDialog() defers a frame, so confirm it actually opened.
      setTimeout(() => {
        if (!dialog.hasAttribute('open')) {
          try {
            dialog.showModal();
          } catch (error) {
            dialog.setAttribute('open', '');
          }
        }
      }, 150);
    }

    function markNotified(block) {
      const label = block.dataset.notifyNotifiedLabel;
      const button = block.querySelector('.notify-me__button');
      if (label && button) button.textContent = label;
    }

    if (!window.__notifyMeInit) {
      window.__notifyMeInit = true;

      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.notify-me').forEach((block) => {
          const key = block.dataset.notifyKey;
          const succeeded = !!block.querySelector('.notify-me__status--success');

          if (succeeded) {
            // "Leave your details..." is wrong once they already have
            block.querySelector('.notify-me__subheading')?.remove();
            openNotifyDialog(block);
            try {
              if (key) localStorage.setItem(key, '1');
            } catch (error) {
              /* private mode */
            }
          }

          let remembered = false;
          try {
            remembered = key ? localStorage.getItem(key) === '1' : false;
          } catch (error) {
            /* private mode */
          }

          if (succeeded || remembered) markNotified(block);
        });
      });
    }
  </script>

  {%- comment -%}
    spacing-style belongs on the wrapper, not the button: it sets
    --padding-block-start and friends to 0, which flattens the button's own
    --button-padding-block and leaves it looking unstyled.
  {%- endcomment -%}
  <dialog-component
    class="notify-me spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    data-notify-key="notify-me:{{ product.id }}"
    data-notify-notified-label="{{ block_settings.notified_label | default: "You'll be notified" | escape }}"
    {{ block.shopify_attributes }}
  >
    <button
      on:click="/showDialog"
      class="notify-me__button {{ block_settings.style_class | default: 'button-secondary' }}"
    >
      {{ button_label }}
    </button>

    <dialog
      ref="dialog"
      class="notify-me__content dialog-modal color-{{ settings.popover_color_scheme }}{% if block_settings.behavior == 'drawer' %} notify-me__content--drawer dialog-drawer{% endif %}"
      scroll-lock
      aria-labelledby="notify-me-heading-{{ block.id }}"
    >
      <h2
        id="notify-me-heading-{{ block.id }}"
        class="notify-me__heading{% if block_settings.heading == blank %} visually-hidden{% endif %}"
      >
        {{ heading_text }}
      </h2>

      {%- if subheading_text != blank -%}
        <p class="notify-me__subheading">{{ subheading_text }}</p>
      {%- endif -%}

      <div class="notify-me__inner">
        {%- if block_settings.form_source == 'app_block' -%}
          {% content_for 'blocks' %}
        {%- else -%}
          {%- comment -%}
            A native submit, not fetch: Shopify's invisible spam protection on
            /contact rejects programmatic posts, which is what made the earlier
            AJAX version fail. The customer form is the only one that writes
            tags, and the tag is what a restock segment is built from.
          {%- endcomment -%}
          {%- comment -%}
            An explicit id is required. Without one Shopify names every
            customer form `contact_form`, colliding with the footer email
            signup: the post-submit redirect appends #contact_form and jumps
            to the footer, and form.posted_successfully? fires on both forms.
          {%- endcomment -%}
          {%- comment -%}
            return_to is required, otherwise the customer form uses its default
            redirect and dumps the shopper on the home page. An explicit
            relative path is used rather than 'back', which depends on the
            referer -- unreliable behind the preview proxy.
          {%- endcomment -%}
          {%- form 'customer', id: form_id, return_to: return_path, class: 'notify-me__form' -%}
            {%- if form.posted_successfully? -%}
              {%- comment -%}
                Replace the fields entirely rather than leaving an empty form
                under a line of text -- the shopper is done here.
              {%- endcomment -%}
              <div class="notify-me__success notify-me__status--success" role="status">
                <span class="notify-me__success-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" opacity="0.25"></circle>
                    <path d="M7 12.5l3.2 3.2L17 9" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
                <p class="notify-me__success-text">
                  {{ block_settings.success_text | default: "Thanks! We'll email you when it's back in stock." }}
                </p>
                <button
                  type="button"
                  class="notify-me__success-close {{ block_settings.style_class | default: 'button-secondary' }}"
                  on:click="/closeDialog"
                >
                  {{ block_settings.success_close_label | default: 'Continue shopping' }}
                </button>
              </div>
            {%- else -%}
              {{ form.errors | default_errors }}
            {%- endif -%}

            {%- unless form.posted_successfully? -%}
            <input type="hidden" name="contact[tags]" value="{{ notify_tags | escape }}" data-notify-tags>

            <div class="notify-me__field">
              <label for="{{ form_id }}-name">{{ block_settings.name_label | default: 'Name' }}</label>
              <input id="{{ form_id }}-name" type="text" name="contact[first_name]" autocomplete="name" required>
            </div>

            <div class="notify-me__field">
              <label for="{{ form_id }}-email">{{ block_settings.email_label | default: 'Email' }}</label>
              <input
                id="{{ form_id }}-email"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
              >
            </div>

            <div class="notify-me__field">
              <label for="{{ form_id }}-phone">{{ block_settings.phone_label | default: 'Phone number' }}</label>
              <input id="{{ form_id }}-phone" type="tel" name="contact[phone]" autocomplete="tel" data-notify-phone>
            </div>

            <button type="submit" class="notify-me__submit button">
              {{ block_settings.submit_label | default: 'Notify me' }}
            </button>
            {%- endunless -%}
          {%- endform -%}
        {%- endif -%}
      </div>

      <button
        ref="closeButton"
        on:click="/closeDialog"
        class="button button-unstyled close-button notify-me__close"
        aria-label="{{ 'accessibility.close_dialog' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </dialog>
  </dialog-component>
{%- endif -%}

{% stylesheet %}
  .notify-me {
    display: block;
  }

  .notify-me__button {
    width: 100%;
    cursor: pointer;
  }

  .notify-me__content {
    box-shadow: var(--shadow-popover);
    border: var(--style-border-popover);
    border-radius: var(--style-border-radius-popover);
    background-color: var(--color-background);
    padding: var(--padding-4xl) var(--padding-xl) var(--padding-xl);
    max-width: var(--normal-content-width);
    max-height: var(--modal-max-height);
    /* A long product name in the heading can outgrow the viewport, which
       clipped the top of the dialog. Scroll the content instead. */
    overflow-y: auto;
    overscroll-behavior: contain;

    @media screen and (min-width: 750px) {
      padding: var(--padding-5xl);
    }
  }

  /* Product names are long, so keep the heading from dominating the dialog */
  .notify-me__heading {
    font-size: 1.25rem;
    line-height: 1.25;
    margin-block-end: var(--margin-xs);
  }

  .notify-me__content[open] {
    animation: modalSlideInTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .notify-me__content.dialog-closing {
    animation: modalSlideOutTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .notify-me__content--drawer {
    position: fixed;
    border-radius: 0;
    width: var(--sidebar-width);
    max-width: 95vw;
    height: 100%;
    margin: 0 0 0 auto;
  }

  /* Needed to ensure the drawer is full height */
  .notify-me__content--drawer:modal {
    max-height: 100dvh;
  }

  .notify-me__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 12px);
  }

  .notify-me__field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .notify-me__field label {
    font-size: 0.8125rem;
  }

  .notify-me__field input {
    width: 100%;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-input-border, currentcolor);
    border-radius: var(--style-border-radius-inputs, 4px);
    color: inherit;
    font: inherit;
    /* iOS Safari zooms the whole page when focusing an input under 16px,
       which knocks the modal out of alignment and cannot be undone by the
       shopper. 16px is the threshold, so never go below it on small screens. */
    font-size: max(16px, 1rem);
  }

  @media screen and (max-width: 749px) {
    .notify-me__content {
      /* Full-height sheet: the modal was a floating box with the page dimmed
         behind it, which reads as broken on a narrow screen. */
      width: 100%;
      max-width: 100%;
      max-height: 92dvh;
      margin-block-end: 0;
      border-end-start-radius: 0;
      border-end-end-radius: 0;
    }

    .notify-me__heading {
      font-size: 1.125rem;
    }
  }

  .notify-me__submit {
    width: 100%;
    margin-block-start: 4px;
  }

  .notify-me__status--success {
    margin-block-end: var(--margin-sm, 12px);
  }

  .notify-me__success {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--gap-sm, 12px);
    padding-block: var(--padding-md, 16px);
  }

  .notify-me__success-icon svg {
    width: 48px;
    height: 48px;
  }

  .notify-me__success-text {
    margin: 0;
    font-size: 1rem;
  }

  .notify-me__success-close {
    width: 100%;
    cursor: pointer;
  }

  .notify-me__subheading {
    margin-block: var(--margin-xs) var(--margin-md);
    opacity: 0.75;
  }

  .notify-me__close {
    top: var(--margin-2xs);
    right: var(--margin-2xs);
    opacity: 0.8;
    animation: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Notify me",
  "tag": null,
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "form_source",
      "label": "Form",
      "info": "The built-in form tags the customer per product, which is what a restock segment is built from. The Shopify Forms block cannot do that.",
      "options": [
        {
          "value": "theme",
          "label": "Built-in form (tags the customer)"
        },
        {
          "value": "app_block",
          "label": "Shopify Forms block added inside"
        }
      ],
      "default": "theme"
    },
    {
      "type": "text",
      "id": "tag_prefix",
      "label": "Customer tag prefix",
      "info": "Creates 'notify-me' and 'notify-me: Product name'. Build your restock segment on the second one.",
      "default": "notify-me"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name field label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email field label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone field label",
      "default": "Phone number"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thanks! We'll email you when it's back in stock."
    },
    {
      "type": "text",
      "id": "success_close_label",
      "label": "Success button label",
      "default": "Continue shopping"
    },
    {
      "type": "text",
      "id": "notified_label",
      "label": "Button label after signing up",
      "info": "Replaces the trigger button once this shopper has signed up for this product. Remembered in their browser.",
      "default": "You'll be notified"
    },
    {
      "type": "checkbox",
      "id": "only_when_sold_out",
      "label": "Only show when sold out",
      "info": "Applies to variants that track inventory and stop selling when out of stock. Always visible in the theme editor.",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Use [product] for the product name and [variant] for the variant name.",
      "default": "Notify me when available"
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "Button style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        }
      ],
      "default": "button-secondary"
    },
    {
      "type": "select",
      "id": "behavior",
      "label": "t:settings.behavior",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "drawer",
          "label": "t:options.drawer"
        }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Popup heading",
      "info": "Use [product] for the product name and [variant] for the variant name.",
      "default": "Notify me when [product] is back"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Popup subheading",
      "info": "Use [product] for the product name and [variant] for the variant name.",
      "default": "Leave your details and we'll email you as soon as [product] is back in stock."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Notify me",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
