{%- render 'kj-sale-styles' -%}
{%- comment -%} Heavy weights used by the sale sections: load real 800/900 cuts and preload them so text does not jump from faux-bold. {%- endcomment -%}
{%- assign kjs_f8 = settings.type_body_font | font_modify: 'weight', '800' -%}
{%- assign kjs_f9 = settings.type_body_font | font_modify: 'weight', '900' -%}
{%- if kjs_f9 -%}<link rel="preload" as="font" href="{{ kjs_f9 | font_url }}" type="font/woff2" crossorigin>{%- endif -%}
{%- if kjs_f8 -%}<link rel="preload" as="font" href="{{ kjs_f8 | font_url }}" type="font/woff2" crossorigin>{%- endif -%}
<style>{%- if kjs_f8 -%}{{ kjs_f8 | font_face: font_display: 'swap' }}{%- endif -%}{%- if kjs_f9 -%}{{ kjs_f9 | font_face: font_display: 'swap' }}{%- endif -%}</style>
{%- if section.settings.page_bg != blank and section.settings.page_bg != 'rgba(0,0,0,0)' -%}<style>body { background: {{ section.settings.page_bg }}; }</style>{%- endif -%}
<div class="kjs kjs--{{ section.settings.section_width }}" style="--kjs-purple: {{ section.settings.purple }}; --kjs-lime: {{ section.settings.lime }}; --kjs-dark: {{ section.settings.dark }}; --kjs-red: {{ section.settings.red }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
        {%- if section.settings.bg_image != blank -%}{%- assign kjs_pat = section.settings.bg_image | image_url: width: 2400 -%}{%- endif -%}
{%- assign hero_tag = 'div' -%}{%- if section.settings.link != blank -%}{%- assign hero_tag = 'a' -%}{%- endif -%}
<{{ hero_tag }} class="kjs-hero{% if section.settings.pattern %} kjs-hero--pattern{% endif %}{% if kjs_pat %} kjs-hero--image{% endif %}{% if section.settings.animate %} kjs-hero--anim{% endif %}{% if section.settings.confetti %} kjs-hero--confetti{% endif %}"{% if hero_tag == 'a' %} href="{{ section.settings.link }}"{% endif %}{% if kjs_pat %} style="--kjs-hero-pattern: url('{{ kjs_pat }}');"{% endif %}>
          <div class="kjs-hero__left">
            <span class="kjs-hero__title">{{ section.settings.title | escape }} <span>{{ section.settings.title2 | escape }}</span></span>
            <span class="kjs-hero__tag">{{ section.settings.tag | escape }}</span>
            {%- if section.settings.note != blank -%}<span class="kjs-hero__note">{{ section.settings.note | escape }}</span>{%- endif -%}
            {%- if section.settings.timer_end != blank -%}
              <div class="kjs-hero__timer" data-kjs-timer="{{ section.settings.timer_end | escape }}" hidden>
                <span class="kjs-hero__timer-label">{{ section.settings.timer_label | escape }}</span>
                <span class="kjs-hero__timer-units">
                  <span class="kjs-hero__timer-unit"><b data-kjs-t="h">00</b><small>HRS</small></span>
                  <span class="kjs-hero__timer-sep">:</span>
                  <span class="kjs-hero__timer-unit"><b data-kjs-t="m">00</b><small>MIN</small></span>
                  <span class="kjs-hero__timer-sep">:</span>
                  <span class="kjs-hero__timer-unit"><b data-kjs-t="s">00</b><small>SEC</small></span>
                </span>
              </div>
            {%- endif -%}
          </div>
          <div class="kjs-hero__right">
            <span class="kjs-hero__upto">{{ section.settings.upto | escape }}</span>
            <span class="kjs-hero__pct">{{ section.settings.pct | escape }}</span>
            <span class="kjs-hero__off">{{ section.settings.off | escape }}</span>
          </div>
        </{{ hero_tag }}>

      
</div>

{% schema %}
{
  "name": "11.11 hero",
  "tag": "section",
  "class": "kj-sale-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "11:11" },
    { "type": "text", "id": "title2", "label": "Title word", "default": "SALE" },
    { "type": "text", "id": "tag", "label": "Tag line", "default": "BIGGEST SALE OF THE YEAR" },
    { "type": "text", "id": "upto", "label": "Up to", "default": "UP TO" },
    { "type": "text", "id": "pct", "label": "Percent", "default": "50%" },
    { "type": "text", "id": "off", "label": "Off", "default": "OFF" },
    { "type": "url", "id": "link", "label": "Link (leave empty for a non-clickable banner)" },
    { "type": "checkbox", "id": "pattern", "label": "Drifting 11:11 pattern behind", "default": true },
    { "type": "checkbox", "id": "animate", "label": "Animate the text in", "default": true },
    { "type": "checkbox", "id": "confetti", "label": "Confetti on page load (once per visit)", "default": true },
    { "type": "image_picker", "id": "bg_image", "label": "Pattern image (optional, replaces the built-in 11:11 pattern)" },
    { "type": "text", "id": "note", "label": "Small note under the tag line", "default": "FREE SHIPPING ON ORDERS OVER RS. 2,999" },
    { "type": "header", "content": "Countdown" },
    { "type": "text", "id": "timer_end", "label": "Ends at (ISO date, Pakistan time)", "default": "2026-11-11T23:59:59+05:00", "info": "Example: 2026-11-11T23:59:59+05:00 ends at midnight at the end of 11 Nov. Clear to remove the timer. It hides itself once the time has passed." },
    { "type": "text", "id": "timer_label", "label": "Timer label", "default": "SALE ENDS IN" },
    { "type": "color", "id": "page_bg", "label": "Page background (whole page)", "default": "#F6F2FB" },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full-width", "options": [ { "value": "full-width", "label": "Full width" }, { "value": "page-width", "label": "Page width" } ] },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "color", "id": "purple", "label": "Purple", "default": "#A98BCB" },
    { "type": "color", "id": "lime", "label": "Lime", "default": "#D9F25B" },
    { "type": "color", "id": "dark", "label": "Dark", "default": "#1E1E1E" },
    { "type": "color", "id": "red", "label": "Button red", "default": "#D32F2F" }
  ],
  "presets": [{ "name": "11.11 hero" }]
}
{% endschema %}
