{%- render 'kj-sale-styles' -%}
<div class="kjs kjs--{{ section.settings.section_width }}" style="--kjs-purple: {{ section.settings.purple }}; --kjs-lime: {{ section.settings.lime }}; --kjs-dark: {{ section.settings.dark }}; --kjs-red: {{ section.settings.red }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
        <section class="kjs-sec" >
          <div class="kjs-bar">
            <h3 class="kjs-bar__title">{{ section.settings.heading | escape }}{%- if section.settings.sub != blank -%} <span>· {{ section.settings.sub | escape }}</span>{%- endif -%}</h3>
            {%- if section.settings.link_label != blank -%}<a class="kjs-bar__link" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
          </div>
          <div class="kjs-carousel">
            <button type="button" class="kjs-carousel__btn kjs-carousel__btn--prev" data-kjs-prev aria-label="Previous products"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"></path></svg></button>
            <div class="kjs-grid" data-kjs-track>
            {%- liquid
              assign picked = section.settings.products
              assign shown = 0
              assign seen = ''
              assign lim = section.settings.limit
            -%}
            {%- for product in picked limit: lim -%}
              {%- assign seen = seen | append: '|' | append: product.handle -%}
              {%- assign shown = shown | plus: 1 -%}
              {%- render 'kj-sale-card', product: product, badge: section.settings.badge -%}
            {%- endfor -%}
            {%- if shown < lim and section.settings.collection != blank -%}
              {%- for product in section.settings.collection.products limit: 48 -%}
                {%- if shown >= lim -%}{%- break -%}{%- endif -%}
                {%- assign key = '|' | append: product.handle -%}
                {%- if seen contains key or product.available == false -%}{%- continue -%}{%- endif -%}
                {%- assign seen = seen | append: key -%}
                {%- assign shown = shown | plus: 1 -%}
                {%- render 'kj-sale-card', product: product, badge: section.settings.badge -%}
              {%- endfor -%}
            {%- endif -%}
            {%- if section.settings.link != blank -%}
              <a class="kjs-card kjs-card--more" href="{{ section.settings.link }}">
                <span class="kjs-card--more__inner">
                  <span class="kjs-card--more__title">{{ section.settings.more_label | default: 'Shop all' | escape }}</span>
                  <span class="kjs-card--more__sub">{{ section.settings.heading | escape }}</span>
                  <span class="kjs-card--more__arrow">→</span>
                </span>
              </a>
            {%- endif -%}
            </div>
            <button type="button" class="kjs-carousel__btn kjs-carousel__btn--next" data-kjs-next aria-label="Next products"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"></path></svg></button>
          </div>
        </section>

      
</div>

{% schema %}
{
  "name": "11.11 product row",
  "tag": "section",
  "class": "kj-sale-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "sub", "label": "Sub text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all →" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "collection", "id": "collection", "label": "Collection to fill the rest of the row" },
    { "type": "range", "id": "limit", "label": "Max products", "min": 1, "max": 24, "default": 12 },
    { "type": "text", "id": "more_label", "label": "Last card label", "default": "Shop all" },
    { "type": "text", "id": "badge", "label": "Corner flag (e.g. BESTSELLER)" },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full-width", "options": [ { "value": "full-width", "label": "Full width" }, { "value": "page-width", "label": "Page width" } ] },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "color", "id": "purple", "label": "Purple", "default": "#A98BCB" },
    { "type": "color", "id": "lime", "label": "Lime", "default": "#D9F25B" },
    { "type": "color", "id": "dark", "label": "Dark", "default": "#1E1E1E" },
    { "type": "color", "id": "red", "label": "Button red", "default": "#D32F2F" }
  ],
  "presets": [{ "name": "11.11 product row" }]
}
{% endschema %}
