{%- render 'kj-sale-styles' -%}
<div class="kjs kjs--{{ section.settings.section_width }}" style="--kjs-purple: {{ section.settings.purple }}; --kjs-lime: {{ section.settings.lime }}; --kjs-dark: {{ section.settings.dark }}; --kjs-red: {{ section.settings.red }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
        <section class="kjs-sec" >
          <div class="kjs-bar">
            <h3 class="kjs-bar__title">{{ section.settings.heading | escape }}{%- if section.settings.sub != blank -%} <span>· {{ section.settings.sub | escape }}</span>{%- endif -%}</h3>
            {%- if section.settings.link_label != blank -%}<a class="kjs-bar__link" href="{{ section.settings.link | default: '#' }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
          </div>
          <div class="kjs-grid">
            {%- assign plist = section.settings.products -%}
            {%- if plist == blank and section.settings.collection != blank -%}{%- assign plist = section.settings.collection.products -%}{%- endif -%}
            {%- for product in plist limit: section.settings.limit -%}
              {%- liquid
                assign v = product.selected_or_first_available_variant
                assign off = 0
                if product.compare_at_price > product.price
                  assign diff = product.compare_at_price | minus: product.price
                  assign off = diff | times: 100 | divided_by: product.compare_at_price
                endif
              -%}
              <div class="kjs-card">
                <a class="kjs-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                  {%- if product.featured_image -%}
                    {{ product.featured_image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240, 480', sizes: '(min-width: 990px) 220px, 44vw', alt: product.title }}
                  {%- endif -%}
                  {%- if section.settings.badge != blank -%}<span class="kjs-card__flag">{{ section.settings.badge | escape }}</span>{%- endif -%}
                  {%- if off > 0 -%}<span class="kjs-card__off">{{ off }}% OFF</span>{%- endif -%}
                </a>
                <span class="kjs-card__brand">{{ product.vendor | escape }}</span>
                <a class="kjs-card__name" href="{{ product.url }}">{{ product.title | remove_first: product.vendor | remove_first: ' - ' | escape }}</a>
                <p class="kjs-card__price">
                  {%- if off > 0 -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
                  <strong>{{ product.price | money }}</strong>
                  {%- if off > 0 -%}<span class="kjs-card__pct">{{ off }}% OFF</span>{%- endif -%}
                </p>
                {%- if off > 0 -%}<span class="kjs-card__save">You save {{ diff | money }}</span>{%- endif -%}
                <div class="kjs-card__actions">
                  <a class="kjs-card__wish" href="{{ product.url }}" aria-label="View {{ product.title | escape }}"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path></svg></a>
                  {%- if product.available == false -%}
                    <span class="kjs-card__btn is-disabled">Sold out</span>
                  {%- elsif product.variants.size == 1 -%}
                    <button type="button" class="kjs-card__btn" data-kjs-add="{{ v.id }}" data-product-id="{{ product.id }}">Add to Bag</button>
                  {%- else -%}
                    <a class="kjs-card__btn" href="{{ product.url }}">Choose</a>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </section>

      
</div>

{% schema %}
{
  "name": "11.11 product row",
  "tag": "section",
  "class": "kj-sale-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "sub", "label": "Sub text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all →" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "collection", "id": "collection", "label": "Or collection (used when no products picked)" },
    { "type": "range", "id": "limit", "label": "Max products", "min": 1, "max": 12, "default": 6 },
    { "type": "text", "id": "badge", "label": "Corner flag (e.g. BESTSELLER)" },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full-width", "options": [ { "value": "full-width", "label": "Full width" }, { "value": "page-width", "label": "Page width" } ] },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "color", "id": "purple", "label": "Purple", "default": "#A98BCB" },
    { "type": "color", "id": "lime", "label": "Lime", "default": "#D9F25B" },
    { "type": "color", "id": "dark", "label": "Dark", "default": "#1E1E1E" },
    { "type": "color", "id": "red", "label": "Button red", "default": "#D32F2F" }
  ],
  "presets": [{ "name": "11.11 product row" }]
}
{% endschema %}
