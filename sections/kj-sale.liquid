{%- comment -%}
  muc: 11.11 sale page, built from the design canvas. One section, block per row.
  Block types: alert, hero, category, rewards, tiles, products, ticker, cta.
  Only CSS and a small add-to-bag script, loaded on this page alone.
{%- endcomment -%}
{%- liquid
  assign cats_open = false
-%}
<div class="kjs" style="--kjs-purple: {{ section.settings.purple }}; --kjs-lime: {{ section.settings.lime }}; --kjs-dark: {{ section.settings.dark }}; --kjs-red: {{ section.settings.red }};">
  {%- for block in section.blocks -%}
    {%- liquid
      if block.type != 'category' and cats_open
        echo '</div>'
        assign cats_open = false
      endif
    -%}
    {%- case block.type -%}

      {%- when 'alert' -%}
        <a class="kjs-alert" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="kjs-alert__tag">{{ block.settings.label | escape }}</span>
          <span class="kjs-alert__text">{{ block.settings.text }}</span>
        </a>

      {%- when 'hero' -%}
        <a class="kjs-hero" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="kjs-hero__left">
            <span class="kjs-hero__title">{{ block.settings.title | escape }} <span>{{ block.settings.title2 | escape }}</span></span>
            <span class="kjs-hero__tag">{{ block.settings.tag | escape }}</span>
          </div>
          <div class="kjs-hero__right">
            <span class="kjs-hero__upto">{{ block.settings.upto | escape }}</span>
            <span class="kjs-hero__pct">{{ block.settings.pct | escape }}</span>
            <span class="kjs-hero__off">{{ block.settings.off | escape }}</span>
          </div>
        </a>

      {%- when 'category' -%}
        {%- unless cats_open -%}
          <div class="kjs-cats">
          {%- assign cats_open = true -%}
        {%- endunless -%}
        <a class="kjs-cat" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="kjs-cat__img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '120px', alt: block.settings.label }}
            {%- endif -%}
          </span>
          <span class="kjs-cat__name">{{ block.settings.label | escape }}</span>
          <span class="kjs-cat__pct">{{ block.settings.pct | escape }}</span>
        </a>

      {%- when 'rewards' -%}
        <div class="kjs-rewards" {{ block.shopify_attributes }}>
          <div class="kjs-rewards__head">
            <span>{{ block.settings.line1 | escape }}</span>
            <span class="kjs-rewards__lime">{{ block.settings.line2 | escape }}</span>
          </div>
          <div class="kjs-rewards__tiers">
            {%- assign tiers = block.settings.tiers | newline_to_br | split: '<br />' -%}
            {%- for t in tiers -%}
              {%- assign parts = t | strip | split: '|' -%}
              {%- if parts.size < 2 -%}{%- continue -%}{%- endif -%}
              <div class="kjs-tier">
                <span class="kjs-tier__name">{{ parts[0] | strip | escape }}</span>
                <span class="kjs-tier__shop">{{ parts[1] | strip | escape }}</span>
                <span class="kjs-tier__reward">{{ parts[2] | strip | escape }}</span>
                {%- if parts[3] != blank -%}<span class="kjs-tier__plus">+</span><span class="kjs-tier__bonus">{{ parts[3] | strip | escape }}</span>{%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

      {%- when 'tiles' -%}
        <section class="kjs-sec" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h2 class="kjs-h2">{{ block.settings.heading | escape }}</h2>{%- endif -%}
          <div class="kjs-tiles kjs-tiles--{{ block.settings.style }}">
            {%- assign lines = block.settings.lines | newline_to_br | split: '<br />' -%}
            {%- for l in lines -%}
              {%- assign p = l | strip | split: '|' -%}
              {%- if p.size < 2 -%}{%- continue -%}{%- endif -%}
              {%- assign tile_link = p[3] | strip -%}
              {%- if block.settings.style == 'fave' -%}
                <a class="kjs-fave" href="{{ tile_link | default: '#' }}">
                  <span class="kjs-fave__top"><span class="kjs-fave__brand">{{ p[0] | strip | escape }}</span><span class="kjs-fave__desc">{{ p[1] | strip | escape }}</span></span>
                  <span class="kjs-fave__price"><span>RS.</span><span class="kjs-fave__num">{{ p[2] | strip | escape }}</span></span>
                </a>
              {%- elsif block.settings.style == 'steal' -%}
                {%- assign coll_handle = tile_link | split: '/collections/' | last | split: '?' | first -%}
                {%- assign coll = collections[coll_handle] -%}
                <a class="kjs-steal" href="{{ tile_link | default: '#' }}">
                  <span class="kjs-steal__text">
                    <span class="kjs-steal__name">{{ p[0] | strip | escape }}</span>
                    <span class="kjs-badge kjs-badge--purple"><span class="kjs-badge__k">{{ p[1] | strip | escape }}</span><span class="kjs-badge__p">{{ p[2] | strip | escape }}%</span><span class="kjs-badge__o">OFF</span></span>
                  </span>
                  <span class="kjs-steal__img">
                    {%- if coll.image -%}{{ coll.image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 400', sizes: '200px', alt: coll.title }}{%- endif -%}
                  </span>
                </a>
              {%- else -%}
                <a class="kjs-brand" href="{{ tile_link | default: '#' }}">
                  <span class="kjs-brand__name">{{ p[0] | strip | escape }}</span>
                  <span class="kjs-badge kjs-badge--lime"><span class="kjs-badge__k">{{ p[1] | strip | escape }}</span><span class="kjs-badge__p">{{ p[2] | strip | escape }}%</span><span class="kjs-badge__o">OFF</span></span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </section>

      {%- when 'products' -%}
        <section class="kjs-sec" {{ block.shopify_attributes }}>
          <div class="kjs-bar">
            <h3 class="kjs-bar__title">{{ block.settings.heading | escape }}{%- if block.settings.sub != blank -%} <span>· {{ block.settings.sub | escape }}</span>{%- endif -%}</h3>
            {%- if block.settings.link_label != blank -%}<a class="kjs-bar__link" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label | escape }}</a>{%- endif -%}
          </div>
          <div class="kjs-grid">
            {%- assign plist = block.settings.products -%}
            {%- if plist == blank and block.settings.collection != blank -%}{%- assign plist = block.settings.collection.products -%}{%- endif -%}
            {%- for product in plist limit: block.settings.limit -%}
              {%- liquid
                assign v = product.selected_or_first_available_variant
                assign off = 0
                if product.compare_at_price > product.price
                  assign diff = product.compare_at_price | minus: product.price
                  assign off = diff | times: 100 | divided_by: product.compare_at_price
                endif
              -%}
              <div class="kjs-card">
                <a class="kjs-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                  {%- if product.featured_image -%}
                    {{ product.featured_image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240, 480', sizes: '(min-width: 990px) 220px, 44vw', alt: product.title }}
                  {%- endif -%}
                  {%- if block.settings.badge != blank -%}<span class="kjs-card__flag">{{ block.settings.badge | escape }}</span>{%- endif -%}
                  {%- if off > 0 -%}<span class="kjs-card__off">{{ off }}% OFF</span>{%- endif -%}
                </a>
                <span class="kjs-card__brand">{{ product.vendor | escape }}</span>
                <a class="kjs-card__name" href="{{ product.url }}">{{ product.title | remove_first: product.vendor | remove_first: ' - ' | escape }}</a>
                <p class="kjs-card__price">
                  {%- if off > 0 -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
                  <strong>{{ product.price | money }}</strong>
                  {%- if off > 0 -%}<span class="kjs-card__pct">{{ off }}% OFF</span>{%- endif -%}
                </p>
                {%- if off > 0 -%}<span class="kjs-card__save">You save {{ diff | money }}</span>{%- endif -%}
                <div class="kjs-card__actions">
                  <a class="kjs-card__wish" href="{{ product.url }}" aria-label="View {{ product.title | escape }}"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path></svg></a>
                  {%- if product.available == false -%}
                    <span class="kjs-card__btn is-disabled">Sold out</span>
                  {%- elsif product.variants.size == 1 -%}
                    <button type="button" class="kjs-card__btn" data-kjs-add="{{ v.id }}" data-product-id="{{ product.id }}">Add to Bag</button>
                  {%- else -%}
                    <a class="kjs-card__btn" href="{{ product.url }}">Choose</a>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </section>

      {%- when 'ticker' -%}
        <a class="kjs-ticker" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="kjs-ticker__num">{{ block.settings.label | escape }}</span>
          <span class="kjs-ticker__text">{{ block.settings.text | escape }}</span>
          <span class="kjs-ticker__btn">{{ block.settings.button | escape }}</span>
        </a>

      {%- when 'cta' -%}
        <a class="kjs-cta" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="kjs-cta__text">{{ block.settings.heading | escape }}</span>
          <span class="kjs-cta__btn">{{ block.settings.button | escape }}</span>
        </a>

    {%- endcase -%}
  {%- endfor -%}
  {%- if cats_open -%}</div>{%- endif -%}
</div>

{% stylesheet %}
  .kjs { max-width: 1360px; margin: 0 auto; padding: 24px clamp(16px, 4vw, 40px) 64px; display: flex; flex-direction: column; gap: 40px; font-family: var(--font-body--family); color: #1e1e1e; }
  .kjs a { text-decoration: none; color: inherit; }
  .kjs-h2 { margin: 0 0 20px; text-align: center; font-size: clamp(28px, 3.4vw, 44px); font-weight: 900; letter-spacing: -0.02em; color: #1e1e1e; }
  .kjs-alert { display: flex; align-items: center; justify-content: center; gap: 12px 32px; flex-wrap: wrap; padding: 20px 24px; border-radius: 12px; background: var(--kjs-dark); color: #fff; margin-top: -8px; }
  .kjs-alert__tag { font-size: 24px; font-weight: 900; line-height: 1; color: var(--kjs-dark); background: var(--kjs-lime); padding: 8px 14px; border-radius: 8px; transform: rotate(-3deg); }
  .kjs-alert__text { font-size: 22px; font-weight: 700; text-transform: uppercase; }
  .kjs-alert__text strong, .kjs-alert__text em { color: var(--kjs-lime); font-style: normal; }
  .kjs-hero { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 32px; padding: clamp(28px, 5vw, 64px); border-radius: 16px; background: var(--kjs-purple); color: var(--kjs-dark); min-height: 440px; box-sizing: border-box; overflow: hidden; }
  .kjs-hero__left { flex: 1 1 380px; display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .kjs-hero__title { display: flex; align-items: baseline; gap: 18px; border: 4px solid var(--kjs-dark); background: var(--kjs-lime); padding: 8px 22px; font-size: clamp(56px, 7vw, 104px); font-weight: 900; line-height: 1; letter-spacing: -0.02em; }
  .kjs-hero__tag { background: var(--kjs-lime); border: 2px solid var(--kjs-dark); border-radius: 10px; padding: 8px 18px; font-size: clamp(16px, 1.8vw, 24px); font-weight: 800; letter-spacing: 0.02em; }
  .kjs-hero__right { flex: 1 1 320px; display: flex; flex-direction: column; align-items: flex-start; line-height: 0.9; }
  .kjs-hero__upto, .kjs-hero__off { font-size: clamp(24px, 2.6vw, 36px); font-weight: 700; }
  .kjs-hero__off { align-self: flex-end; margin-right: 8%; }
  .kjs-hero__pct { font-size: clamp(120px, 15vw, 220px); font-weight: 900; letter-spacing: -0.04em; color: var(--kjs-lime); -webkit-text-stroke: 3px var(--kjs-dark); }
  .kjs-cats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 20px; }
  .kjs-cat { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  .kjs-cat__img { width: 120px; height: 120px; border-radius: 50%; overflow: hidden; background: radial-gradient(circle at 50% 35%, #f1eafa 0%, #c9b6e3 100%); display: flex; align-items: center; justify-content: center; }
  .kjs-cat__img img { width: 100%; height: 100%; object-fit: cover; }
  .kjs-cat__name { font-size: 14px; font-weight: 500; line-height: 1.25; }
  .kjs-cat__pct { font-size: 14px; font-weight: 800; line-height: 1.25; margin-top: -8px; }
  .kjs-rewards { display: flex; flex-wrap: wrap; align-items: center; gap: 24px 40px; padding: clamp(24px, 4vw, 40px); border-radius: 16px; background: var(--kjs-dark); color: #fff; }
  .kjs-rewards__head { flex: 1 1 280px; display: flex; flex-direction: column; gap: 4px; font-size: clamp(36px, 4vw, 56px); font-weight: 900; line-height: 0.95; }
  .kjs-rewards__lime { color: var(--kjs-lime); }
  .kjs-rewards__tiers { flex: 2 1 520px; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; }
  .kjs-tier { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; padding: 18px 14px; border: 2px solid var(--kjs-purple); border-radius: 14px; background: #2a2a2a; }
  .kjs-tier__name { font-size: 22px; font-weight: 800; }
  .kjs-tier__shop { font-size: 11px; font-weight: 700; background: var(--kjs-lime); color: var(--kjs-dark); padding: 4px 10px; border-radius: 999px; }
  .kjs-tier__reward { font-size: 14px; line-height: 1.35; color: #ddd; }
  .kjs-tier__plus { font-size: 18px; font-weight: 700; }
  .kjs-tier__bonus { font-size: 18px; font-weight: 800; line-height: 1.2; color: var(--kjs-lime); }
  .kjs-tiles { display: grid; gap: 16px; }
  .kjs-tiles--fave { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .kjs-tiles--steal { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .kjs-tiles--brand { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }
  .kjs-fave { display: flex; flex-direction: column; justify-content: space-between; aspect-ratio: 4 / 3; padding: 16px; box-sizing: border-box; border-radius: 14px; background: var(--kjs-purple); }
  .kjs-fave__top { display: flex; flex-direction: column; gap: 2px; }
  .kjs-fave__brand { font-size: 18px; font-weight: 800; }
  .kjs-fave__desc { font-size: 12px; }
  .kjs-fave__price { align-self: flex-start; display: flex; flex-direction: column; line-height: 1; background: var(--kjs-lime); padding: 8px 12px; border-radius: 10px; font-size: 12px; font-weight: 700; }
  .kjs-fave__num { font-size: 34px; font-weight: 900; }
  .kjs-badge { display: flex; flex-direction: column; line-height: 0.95; padding: 8px 12px; border-radius: 10px; color: var(--kjs-dark); }
  .kjs-badge--purple { background: var(--kjs-purple); }
  .kjs-badge--lime { background: var(--kjs-lime); align-self: flex-end; align-items: flex-end; line-height: 0.9; }
  .kjs-badge__k { font-size: 12px; font-weight: 800; letter-spacing: 0.08em; }
  .kjs-badge__p { font-size: 44px; font-weight: 900; }
  .kjs-badge--lime .kjs-badge__p { font-size: 40px; }
  .kjs-badge__o { font-size: 14px; font-weight: 800; letter-spacing: 0.1em; }
  .kjs-steal { display: flex; justify-content: space-between; gap: 12px; aspect-ratio: 16 / 10; padding: 18px; box-sizing: border-box; border-radius: 14px; background: #f3edf9; border: 1px solid #ddd0ec; }
  .kjs-steal__text { display: flex; flex-direction: column; justify-content: space-between; }
  .kjs-steal__name { font-size: 16px; font-weight: 800; letter-spacing: 0.02em; }
  .kjs-steal__img { flex: 0 0 46%; border-radius: 10px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .kjs-steal__img:empty { border: 1.5px dashed #b9aacb; }
  .kjs-steal__img img { width: 100%; height: 100%; object-fit: cover; }
  .kjs-brand { display: flex; flex-direction: column; justify-content: space-between; aspect-ratio: 4 / 3; padding: 14px 16px; box-sizing: border-box; border-radius: 12px; background: var(--kjs-purple); overflow: hidden; }
  .kjs-brand__name { font-size: 17px; font-weight: 800; line-height: 1.15; }
  .kjs-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; background: var(--kjs-dark); border-radius: 10px; padding: 18px 24px; margin-bottom: 20px; }
  .kjs-bar__title { margin: 0; font-size: 20px; font-weight: 700; color: #fff; }
  .kjs-bar__title span { font-weight: 400; color: #ccc; font-size: 14px; }
  .kjs-bar__link { color: var(--kjs-lime); font-size: 14px; font-weight: 600; }
  .kjs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 20px; }
  .kjs-card { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .kjs-card__media { position: relative; display: flex; align-items: center; justify-content: center; aspect-ratio: 1 / 1; border: 1px solid #ececec; border-radius: 8px; overflow: hidden; background: #f6f3f9; }
  .kjs-card__media img { width: 100%; height: 100%; object-fit: contain; }
  .kjs-card__off { position: absolute; top: 0; right: 0; background: var(--kjs-red); color: #fff; font-size: 12px; font-weight: 600; line-height: 1; padding: 6px 9px; border-bottom-left-radius: 6px; }
  .kjs-card__flag { position: absolute; top: 8px; left: 8px; background: #fff1e0; color: #8a4b00; font-size: 10px; font-weight: 700; letter-spacing: 0.04em; line-height: 1; padding: 4px 6px; border-radius: 4px; text-transform: uppercase; }
  .kjs-card__brand { font-size: 15px; font-weight: 700; color: #111; margin-top: 4px; }
  .kjs-card__name { color: #555; font-size: 13px; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 35px; }
  .kjs-card__price { margin: 0; display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; font-size: 15px; }
  .kjs-card__price s { font-size: 12px; color: #767676; }
  .kjs-card__price strong { font-weight: 700; color: #111; }
  .kjs-card__pct { font-size: 12px; color: #1e7d45; border-left: 1px solid #ddd; padding-left: 6px; }
  .kjs-card__save { align-self: flex-start; background: #e9f7ee; color: #1e7d45; font-size: 12px; font-weight: 500; padding: 5px 10px; border-radius: 999px; }
  .kjs-card__actions { display: flex; gap: 8px; margin-top: 6px; }
  .kjs-card__wish { flex: 0 0 44px; height: 44px; border-radius: 50%; border: 1px solid #d0d0d0; background: #fff; color: #1e1e1e; display: flex; align-items: center; justify-content: center; }
  .kjs-card__btn { flex: 1; min-height: 44px; border: 0; border-radius: 999px; background: var(--kjs-red); color: #fff; font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .kjs-card__btn.is-disabled { background: #bbb; cursor: default; }
  .kjs-ticker { display: flex; align-items: center; justify-content: center; gap: 12px 28px; flex-wrap: wrap; padding: 20px 24px; border-radius: 12px; background: var(--kjs-lime); color: var(--kjs-dark); }
  .kjs-ticker__num { font-size: 30px; font-weight: 900; line-height: 1; }
  .kjs-ticker__text { font-size: clamp(18px, 2vw, 26px); font-weight: 800; letter-spacing: 0.01em; text-transform: uppercase; }
  .kjs-ticker__btn { font-size: 14px; font-weight: 700; background: var(--kjs-dark); color: #fff; padding: 10px 18px; border-radius: 999px; }
  .kjs-cta { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 26px clamp(20px, 4vw, 40px); border-radius: 12px; background: #f3edf9; color: var(--kjs-dark); }
  .kjs-cta__text { font-size: clamp(26px, 3.4vw, 44px); font-weight: 900; letter-spacing: -0.01em; text-transform: uppercase; }
  .kjs-cta__btn { font-size: 14px; font-weight: 600; background: #fff; border: 1px solid var(--kjs-dark); padding: 12px 22px; border-radius: 8px; }
  @media screen and (max-width: 749px) {
    .kjs { gap: 28px; padding-bottom: 40px; }
    .kjs-alert__text { font-size: 16px; }
    .kjs-hero { min-height: 0; gap: 16px; }
    .kjs-hero__pct { font-size: clamp(96px, 30vw, 140px); }
    .kjs-cats { grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .kjs-cat__img { width: 92px; height: 92px; }
    .kjs-cat__name, .kjs-cat__pct { font-size: 12px; }
    .kjs-tiles--fave, .kjs-tiles--brand { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .kjs-tiles--steal { grid-template-columns: 1fr; }
    .kjs-fave__num { font-size: 28px; }
    .kjs-badge__p, .kjs-badge--lime .kjs-badge__p { font-size: 32px; }
    .kjs-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .kjs-card__brand { font-size: 13px; }
    .kjs-card__name { font-size: 12px; }
    .kjs-bar { padding: 14px 16px; }
    .kjs-bar__title { font-size: 16px; }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-kjs-add]');
    if (!btn || btn.disabled) return;
    e.preventDefault();
    btn.disabled = true;
    const label = btn.textContent;
    btn.textContent = 'Adding…';
    const sections = [...document.querySelectorAll('cart-items-component[data-section-id]')].map((el) => el.dataset.sectionId);
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(btn.dataset.kjsAdd), quantity: 1, properties: { _added_from: 'sale-page' } }], sections: sections.join(',') }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.description || data.message || 'Could not add');
      const cart = await fetch('/cart.js').then((r) => r.json());
      const ev = new Event('cart:update', { bubbles: true });
      ev.detail = { resource: cart, sourceId: btn.dataset.kjsAdd, data: { source: 'kj-sale', itemCount: 1, productId: btn.dataset.productId, variantId: btn.dataset.kjsAdd, sections: data.sections } };
      btn.dispatchEvent(ev);
      btn.textContent = 'Added';
      setTimeout(() => { btn.textContent = label; btn.disabled = false; }, 1500);
    } catch (err) {
      console.error('[kj-sale]', err);
      btn.textContent = 'Sold out';
      setTimeout(() => { btn.textContent = label; btn.disabled = false; }, 2500);
    }
  });
{% endjavascript %}

