

{% liquid
  assign max_items = section.settings.max_products

  assign bg_styles = ''
  if section.settings.gradient_color_1 != blank and section.settings.gradient_color_2 != blank
    assign grad_opacity = section.settings.gradient_opacity | default: 100 | divided_by: 100.0
    assign grad_dir = section.settings.gradient_direction | default: 'to bottom'
    assign bg_styles = 'background-image: linear-gradient(' | append: grad_dir | append: ', rgba(' | append: section.settings.gradient_color_1.red | append: ',' | append: section.settings.gradient_color_1.green | append: ',' | append: section.settings.gradient_color_1.blue | append: ',' | append: grad_opacity | append: '), rgba(' | append: section.settings.gradient_color_2.red | append: ',' | append: section.settings.gradient_color_2.green | append: ',' | append: section.settings.gradient_color_2.blue | append: ',' | append: grad_opacity | append: '));'
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"{% if bg_styles != '' %} style="{{ bg_styles }}"{% endif %}></div>
<div
  data-testid="product-list"
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  {%- liquid
    assign has_banner_d = false
    assign has_banner_m = false
    if section.settings.banner_image_desktop != blank
      assign has_banner_d = true
    endif
    if section.settings.banner_image_mobile != blank
      assign has_banner_m = true
    endif
  -%}
  {%- if has_banner_d or has_banner_m -%}
    {%- capture banner_inner -%}
      {%- if has_banner_d and has_banner_m -%}
        {{ section.settings.banner_image_desktop | image_url: width: 2200 | image_tag: class: 'resource-list__banner-img rlb--desktop', loading: 'lazy', sizes: '100vw', widths: '800,1200,1600,2200', alt: section.settings.banner_image_desktop.alt | default: '' }}
        {{ section.settings.banner_image_mobile | image_url: width: 1200 | image_tag: class: 'resource-list__banner-img rlb--mobile', loading: 'lazy', sizes: '100vw', widths: '400,600,800,1200', alt: section.settings.banner_image_mobile.alt | default: '' }}
      {%- else -%}
        {%- assign single_banner = section.settings.banner_image_desktop | default: section.settings.banner_image_mobile -%}
        {{ single_banner | image_url: width: 2200 | image_tag: class: 'resource-list__banner-img', loading: 'lazy', sizes: '100vw', widths: '400,800,1200,1600,2200', alt: single_banner.alt | default: '' }}
      {%- endif -%}
    {%- endcapture -%}
    {%- if section.settings.banner_link != blank -%}
      <a class="resource-list__banner" href="{{ section.settings.banner_link }}">{{ banner_inner }}</a>
    {%- else -%}
      <div class="resource-list__banner">{{ banner_inner }}</div>
    {%- endif -%}
  {%- endif -%}

  <div class="section-resource-list__header">
    {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
  </div>

  {% capture list_items %}
    {% if section.settings.collection != blank and shop.products_count != 0 %}
      {% paginate section.settings.collection.products by max_items %}
        {% for product in section.settings.collection.products limit: max_items %}
          <div
            class="resource-list__item"
          >
            {% # theme-check-disable UniqueStaticBlockId %}
              {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
            {% # theme-check-enable UniqueStaticBlockId %}
          </div>

          {% unless forloop.last %}
            <!--@list/split-->
          {% endunless %}
        {% endfor %}
      {% endpaginate %}
    {% else %}
      {% for i in (1..max_items) %}
        <div
          class="resource-list__item"
        >
          {% # theme-check-disable UniqueStaticBlockId %}
            {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
          {% # theme-check-enable UniqueStaticBlockId %}
        </div>

        {% unless forloop.last %}
          <!--@list/split-->
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endcapture %}

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    slide_count: max_items,
    content_type: 'products',
    test_id: 'resource-list-grid'
  %}

  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

{% stylesheet %}
  /* "View all" header link: no button fill, plain text link. */
  .section-resource-list__header .button {
    background: transparent;
    border: none;
    color: #111;
    padding-inline: 0;
  }

  .section-resource-list__header .button:hover {
    background: transparent;
    text-decoration: underline;
  }

  /* Carousel product cards: flush (no left/right gap) with a vertical divider
     between them, matching the collection grid. */
  .resource-list__carousel slideshow-slides {
    column-gap: 0 !important;
    gap: 0 !important;
  }

  .resource-list__slide {
    border-right: 1px solid rgba(0, 19, 37, 0.08);
  }

  /* Optional banner above the carousel (separate mobile/desktop images). */
  .resource-list__banner {
    display: block;
    margin-bottom: 16px;
  }

  .resource-list__banner-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .rlb--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .rlb--desktop {
      display: none;
    }
    .rlb--mobile {
      display: block;
    }
  }
{% endstylesheet %}

