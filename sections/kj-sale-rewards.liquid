{%- render 'kj-sale-styles' -%}
<div class="kjs kjs--{{ section.settings.section_width }}" style="--kjs-purple: {{ section.settings.purple }}; --kjs-lime: {{ section.settings.lime }}; --kjs-dark: {{ section.settings.dark }}; --kjs-red: {{ section.settings.red }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
        <div class="kjs-rewards" >
          <div class="kjs-rewards__head">
            <span>{{ section.settings.line1 | escape }}</span>
            <span class="kjs-rewards__lime">{{ section.settings.line2 | escape }}</span>
          </div>
          <div class="kjs-rewards__tiers">
            {%- assign tiers = section.settings.tiers | newline_to_br | split: '<br />' -%}
            {%- for t in tiers -%}
              {%- assign parts = t | strip | split: '|' -%}
              {%- if parts.size < 2 -%}{%- continue -%}{%- endif -%}
              <div class="kjs-tier">
                <span class="kjs-tier__name">{{ parts[0] | strip | escape }}</span>
                <span class="kjs-tier__shop">{{ parts[1] | strip | escape }}</span>
                <span class="kjs-tier__reward">{{ parts[2] | strip | escape }}</span>
                {%- if parts[3] != blank -%}
                  {%- assign bonus = parts[3] | strip -%}
                  {%- assign code = bonus | split: ' ' | last -%}
                  <span class="kjs-tier__plus">+</span>
                  <button type="button" class="kjs-tier__bonus kjs-copy" data-kjs-copy="{{ code | escape }}" aria-label="Copy code {{ code | escape }}">{{ bonus | escape }}<span class="kjs-copy__tip" aria-hidden="true">Tap to copy</span></button>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

      
</div>

{% schema %}
{
  "name": "11.11 reward tiers",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "line1", "label": "Line 1", "default": "BIGGER BAG" },
    { "type": "text", "id": "line2", "label": "Line 2 (lime)", "default": "BIGGER REWARDS" },
    { "type": "textarea", "id": "tiers", "label": "Tiers, one per line: Name | Shop line | Reward | Bonus" },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full-width", "options": [ { "value": "full-width", "label": "Full width" }, { "value": "page-width", "label": "Page width" } ] },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "color", "id": "purple", "label": "Purple", "default": "#A98BCB" },
    { "type": "color", "id": "lime", "label": "Lime", "default": "#D9F25B" },
    { "type": "color", "id": "dark", "label": "Dark", "default": "#1E1E1E" },
    { "type": "color", "id": "red", "label": "Button red", "default": "#D32F2F" }
  ],
  "presets": [{ "name": "11.11 reward tiers" }]
}
{% endschema %}
