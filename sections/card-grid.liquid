{% liquid
  assign s = section.settings
  assign desktop_columns = s.desktop_columns | default: 4
  assign mobile_columns = s.mobile_columns | default: 2
  assign gap = s.gap | default: 16
  assign desktop_layout = s.desktop_layout | default: 'grid'
  assign mobile_layout = s.mobile_layout | default: 'grid'
  assign desktop_slider_per_view = s.desktop_slider_per_view | default: desktop_columns
  assign mobile_slider_per_view = s.mobile_slider_per_view | default: '2'
  assign auto_rotate = s.auto_rotate
  assign rotate_interval = s.rotate_interval | default: 4
  assign desktop_side_padding = s.desktop_side_padding | default: 48
  assign mobile_side_padding = s.mobile_side_padding | default: 0
%}

{% liquid
  assign bg_styles = ''
  if s.background_image != blank or s.gradient_color_1 != blank or s.gradient_color_2 != blank
    assign bg_layers = ''
    if s.gradient_color_1 != blank and s.gradient_color_2 != blank
      assign grad_opacity = s.gradient_opacity | default: 50 | divided_by: 100.0
      assign grad_dir = s.gradient_direction | default: 'to bottom'
      assign bg_layers = 'linear-gradient(' | append: grad_dir | append: ', rgba(' | append: s.gradient_color_1.red | append: ',' | append: s.gradient_color_1.green | append: ',' | append: s.gradient_color_1.blue | append: ',' | append: grad_opacity | append: '), rgba(' | append: s.gradient_color_2.red | append: ',' | append: s.gradient_color_2.green | append: ',' | append: s.gradient_color_2.blue | append: ',' | append: grad_opacity | append: '))'
    endif
    if s.background_image != blank
      assign img_layer = 'url(' | append: s.background_image | image_url: width: 1920 | append: ')'
      if bg_layers != ''
        assign bg_layers = bg_layers | append: ', ' | append: img_layer
      else
        assign bg_layers = img_layer
      endif
    endif
    assign bg_styles = 'background-image: ' | append: bg_layers | append: '; background-position: center center; background-size: cover; background-repeat: no-repeat;'
  endif
%}
<div class="section-background color-{{ s.color_scheme }}"{% if bg_styles != '' %} style="{{ bg_styles }}"{% endif %}></div>
<div
  class="section section--{{ s.section_width }} color-{{ s.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: s %}"
  data-testid="card-grid-{{ section.id }}"
>
  {%- if s.heading != blank -%}
    <div class="card-grid__header" style="text-align: {{ s.heading_alignment }};">
      <h2 class="card-grid__heading h3">{{ s.heading }}</h2>
      {%- if s.subheading != blank -%}
        <p class="card-grid__subheading">{{ s.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="card-grid__slider-wrapper">
    <card-grid-slider
      class="card-grid__grid"
      data-desktop-layout="{{ desktop_layout }}"
      data-mobile-layout="{{ mobile_layout }}"
      data-auto-rotate="{{ auto_rotate }}"
      data-rotate-interval="{{ rotate_interval }}"
      data-show-arrows="{{ s.show_arrows }}"
      style="--cg-desktop-cols: {{ desktop_columns }}; --cg-mobile-cols: {{ mobile_columns }}; --cg-desktop-per-view: {{ desktop_slider_per_view }}; --cg-mobile-per-view: {{ mobile_slider_per_view }}; --cg-gap: {{ gap }}px; --cg-desktop-side-padding: {{ desktop_side_padding }}px; --cg-mobile-side-padding: {{ mobile_side_padding }}px;"
    >
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div
          class="card-grid__item{% if b.discount_code != blank %} card-grid__item--code{% endif %}"
          {% if b.discount_code != blank %}
            data-discount-code="{{ b.discount_code | strip | escape }}"
            role="button"
            tabindex="0"
            aria-label="Copy discount code {{ b.discount_code | strip | escape }}"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if b.link != blank -%}
            <a href="{{ b.link }}" class="card-grid__link" {% if b.open_new_tab %}target="_blank" rel="noopener"{% endif %}>
          {%- endif -%}
            <div class="card-grid__image-wrapper">
              {%- if b.image != blank -%}
                {{
                  b.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '400,600,750,900',
                    sizes: '(max-width: 749px) 50vw, 25vw',
                    class: 'card-grid__image',
                    alt: b.image.alt | default: ''
                }}
              {%- else -%}
                <div class="card-grid__placeholder">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>
          {%- if b.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="card-grid__item">
            <div class="card-grid__image-wrapper">
              <div class="card-grid__placeholder">
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </card-grid-slider>
    {%- if s.show_arrows -%}
      <button class="card-grid__arrow card-grid__arrow--prev" aria-label="Previous" data-direction="prev">
        {{ 'icon-chevron-left.svg' | inline_asset_content }}
      </button>
      <button class="card-grid__arrow card-grid__arrow--next" aria-label="Next" data-direction="next">
        {{ 'icon-chevron-right.svg' | inline_asset_content }}
      </button>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .card-grid__header {
    margin-bottom: var(--gap-md, 16px);
  }

  .card-grid__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    color: rgb(var(--color-foreground-heading));
  }

  @media screen and (max-width: 749px) {
    /* .h3 typography class sets 2rem and ties on specificity, so target both
       classes to win. */
    .card-grid__heading.h3 {
      font-size: 1.15rem;
    }
  }

  .card-grid__subheading {
    margin: var(--gap-2xs, 4px) 0 0;
    color: rgb(var(--color-foreground));
    opacity: 0.7;
  }

  /* Discount-code cards are tappable. */
  .card-grid__item--code {
    cursor: pointer;
  }

  .card-grid__item--code:active {
    transform: scale(0.985);
  }

  /* "Code copied" confirmation. */
  .kj-code-pop {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 19, 37, 0.45);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
  }

  .kj-code-pop[hidden] {
    display: none;
  }

  .kj-code-pop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .kj-code-pop__card {
    width: min(92vw, 340px);
    padding: 24px 22px 20px;
    border-radius: 16px;
    background: #fff;
    text-align: center;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.3);
    transform: translateY(10px) scale(0.98);
    transition: transform 0.2s ease;
  }

  .kj-code-pop.is-open .kj-code-pop__card {
    transform: none;
  }

  .kj-code-pop__tick {
    width: 44px;
    height: 44px;
    margin: 0 auto 12px;
    border-radius: 999px;
    background: #e8f7ee;
    color: #068743;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kj-code-pop__title {
    margin: 0 0 4px;
    font-size: 16px;
    font-weight: 700;
    color: #001325;
  }

  .kj-code-pop__code {
    display: inline-block;
    margin: 8px 0 10px;
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px dashed rgba(0, 19, 37, 0.28);
    background: rgba(0, 19, 37, 0.04);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: #001325;
  }

  .kj-code-pop__hint {
    margin: 0 0 16px;
    font-size: 13px;
    line-height: 18px;
    color: rgba(0, 19, 37, 0.66);
  }

  .kj-code-pop__btn {
    display: block;
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 999px;
    background: #ff0f0f;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .kj-code-pop__dismiss {
    display: block;
    width: 100%;
    margin-top: 8px;
    padding: 8px;
    border: none;
    background: none;
    color: rgba(0, 19, 37, 0.6);
    font-size: 13px;
    cursor: pointer;
  }

  .card-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--cg-desktop-cols, 4), 1fr);
    gap: var(--cg-gap, 16px);
  }

  /* Desktop slider mode */
  @media screen and (min-width: 750px) {
    /* Desktop-only side padding applies to BOTH grid and slider modes */
    .card-grid__grid {
      padding-inline: var(--cg-desktop-side-padding, 48px);
    }

    .card-grid__grid[data-desktop-layout="slider"] {
      display: flex;
      grid-template-columns: none;
      gap: var(--cg-gap, 16px);
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 0 var(--cg-desktop-side-padding, 48px);
      scroll-padding-inline: var(--cg-desktop-side-padding, 48px);
    }

    .card-grid__grid[data-desktop-layout="slider"]::-webkit-scrollbar {
      display: none;
    }

    .card-grid__grid[data-desktop-layout="slider"] .card-grid__item {
      flex: 0 0 calc((100% - (var(--cg-gap, 16px) * (var(--cg-desktop-per-view) - 1))) / var(--cg-desktop-per-view));
      min-width: 0;
      scroll-snap-align: start;
    }
  }

  @media screen and (max-width: 749px) {
    .card-grid__grid {
      grid-template-columns: repeat(var(--cg-mobile-cols, 2), 1fr);
    }

    /* Mobile slider mode */
    .card-grid__grid[data-mobile-layout="slider"] {
      display: flex;
      grid-template-columns: none;
      gap: var(--cg-gap, 16px);
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 0 var(--cg-mobile-side-padding, 0px);
      scroll-padding-inline: var(--cg-mobile-side-padding, 0px);
    }

    .card-grid__grid[data-mobile-layout="slider"]::-webkit-scrollbar {
      display: none;
    }

    .card-grid__grid[data-mobile-layout="slider"] .card-grid__item {
      flex: 0 0 calc((100% - (var(--cg-gap, 16px) * (var(--cg-mobile-per-view) - 1))) / var(--cg-mobile-per-view));
      min-width: 0;
      scroll-snap-align: start;
    }
  }

  .card-grid__item {
    position: relative;
    border-radius: var(--style-border-radius-card, 8px);
    overflow: hidden;
  }

  .card-grid__link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--style-border-radius-card, 8px);
    overflow: hidden;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .card-grid__link:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.1);
  }

  .card-grid__image-wrapper {
    position: relative;
    width: 100%;
  }

  .card-grid__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .card-grid__placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: rgb(var(--color-foreground) / 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-grid__placeholder .placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .card-grid__slider-wrapper {
    position: relative;
  }

  .card-grid__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.15);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .card-grid__arrow:hover {
    transform: translateY(-50%) scale(1.1);
  }

  .card-grid__arrow svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .card-grid__arrow--prev {
    left: 8px;
  }

  .card-grid__arrow--next {
    right: 8px;
  }

  .card-grid__arrow[disabled] {
    opacity: 0.3;
    pointer-events: none;
  }
{% endstylesheet %}

<script>
  (function () {
    if (customElements.get('card-grid-slider')) return;

    class CardGridSlider extends HTMLElement {
      connectedCallback() {
        this._setupArrows();

        if (this.dataset.autoRotate !== 'true') return;

        const seconds = parseInt(this.dataset.rotateInterval, 10);
        this.intervalMs = (isNaN(seconds) || seconds < 2 ? 4 : seconds) * 1000;
        this.isPaused = false;

        this.addEventListener('mouseenter', () => { this.isPaused = true; });
        this.addEventListener('mouseleave', () => { this.isPaused = false; });
        this.addEventListener('touchstart', () => {
          this.isPaused = true;
          clearTimeout(this._resumeTimer);
          this._resumeTimer = setTimeout(() => { this.isPaused = false; }, 5000);
        }, { passive: true });

        if (typeof IntersectionObserver !== 'undefined') {
          this._io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => { this._inView = entry.isIntersecting; });
          }, { threshold: 0.2 });
          this._io.observe(this);
        } else {
          this._inView = true;
        }

        this._tick = setInterval(() => this.step(), this.intervalMs);
      }

      disconnectedCallback() {
        clearInterval(this._tick);
        clearTimeout(this._resumeTimer);
        if (this._io) this._io.disconnect();
      }

      _setupArrows() {
        if (this.dataset.showArrows !== 'true') return;

        const wrapper = this.closest('.card-grid__slider-wrapper');
        if (!wrapper) return;

        this._prevBtn = wrapper.querySelector('.card-grid__arrow--prev');
        this._nextBtn = wrapper.querySelector('.card-grid__arrow--next');

        if (this._prevBtn) {
          this._prevBtn.addEventListener('click', () => this.navigate('prev'));
        }
        if (this._nextBtn) {
          this._nextBtn.addEventListener('click', () => this.navigate('next'));
        }

        this.addEventListener('scroll', () => this._updateArrowState(), { passive: true });
        window.addEventListener('resize', () => this._updateArrowState());
        this._updateArrowState();
      }

      _updateArrowState() {
        if (!this._prevBtn || !this._nextBtn) return;
        if (this.currentLayout() !== 'slider') {
          this._prevBtn.style.display = 'none';
          this._nextBtn.style.display = 'none';
          return;
        }
        this._prevBtn.style.display = '';
        this._nextBtn.style.display = '';

        const atStart = this.scrollLeft <= 2;
        const atEnd = this.scrollLeft + this.clientWidth >= this.scrollWidth - 2;

        this._prevBtn.disabled = atStart;
        this._nextBtn.disabled = atEnd;
      }

      navigate(direction) {
        if (this.currentLayout() !== 'slider') return;
        if (this.scrollWidth <= this.clientWidth + 1) return;

        const firstItem = this.querySelector('.card-grid__item');
        if (!firstItem) return;

        const styles = getComputedStyle(this);
        const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
        const delta = firstItem.offsetWidth + gap;

        if (direction === 'next') {
          this.scrollBy({ left: delta, behavior: 'smooth' });
        } else {
          this.scrollBy({ left: -delta, behavior: 'smooth' });
        }
      }

      currentLayout() {
        const isDesktop = window.matchMedia('(min-width: 750px)').matches;
        return isDesktop ? this.dataset.desktopLayout : this.dataset.mobileLayout;
      }

      step() {
        if (this.isPaused) return;
        if (this._inView === false) return;
        if (this.currentLayout() !== 'slider') return;
        if (this.scrollWidth <= this.clientWidth + 1) return;

        const firstItem = this.querySelector('.card-grid__item');
        if (!firstItem) return;

        const styles = getComputedStyle(this);
        const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
        const delta = firstItem.offsetWidth + gap;

        const atEnd = this.scrollLeft + this.clientWidth >= this.scrollWidth - 2;
        if (atEnd) {
          this.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          this.scrollBy({ left: delta, behavior: 'smooth' });
        }
      }
    }

    customElements.define('card-grid-slider', CardGridSlider);
  })();
</script>

<div class="kj-code-pop" hidden role="dialog" aria-modal="true" aria-labelledby="kj-code-pop-title">
  <div class="kj-code-pop__card">
    <div class="kj-code-pop__tick">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
        <path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>
    <p class="kj-code-pop__title" id="kj-code-pop-title">Discount code copied</p>
    <div class="kj-code-pop__code" data-kj-code-value></div>
    <p class="kj-code-pop__hint">Paste it in the <strong>Discount</strong> box in your cart to apply the offer.</p>
    <button type="button" class="kj-code-pop__btn" data-kj-code-cart>Go to cart</button>
    <button type="button" class="kj-code-pop__dismiss" data-kj-code-close>Keep shopping</button>
  </div>
</div>

<script>
  (function () {
    if (window.__kjCodePop) return;
    window.__kjCodePop = true;

    function pop() { return document.querySelector('.kj-code-pop'); }

    function open(code) {
      var el = pop();
      if (!el) return;
      var value = el.querySelector('[data-kj-code-value]');
      if (value) value.textContent = code;
      el.hidden = false;
      void el.offsetWidth;
      el.classList.add('is-open');
    }

    function close() {
      var el = pop();
      if (!el) return;
      el.classList.remove('is-open');
      setTimeout(function () { el.hidden = true; }, 200);
    }

    function copy(text) {
      if (navigator.clipboard && window.isSecureContext) {
        return navigator.clipboard.writeText(text).catch(fallback);
      }
      return Promise.resolve(fallback());

      // Older/blocked clipboard API: use a hidden textarea.
      function fallback() {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.cssText = 'position:absolute;left:-9999px;opacity:0;';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta);
      }
    }

    function handle(card, e) {
      var code = card.getAttribute('data-discount-code');
      if (!code) return;
      e.preventDefault();
      copy(code).then(function () { open(code); });
    }

    document.addEventListener('click', function (e) {
      var el = e.target.closest && e.target.closest('[data-discount-code]');
      if (el) return handle(el, e);

      if (e.target.closest && e.target.closest('[data-kj-code-close]')) return close();
      if (e.target.closest && e.target.closest('[data-kj-code-cart]')) {
        window.location.href = '{{ routes.cart_url }}';
        return;
      }
      // Click on the backdrop closes.
      if (e.target.classList && e.target.classList.contains('kj-code-pop')) close();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') return close();
      if ((e.key === 'Enter' || e.key === ' ') && e.target.hasAttribute && e.target.hasAttribute('data-discount-code')) {
        handle(e.target, e);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Card grid",
  "tag": "section",
  "class": "section-card-grid",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout mode"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Slider" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Slider" }
      ],
      "default": "grid"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1 (stacked)" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Slider (when enabled)"
    },
    {
      "type": "select",
      "id": "desktop_slider_per_view",
      "label": "Desktop cards per view",
      "info": "Used when Desktop layout is Slider.",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "mobile_slider_per_view",
      "label": "Mobile cards per view",
      "info": "Used when Mobile layout is Slider. Peek size depends on the fractional part — higher values (e.g. 1.5) show more of the next card.",
      "options": [
        { "value": "1", "label": "1 (full width, no peek)" },
        { "value": "1.2", "label": "1.2 (small peek)" },
        { "value": "1.3", "label": "1.3" },
