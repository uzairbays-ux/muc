{%- render 'kj-sale-styles' -%}
<div class="kjs kjs--{{ section.settings.section_width }}" style="--kjs-purple: {{ section.settings.purple }}; --kjs-lime: {{ section.settings.lime }}; --kjs-dark: {{ section.settings.dark }}; --kjs-red: {{ section.settings.red }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <section class="kjs-sec">
    {%- if section.settings.heading != blank -%}<h2 class="kjs-h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="kjs-partners">
      {%- for block in section.blocks -%}
        {%- assign tag = 'div' -%}{%- if block.settings.link != blank -%}{%- assign tag = 'a' -%}{%- endif -%}
        <{{ tag }} class="kjs-partner"{% if tag == 'a' %} href="{{ block.settings.link }}"{% endif %} style="--kjs-partner-bg: {{ block.settings.logo_bg }}; --kjs-partner-fg: {{ block.settings.logo_fg }};" {{ block.shopify_attributes }}>
          <span class="kjs-partner__logo">
            {%- if block.settings.logo != blank -%}
              {{ block.settings.logo | image_url: width: 240 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- elsif block.settings.logo_asset != blank -%}
              <img src="{{ block.settings.logo_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="116" height="36">
            {%- else -%}
              {{ block.settings.logo_text | escape }}
            {%- endif -%}
          </span>
          <span class="kjs-partner__body">
            <span class="kjs-partner__title">{{ block.settings.title | escape }}</span>
            <span class="kjs-partner__text">{{ block.settings.text | escape }}</span>
            {%- if block.settings.badge != blank -%}<span class="kjs-partner__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
          </span>
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "11.11 payment partners",
  "tag": "section",
  "class": "kj-sale-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pay your way" },
    { "type": "select", "id": "section_width", "label": "Width", "default": "full-width", "options": [ { "value": "full-width", "label": "Full width" }, { "value": "page-width", "label": "Page width" } ] },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 },
    { "type": "color", "id": "purple", "label": "Purple", "default": "#A98BCB" },
    { "type": "color", "id": "lime", "label": "Lime", "default": "#D9F25B" },
    { "type": "color", "id": "dark", "label": "Dark", "default": "#1E1E1E" },
    { "type": "color", "id": "red", "label": "Button red", "default": "#D32F2F" }
  ],
  "blocks": [ { "type": "partner", "name": "Partner card", "settings": [
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "badge", "label": "Badge (optional)" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "logo_asset", "label": "Or theme asset file name", "info": "e.g. baadmay-logo-icon.svg" },
    { "type": "text", "id": "logo_text", "label": "Or logo text", "default": "yango" },
    { "type": "color", "id": "logo_bg", "label": "Logo tile background", "default": "#ff3c2e" },
    { "type": "color", "id": "logo_fg", "label": "Logo text colour", "default": "#ffffff" },
    { "type": "url", "id": "link", "label": "Link (optional)" } ] } ],
  "max_blocks": 4,
  "presets": [{ "name": "11.11 payment partners" }]
}
{% endschema %}
