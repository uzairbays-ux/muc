

<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

{% capture media_gallery %}
  {%- content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: closest.product
  -%}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: closest.product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% if section.settings.enable_sticky_add_to_cart %}
  {% liquid
    assign current_variant = product.selected_or_first_available_variant
    # Get the initial quantity based on quantity rules
    assign initial_quantity = current_variant.quantity_rule.min | default: 1
  %}

  <sticky-add-to-cart
    class="sticky-add-to-cart"
    data-variant-available="{{ current_variant.available }}"
    data-product-id="{{ product.id }}"
    data-current-variant-id="{{ current_variant.id }}"
    data-initial-quantity="{{ initial_quantity }}"
    data-default-variant-title="{{ 'products.product.default_title' | t }}"
  >
    <div
      class="sticky-add-to-cart__bar color-{{ settings.popover_color_scheme }}"
      data-stuck="false"
      ref="stickyBar"
      role="region"
      aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    >
      {% liquid
        assign image_to_show = current_variant.featured_image | default: product.featured_image
      %}
      {% if image_to_show %}
        <div
          class="sticky-add-to-cart__image"
        >
          {% assign image_alt = image_to_show.alt | default: product.title | escape %}
          {{
            image_to_show
            | image_url: width: 120
            | image_tag:
              loading: 'lazy',
              alt: image_alt,
              class: 'sticky-add-to-cart__image-img',
              data-testid: 'sticky-product-image',
              srcset: null,
              sizes: null,
              ref: 'productImage'
          }}
        </div>
      {% endif %}

      {% liquid
        assign has_single_option = false
        if product.has_only_default_variant != true and product.options.size == 1
          assign has_single_option = true
        endif

        if image_to_show == blank
          assign has_image = false
        else
          assign has_image = true
        endif
      %}
      <div
        class="sticky-add-to-cart__info"
        data-has-image="{{ has_image }}"
        data-singleton="{{ product.has_only_default_variant }}"
        data-single-option="{{ has_single_option }}"
      >
        <p
          class="sticky-add-to-cart__title"
          data-testid="sticky-product-title"
        >
          {{ product.title | escape }}
        </p>
        <div
          class="sticky-add-to-cart__variant"
          data-testid="sticky-variant-title"
          {% if product.has_only_default_variant %}
            style="display: none;"
          {% endif %}
        >
          {% unless product.has_only_default_variant %}
            {% if current_variant != blank %}
              {% assign variant_title = current_variant.title | escape %}
            {% endif %}
            {{ variant_title }}
          {% endunless %}
        </div>
      </div>

      <div
        class="sticky-add-to-cart__price"
        data-testid="sticky-price-display"
      >
        {% render 'price', product_resource: product, show_sale_price_first: true %}
      </div>

      <div class="sticky-add-to-cart__actions">
      <button
        type="button"
        class="sticky-add-to-cart__wish kj-wish"
        data-product-id="{{ product.id }}"
        aria-label="{{ 'products.product.add_to_wishlist' | t | default: 'Save to wishlist' }}"
        aria-pressed="false"
      >
        <svg class="kj-wish__icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 20.5s-7.5-4.6-7.5-9.7A4.3 4.3 0 0 1 12 7a4.3 4.3 0 0 1 7.5 3.8c0 5.1-7.5 9.7-7.5 9.7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
        </svg>
      </button>

      <button
        type="button"
        class="sticky-add-to-cart__button add-to-cart-button button"
        ref="addToCartButton"
        on:click="/handleAddToCartClick"
        {% unless current_variant.available %}
          disabled
        {% endunless %}
      >
        <span
          class="add-to-cart-text"
        >
          {% if current_variant.available %}
            <span class="svg-wrapper add-to-cart-icon">
              {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
            </span>
          {% endif %}
          <span class="add-to-cart-text__content">
            <span>
              {%- if current_variant.available -%}
                {{- 'products.product.add_to_cart' | t -}}
              {%- elsif current_variant == blank -%}
                {{- 'products.product.unavailable' | t -}}
              {%- else -%}
                {{- 'products.product.sold_out' | t -}}
              {%- endif -%}
            </span>
            <span
              ref="quantityDisplay"
              {% if current_variant.available and initial_quantity > 1 %}
                style="display: inline;"
              {% else %}
                style="display: none;"
              {% endif %}
            >
              {{- ' (' -}}
              <span ref="quantityNumber">{{- initial_quantity -}}</span>
              {{- ')' -}}
            </span>
          </span>
        </span>
        <span class="add-to-cart__added">
          <span class="svg-wrapper add-to-cart__added-icon">
            {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
          </span>
        </span>
      </button>
      </div>
    </div>
  </sticky-add-to-cart>

  <script>
    (function () {
      if (window.__kjWishInit) return;
      window.__kjWishInit = true;
      var KEY = 'kj-wishlist';
      function read() { try { return JSON.parse(localStorage.getItem(KEY)) || []; } catch (e) { return []; } }
      function write(l) { try { localStorage.setItem(KEY, JSON.stringify(l)); } catch (e) {} }
      function mark() {
        var l = read();
        document.querySelectorAll('.kj-wish').forEach(function (b) {
          b.setAttribute('aria-pressed', l.indexOf(b.getAttribute('data-product-id')) !== -1 ? 'true' : 'false');
        });
      }
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('.kj-wish');
        if (!b) return;
        e.preventDefault();
        var id = b.getAttribute('data-product-id'), l = read(), i = l.indexOf(id);
        if (i === -1) { l.push(id); b.setAttribute('aria-pressed', 'true'); }
        else { l.splice(i, 1); b.setAttribute('aria-pressed', 'false'); }
        write(l);
      });
      document.addEventListener('DOMContentLoaded', mark);
      mark();
    })();
  </script>
{% endif %}

{% render 'product-information-content',
  product_media_size: closest.product.media.size,
  section_id: section.id,
  settings: section.settings,
  media_gallery: media_gallery,
  product_details: product_details,
  additional_blocks: additional_blocks
%}

{% comment %}
  Vertical gradient page background on the product page only (this section renders
  only on the product template). White fades in at the top and bottom of the
  viewport, keeping the existing scheme color through the middle. Rendered as an
  inline {% raw %}{% style %}{% endraw %} so it doesn't leak to other templates,
  and section backgrounds are made transparent so the gradient shows through.
{% endcomment %}
{% style %}
  #MainContent {
    background: linear-gradient(to bottom, #ffffff 0%, #fbeef1 100%) no-repeat;
    background-size: 100% 100%;
  }

  /* Scoped to #MainContent so the header and footer keep their own backgrounds. */
  #MainContent .shopify-section .section-background {
    background: transparent;
  }

  /* Phones: brand on the left, rating on the right (spread the row apart). */
  @media screen and (max-width: 749px) {
    /* The brand/rating group is fit-content by default, leaving no room to spread —
       force it full width first, then space it apart. */
    [id^='ProductInformation'] .group-block:has(.rating-wrapper) {
      width: 100%;
      --size-style-width: 100%;
    }

    [id^='ProductInformation'] .group-block-content:has(> .rating-wrapper) {
      width: 100%;
      justify-content: space-between;
      --horizontal-alignment: space-between;
    }

    [id^='ProductInformation'] .rating-wrapper {
      margin-inline-start: auto;
    }

    /* Notify-me renders after the add-to-cart button on phones. */
    [id^='ProductInformation'] notify-me-availability {
      order: var(--mobile-order, 5);
    }

    /* Image-first PDP on phones: pull the gallery to the very top.
       (The section wrapper id is shopify-section-…, not ProductInformation, so
       we target the grid via its data attribute; #MainContent adds specificity
       to beat the theme's order:3.) */
    #MainContent [data-product-grid-content] > .product-information__media {
      order: -1 !important;
    }
  }

  /* Extra breathing room below the price. */
  [id^='ProductInformation'] product-price {
    display: block;
    margin-block-end: 14px;
  }

  /* Smaller price */
  [id^='ProductInformation'] .price-item--sale.price,
  [id^='ProductInformation'] .price-item--regular.price {
    font-size: 1.25rem;
  }

  /* ===== PDP info styled to match the reference ===== */
  /* Brand: bold + underlined, no grey pill. The vendor renders as an <a> inside
     a pill .text-block in .block-mobile-order. */
  [id^='ProductInformation'] .block-mobile-order .text-block:has(a) {
    background: transparent !important;
    padding: 0 !important;
  }
  [id^='ProductInformation'] .block-mobile-order .text-block:has(a) a {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
    color: #001325;
  }

  /* Price: bold sale price, grey cut price, GREEN discount (no red pill). */
  [id^='ProductInformation'] .price-item--sale.price {
    font-weight: 700;
    color: #001325;
  }
  [id^='ProductInformation'] .compare-at-price {
    color: rgba(0, 19, 37, 0.45);
    font-weight: 400;
  }
  [id^='ProductInformation'] .sale-badge__pill--inline {
    color: #068743 !important;
    background: transparent !important;
    padding-inline: 0 !important;
    font-weight: 600;
  }

  /* Hide the sale badge in the product-page gallery only (this inline style renders
     on the product page only; cards on other pages keep their badges). */
  .product-information__media .product-badges {
    display: none;
  }

  /* Make the About Product accordion stand out as a bordered card. */
  [id^='ProductInformation'] .accordion {
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
    border-radius: 12px;
    padding-inline: 16px;
    background: rgb(var(--color-foreground-rgb) / 0.03);
  }

  [id^='ProductInformation'] .accordion .details__header {
    font-weight: 600;
  }

  /* Wishlist heart + Add-to-cart share the "button" grid area as a flex row. */
  .sticky-add-to-cart__actions {
    grid-area: button;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sticky-add-to-cart__actions .sticky-add-to-cart__button {
    flex: 1 1 auto;
  }

  /* Wishlist heart in the sticky add-to-cart bar. */
  .sticky-add-to-cart__wish {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: #fff;
    border: 1px solid rgba(0, 19, 37, 0.15);
    border-radius: 999px;
    color: #001325;
    cursor: pointer;
  }

  .sticky-add-to-cart__wish .kj-wish__icon {
    width: 22px;
    height: 22px;
    display: block;
  }

  .sticky-add-to-cart__wish[aria-pressed='true'] {
    color: #ff0f0f;
    border-color: #ff0f0f;
  }

  .sticky-add-to-cart__wish[aria-pressed='true'] .kj-wish__icon {
    fill: #ff0f0f;
  }
{% endstyle %}

{% stylesheet %}
  .sticky-add-to-cart__bar {
    position: fixed;
    /* Anchor to bottom: 0 so Chrome URL-bar show/hide doesn't reposition the element.
       The 20px visual gap is applied via translateY in the stuck state instead. */
    bottom: 0;
    left: 50%;
    opacity: 0;
    /* translateZ(0) keeps this on its own GPU compositor layer at all times,
       avoiding paint storms. Never use will-change here — it causes memory
       pressure on low-end Android when multiple layers compete. */
    transform: translateZ(0) translateX(-50%) translateY(calc(100% + 40px));
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    z-index: calc(var(--layer-sticky) - 1); /* Below sticky header */
    display: block;
    width: 600px;
    border-radius: calc(
      var(--style-border-radius-buttons-primary) + min(var(--padding-sm), var(--style-border-radius-buttons-primary))
    );
    padding: var(--padding-sm);
    /* Desktop grid: [image] [name / price] [button] */
    display: grid;
    grid-template-areas:
      'image info   button'
      'image price  button';
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto auto;
    align-items: center;
    gap: 2px var(--gap-md);

    /* No image: collapse image column */
    &:not(:has(.sticky-add-to-cart__image)) {
      grid-template-areas:
        'info   button'
        'price  button';
      grid-template-columns: 1fr auto;
    }
    /* Glass morphism — semi-transparent red with blur */
    background: rgba(220, 10, 10, 0.72);
    -webkit-backdrop-filter: blur(14px) saturate(180%);
    backdrop-filter: blur(14px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow: 0 8px 24px rgba(200, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.18);
    color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Hide direction: 0.15s delay acts as a CSS debounce.
       If IntersectionObserver rapid-fires show→hide at the scroll boundary,
       a re-show within 150 ms cancels the hide before it's visible. */
    .sticky-add-to-cart__bar {
      transition: transform 0.3s 0.15s var(--ease-out-quad), opacity 0.25s 0.15s ease;
    }

    /* Show direction: no delay — bar appears immediately */
    .sticky-add-to-cart__bar[data-stuck='true'] {
      transition: transform 0.35s 0s var(--ease-out-quad), opacity 0.25s 0s ease;
    }
  }

  .sticky-add-to-cart__bar[data-stuck='true'] {
    /* translateY(-20px) floats the bar 20px above the viewport bottom edge.
       Because bottom: 0, this value never recalculates during URL-bar resize. */
    transform: translateZ(0) translateX(-50%) translateY(-20px);
    opacity: 1;
  }

  sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__bar {
    opacity: 0;
    transform: translateZ(0) translateX(-50%) translateY(calc(100% + 40px));
    display: none;
  }


  .sticky-add-to-cart__image {
    grid-area: image;
    align-self: center;
    aspect-ratio: 1;
    height: calc(var(--height-buy-buttons) * 1.6);
    overflow: hidden;
    border-radius: var(--style-border-radius-buttons-primary);
    background: var(--color-background-secondary);
  }

  .sticky-add-to-cart__image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sticky-add-to-cart__info {
    grid-area: info;
    min-width: 0; /* Allow text truncation */
    align-self: end;
  }

  .sticky-add-to-cart__title {
    font-size: var(--font-paragraph-medium--size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-paragraph--line-height);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sticky-add-to-cart__variant {
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--font-paragraph-small--size);
    margin-top: var(--margin-3xs);
  }

  .sticky-add-to-cart__price {
    grid-area: price;
    align-self: start;
    font-weight: var(--font-weight-semibold);
  }

  .sticky-add-to-cart__button {
    grid-area: button;
    align-self: center;
    height: var(--height-buy-buttons);
    position: relative;
    background: #000 !important;
    color: #fff !important;
    border-color: #000 !important;
  }

  /* Mobile adjustments */
  @media screen and (max-width: 749px) {
    .sticky-add-to-cart__bar {
      /* Float with space on all sides.
         bottom: 0 + translateY(-16px) in stuck state avoids URL-bar resize jumps. */
      bottom: 0;
      left: 16px;
      right: 16px;
      width: auto;
      max-width: none;
      border-radius: 16px;
      padding: 12px 16px;

      /* Grid: [name + price] on left, [button] on right */
      display: grid;
      grid-template-areas:
        'info   button'
        'price  button';
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      align-items: center;
      gap: 2px 12px;

      /* Override desktop translateX(-50%) — not needed with left/right positioning */
      transform: translateZ(0) translateY(calc(100% + 60px));

      &[data-stuck='true'] {
        /* -16px = the visual bottom gap from screen edge */
        transform: translateZ(0) translateY(-16px);
      }

      &::before {
        --border: 1px;
      }
    }

    /* Hide image */
    .sticky-add-to-cart__image {
      display: none;
    }

    .sticky-add-to-cart__info {
      grid-area: info;
      padding-left: 0;
      align-self: end;
      min-width: 0;
    }

    .sticky-add-to-cart__info[data-has-image='false'] {
      padding-left: 0;
    }

    /* Hide variant line */
    .sticky-add-to-cart__variant {
      display: none;
    }

    .sticky-add-to-cart__title {
      font-size: var(--font-paragraph--size);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .sticky-add-to-cart__price {
      grid-area: price;
      font-size: var(--font-paragraph-small--size);
      align-self: start;
    }

    /* Button spans both rows on the right */
    .sticky-add-to-cart__button {
      grid-area: button;
      height: var(--height-buy-buttons);
      width: auto;
      padding-inline: var(--padding-lg);
      align-self: center;
    }

    /* Show Add to Cart label text on mobile */
    .sticky-add-to-cart__bar .add-to-cart-text__content {
      display: inline;
    }

    sticky-add-to-cart:not([data-variant-available='true']) .add-to-cart-text__content {
      display: initial;
    }

    sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__button {
      width: auto;
    }
  }

  /* Small mobile - hide text content and compare price */
  @media screen and (max-width: 389px) {
    .sticky-add-to-cart__bar {
      .compare-at-price {
        display: none;
      }
    }

    .sticky-add-to-cart__title {
      display: none;
    }

    /* For product with only default variant show title */
    .sticky-add-to-cart__info[data-singleton='true'] .sticky-add-to-cart__title {
      display: block;
    }

    /* For single variant show title and variant, truncate both. variant should be identifiable with truncation */
    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__title {
      display: block;
    }

    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__variant {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
  /* SKU + Barcode inline row */
  product-sku-component,
  product-barcode-component {
    display: inline-block !important;
    width: auto !important;
    vertical-align: middle;
  }

  product-sku-component + product-barcode-component,
  product-barcode-component + product-sku-component {
    margin-inline-start: 1.5rem;
  }

  /* Sale badge pill — loaded here so it renders even when the standalone
     sale-badge block is not on the page */
  .sale-badge__pill--inline {
    display: inline-flex;
    align-items: center;
    background: #eb1d23;
    color: #fff;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    vertical-align: middle;
    margin-inline-start: 0.4rem;
  }

  /* Product page price hierarchy */
  product-price .price-item--sale.price {
    font-size: 1.25em;
    font-weight: 700;
    color: var(--color-foreground);
  }

  product-price .price-item--regular.compare-at-price {
    font-size: 0.85em;
    font-weight: 400;
    opacity: 1;
    color: rgb(var(--color-foreground-rgb) / 0.45);
    text-decoration-line: line-through;
    text-decoration-thickness: 1.5px;
    text-decoration-color: rgb(var(--color-foreground-rgb) / 0.35);
  }

  /* ── Mobile PDP block ordering ── */
  @media screen and (max-width: 749px) {
    /* Turn product grid into a flex column so CSS order works across all children.
       padding-inline: 16px restores the page margin that was provided by the CSS subgrid columns.
       overflow-x: clip prevents any overflowing child (e.g. wide swatch rows) from causing horizontal scroll.
       !important needed: snippet stylesheet sets display:grid on this element. */
    [data-product-grid-content] {
      display: flex !important;
      flex-direction: column !important;
      padding-inline: 16px;
      padding-top: 15px;
      overflow-x: clip;
      gap: 12px;
    }

    /* Unwrap three container levels so every inner block becomes a direct flex child.
       _product-details renders itself via render 'group', so the chain is:
         .product-details > .group-block (outer) > .group-block-content (outer) > [inner blocks]
       All three must be display:contents so inner blocks participate in [data-product-grid-content]'s
       flex context and CSS order can interleave them with the gallery.
       The inner .group-block-content elements (e.g. vendor+stars row) are NOT matched by these
       selectors (they're more than one level down from .product-details), so they keep display:flex
       and their internal row layout stays intact.
       !important beats:
         _product-details.liquid → .product-details { display: flex }
         base.css / group.liquid → .layout-panel-flex { display: flex }  */
    .product-details {
      display: contents !important;
    }
    .product-details > .group-block {
      display: contents !important;
    }
    .product-details > .group-block > .group-block-content {
      display: contents !important;
    }

    /* The outer group-block's media-wrapper escapes display:contents as an empty flex item — hide it */
    .product-details > .group-block > .group-block__media-wrapper {
      display: none;
    }

    /* Hidden title injected by _product-details.liquid — keep it out of flow */
    .view-product-title {
      display: none !important;
    }

    /* Catch-all: push any unrecognised flex child (app blocks without --mobile-order) to end */
    [data-product-grid-content] > * {
      order: 99;
    }

    /* Gallery: full-bleed (negates the 16px container padding on each side).
       order:-1 puts the image FIRST on mobile (image-first PDP layout).
       Desktop is unaffected (this rule is inside the mobile media query). */
    [data-product-grid-content] > .product-information__media {
      margin-inline: -16px;
      width: calc(100% + 32px) !important;
      max-width: none !important;
      order: -1 !important;
    }

    /* Named block wrappers: --mobile-order is set as inline style on each element.
       .group-block here targets the INNER group blocks (group_38ENnf, group_icgrde etc.) —
       the OUTER .group-block has display:contents so its order property is ignored. */
    .group-block,
    product-sku-component,
    product-barcode-component,
    .buy-buttons-block,
    .accordion,
    .block-mobile-order {
      order: var(--mobile-order, 99);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "t:settings.enable_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
